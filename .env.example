PORT=3000
NODE_ENV=development

# Proxy hops in front of this process (Express "trust proxy"). Leave blank
# when the API is reached directly. Set to 1 behind one load balancer or
# CDN — otherwise every caller shares the proxy's IP and the per-IP OTP and
# login limiters become one global lock the first time they fire.
TRUST_PROXY=

# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adx?schema=public


DATABASE_URL=postgresql://USER:PASSWORD@HOST/adx?sslmode=require&schema=public

# The direct (unpooled) endpoint of the same database — on Neon, the host
# without "-pooler". The app keeps DATABASE_URL; `prisma migrate`, the nightly
# pg_dump and pg_restore use this one, because a pooler cannot carry a
# migration's DDL transaction or a dump's single session. Leave blank on a
# local Postgres and everything falls back to DATABASE_URL.
DIRECT_URL=

# Backups (decision 95: RPO 1 h / RTO 4 h — Neon PITR plus a nightly dump).
# BACKUP_KEY seals every dump with AES-256-GCM: 32 bytes, as 64 hex characters
# (`openssl rand -hex 32`) or base64. Keep it outside the database and outside
# R2 — a dump without the key is noise, and the key without a dump is nothing.
# `npm run backup` refuses to run without it. See docs/runbooks/backup-restore.md.
BACKUP_KEY=
# Lot K2: seals the admins' authenticator-app (TOTP) secrets at rest — 32 bytes
# as 64 hex characters (`openssl rand -hex 32`) or base64. Unset, a key is
# derived from JWT_ACCESS_SECRET for development; set it in production.
TOTP_ENCRYPTION_KEY=
# The scratch database the monthly restore drill restores into and runs the
# ledger verify against. Never the production database — the drill refuses a
# URL whose database name matches DIRECT_URL / DATABASE_URL. Blank skips the
# drill with a warning.
DRILL_DATABASE_URL=

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

QR_SECRET=replace-with-a-random-string
BASE_URL=
# E11-2: where a shared spot link points (the API serves the public spot page
# at /s/:displayId; set this when a web front sits in front of it). Blank falls
# back to BASE_URL.
PUBLIC_WEB_URL=
# The store listings the public spot page offers beside the app deep link.
# Blank leaves that button out.
APP_STORE_URL=
PLAY_STORE_URL=

# SMS
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Email — generic SMTP. Unset in dev: password-reset emails are logged to
# the console instead of sent. Uncomment ONE provider block below and fill
# in its credentials when you're ready to send real email.
#
# Gmail / Google Workspace
#   Requires 2FA enabled on the account, then create an "App Password" at
#   https://myaccount.google.com/apppasswords — use that as SMTP_PASSWORD,
#   not your normal login password.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASSWORD=<16-character app password>
#
# SendGrid
#   SMTP_USER is literally the string "apikey" — the real secret goes in
#   SMTP_PASSWORD as your SendGrid API key.
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=<SendGrid API key>
#
# Resend
#   SMTP_USER is literally the string "resend" — the real secret goes in
#   SMTP_PASSWORD as your Resend API key.
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=<Resend API key>
#
# AWS SES
#   Host is region-specific (example below is us-east-1 — swap in your
#   region). SMTP_USER/SMTP_PASSWORD are SES *SMTP* credentials generated
#   from the SES console (Account dashboard > SMTP settings > Create SMTP
#   credentials) — these are NOT your regular AWS access key/secret.
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=<SES SMTP username>
#   SMTP_PASSWORD=<SES SMTP password>
#
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ADX Admin <no-reply@adx.local>
# AE-B: the SMTP door's mode. SMTP (default) sends through SMTP_HOST above;
# ETHEREAL needs no credentials at all — the server creates a throwaway
# Ethereal test inbox once (kept in Redis for a day) and every message gets
# a preview URL in the log and in the comms delivery log. Ethereal NEVER
# delivers: it is a catch-all viewer for testing. The integrations screen's
# email section (`mode`) overrides this. Port note: 465 = implicit TLS,
# 587 = STARTTLS — the sender sets `secure` by the port.
EMAIL_MODE=

# Base URL of the admin UI — used to build password-reset links
FRONTEND_URL=http://localhost:5173

# Where a console invitation link points; the one-time token is appended as
# ?token=… , so this is the accept screen, not the app root.
INVITE_ACCEPT_URL=http://localhost:5173/accept-invite

# Admin second factor (Q25): how many times the EMAIL backup may answer
# instead of the phone in a rolling 30 days. Past it, only SMS is offered
# until a phone code is entered or an admin resets the counter. 0 disables
# the email channel entirely.
ADMIN_EMAIL_OTP_FALLBACK_LIMIT=3

# Local login OTP allowlist. These numbers can log in even before being seeded.
# Each entry is <mobile> (self-provisions an AGENT_PUBLISHER) or <mobile>:<ROLE>
# with ROLE one of AGENT_PUBLISHER, AGENT_ADVERTISER, PUBLISHER, ADVERTISER,
# PARTNER, ADMIN. Ignored entirely when NODE_ENV=production.
DEV_LOGIN_MOBILES=9876543210,9876543211,9876543212

# WARNING — dev-only admin door (owner's item 11). A <mobile>:ADMIN entry above
# mints an ADMIN account on its first login OTP ONLY when this is true AND
# NODE_ENV is not production; either missing and the entry is refused with a
# logged reason. Every mint is audited DEV_ADMIN_LOGIN_USED. The minted admin
# still has to pass the console's second factor (the dev code is printed in
# the terminal and returned in the response outside production). Never set
# this on a shared or internet-facing environment.
DEV_ADMIN_LOGIN=false

# Cloudflare R2 (S3-compatible) — falls back to local disk storage when unset
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Digio KYC
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_BASE_URL=https://ext-enterprise.digio.in

# Twilio — SMS/WhatsApp for the future agent apps (publisher/advertiser agents)
# and the future publisher/advertiser user apps. Get these from the Twilio
# Console (https://console.twilio.com).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps Platform — geocoding/maps for the future agent and
# publisher/advertiser apps. Create a key at
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=
# G7 (Q101/132/137): the maps seam. GOOGLE_MAPS_API_KEY above is the SERVER
# key (IP-restricted; geocoding, directions). The browser key is the one the
# phones and the console draw tiles with — restricted by bundle id / referrer
# — and is the only key GET /app/maps ever answers. Mapbox is the alternative
# provider, chosen at /settings/integrations { section: 'maps' }; its public
# token (pk.) is the browser-side one, the secret token (sk.) the server's.
GOOGLE_MAPS_BROWSER_KEY=
MAPBOX_PUBLIC_TOKEN=
MAPBOX_SECRET_TOKEN=

# G7 (Q109): the audience / footfall vendors. The provider switch (NONE |
# GEOIQ | AZIRA) is on the integrations row and defaults to NONE — with it
# off the analytics say no panel backs an audience figure rather than draw
# one. GeoIQ: the Data API key (docs.geoiq.io); the base URL defaults to the
# India serving host, https://dataserving-in.geoiq.io/production/v1.0 (the
# US host is dataserving-us.geoiq.io; the bare dataserving.geoiq.io does not
# resolve). The catalogue variable ids are per account and are mapped on the
# integrations row (audience.geoiqVariables), never here. Azira: the Pinnacle
# API key and client id, and the API base URL from the contract (there is no
# public default).
GEOIQ_API_KEY=
GEOIQ_BASE_URL=
AZIRA_API_KEY=
AZIRA_CLIENT_ID=
AZIRA_BASE_URL=

# QR-1: the QR engine. GenQR (our own QR platform, its own repository and
# deployment) draws the styled codes that go to print and hosts the dynamic
# code in front of every campaign hoarding. The provider switch (LOCAL |
# GENQR) is on the integrations row and defaults to LOCAL — with it off,
# every code is drawn locally in the house style exactly as before. The key
# is a GenQR Enterprise key with the scopes qrcodes:read, qrcodes:write,
# analytics:read and render. The short base is the ADX-branded origin a
# hoarding carries (e.g. https://go.adx.in), set as "Redirect base" on the
# GenQR account and proxied to GenQR's /r/; recorded here for the console.
GENQR_BASE_URL=
GENQR_API_KEY=
GENQR_SHORT_BASE_URL=

# Google Sign-In — the admin UI's "Continue with Google Workspace" button.
# Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add the admin UI's
# origin (e.g. http://localhost:5173) under "Authorised JavaScript origins".
# No client secret is needed: the browser gets an ID token and this backend
# verifies its signature against Google's public keys.
#
# Leave blank and POST /auth/google answers 503. That is deliberate — the other
# integrations here degrade to a no-op when unconfigured, but a login endpoint
# that skips its check would let anyone in.
GOOGLE_CLIENT_ID=

# Comma-separated Workspace domains allowed to sign in, matched against the ID
# token's `hd` claim (e.g. adx.co). Blank means any Google account may try;
# either way the account must already exist in ADX — Google sign-in never
# creates one.
GOOGLE_ALLOWED_DOMAINS=

# Razorpay — payments
# Get these from the Razorpay Dashboard (https://dashboard.razorpay.com)
# under Settings > API Keys / Webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# "false" once the live keys are in; kept for the console's record — Razorpay
# uses one host for both modes and the key prefix (rzp_test_ / rzp_live_) decides.
RAZORPAY_TEST_MODE=true

# Cashfree Payments (modules/payments, Lot C) — the PG credentials, distinct
# from CASHFREE_PAYOUT_KEY below. Test mode targets sandbox.cashfree.com;
# leave it on until the live app id and secret are issued.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional: a separate webhook signing secret; blank means the secret key signs.
CASHFREE_WEBHOOK_SECRET=
CASHFREE_TEST_MODE=true

# CCAvenue (modules/payments, Lot C) — merchant id, access code and the
# working key the request and response are AES-encrypted with. Test mode
# targets test.ccavenue.com / apitest.ccavenue.com.
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_TEST_MODE=true

# Payout rails — how approved withdrawals leave ADX (modules/payouts/rail.ts).
# Leave both blank and finance transfers by hand and records the UTR; set one
# and that rail carries the payment, with manual NEFT still the fallback.
RAZORPAY_X_KEY=
CASHFREE_PAYOUT_KEY=

# Stripe — payments
# Get these from the Stripe Dashboard (https://dashboard.stripe.com/apikeys)
# and Developers > Webhooks for the webhook signing secret.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Cloud Messaging — push to the two apps (G6, Q103/133). The
# service-account JSON from the Firebase console (Project settings > Service
# accounts > Generate new private key), pasted raw or base64-encoded. The
# backend mints its own OAuth2 token from it; no firebase-admin SDK. Leave
# blank and every push is skipped with FCM_NOT_CONFIGURED.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Resend — transactional email, alternative to generic SMTP
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Redis — shared rate-limit counters, integration-config cache, and the
# publisher-timer job lock, so all three stay correct across instances.
#
# Enable exactly ONE REDIS_URL below. Restart the backend after switching.
# Local Docker Redis (docker-compose.yml):
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:<PASSWORD>@<your-db>.upstash.io:6379
#
# Upstash (managed, no Docker needed): grab the "Redis" connection string
# (not the REST URL/token) from the Upstash console for your database —
# Copy Connect > ioredis > Redis URL. Use the database password, not a REST token.
# Comment the Docker line above before enabling this line:
# REDIS_URL=rediss://default:<PASSWORD>@<your-db>.upstash.io:6379

# Cloudflare Turnstile — leave blank locally; captcha checks no-op until set.
TURNSTILE_SECRET_KEY=

# Outside production, OTP is delivered via the terminal and the send-otp
# response. Set to "true" only to exercise the real MSG91 path in dev.
SMS_LIVE_IN_DEV=false

# Error sink — where a 5xx goes after it is logged. One of: none | webhook |
# sentry. Leave "none" locally. "webhook" POSTs a compact JSON summary
# (request id, path, status, code, message, stack head) to ERROR_WEBHOOK_URL —
# a Slack/Teams relay or an incident tool. "sentry" sends a minimal event
# envelope straight to the DSN's envelope endpoint, no SDK involved. Either
# way delivery is fire-and-forget with a 3s ceiling and never fails a request.
ERROR_SINK=none
ERROR_WEBHOOK_URL=
SENTRY_DSN=

# Lot G (Q130): the region this API process runs in, as the public status page
# (/status) and GET /settings/system-health/regions name it. One region until
# there is a second deployment; the default is where ADX is hosted.
APP_REGION=ap-southeast-1 (Singapore)
