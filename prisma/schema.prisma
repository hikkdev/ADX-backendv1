generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  // Lets a query opt into a single LATERAL JOIN instead of one round trip per
  // relation. With the database in another region every extra round trip costs
  // ~85ms, so the login lookup alone was paying 5x that. Opt-in per query via
  // `relationLoadStrategy: 'join'` — the default stays unchanged everywhere else.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  // url comes from prisma.config.ts. Requires the v7 CLI — the v6 CLI ignores
  // that config and fails to resolve the datasource.
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  AGENT_PUBLISHER
  AGENT_ADVERTISER
  PUBLISHER
  ADVERTISER
  PARTNER
  ADMIN
}

enum OtpPurpose {
  LOGIN
  REGISTER
  PUBLISHER_VERIFY
  /// DR 07 wave 5: proving the new number before the identity moves to it.
  CHANGE_MOBILE
  /// Lot A (Q25): the admin's second factor — the phone by default, email as
  /// the backup whose code is ten letters and digits rather than six digits.
  TWO_FACTOR
  /// Lot K: proving an extra email or phone number on an account.
  CONTACT_VERIFY
  TWO_FACTOR_EMAIL
  /// Lot F (Q18): the old number consents before the new one is proved.
  CHANGE_MOBILE_OLD
}

// ─── User (base identity, all roles) ─────────────────────────────────────────

model User {
  id                      String    @id @default(cuid())
  mobile                  String    @unique
  name                    String?
  email                   String?   @unique
  passwordHash            String?
  avatarUrl               String?
  language                String    @default("en")
  isActive                Boolean   @default(true)
  // Null until the account's first successful sign-in. Set by the login
  // handlers only — token refresh renews a session rather than starting one,
  // so it deliberately leaves this alone.
  lastLoginAt             DateTime?
  /// When this number first proved itself with an OTP. Register-or-login
  /// creates the User row at *send* time (Otp.userId is NOT NULL, so the code
  /// needs a row to hang off), which means a row with this still null is a
  /// number that asked for a code and never entered it — inert, since nothing
  /// issues a token without a verified code. Stamped once, never cleared.
  mobileVerifiedAt        DateTime?
  /// Lot A (Q25): stamped for every ADMIN at creation or first sign-in; while
  /// set, a sign-in is not complete until the second factor passes. Null for
  /// parties, whose OTP already is the factor.
  twoFactorRequiredAt     DateTime?
  /// Lot A (Q25): how often the email backup answered instead of the phone in
  /// the rolling window; past the limit the phone must answer once more before
  /// email is offered again — the hijack guard the owner asked for.
  emailOtpFallbackCount   Int       @default(0)
  emailOtpFallbackResetAt DateTime?
  /// Lot K2: the authenticator app. The TOTP secret, encrypted at rest with
  /// TOTP_ENCRYPTION_KEY (AES-256-GCM, iv:tag:ciphertext), and the moment the
  /// person confirmed the first code — null until then, so a half-finished
  /// enrolment never counts as a factor.
  totpSecretEnc           String?
  totpEnrolledAt          DateTime?
  /// Lot A (Q21/Q60): a closed account keeps every financial row. Sign-in
  /// stops, the profiles are retired, the wallet is frozen; erasure of the
  /// person's data is a separate, DPO-signed step.
  closedAt                DateTime?
  closeReason             String?
  closedById              String?
  /// Lot E (Q64): the unsubscribe link on an announcement email.
  emailUnsubscribedAt     DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  roles                   UserRole[]
  /// Lot K: the extra emails and phone numbers beside the sign-in pair.
  contacts                UserContact[]
  recoveryCodes           RecoveryCode[]
  otps                    Otp[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  activityLogs            ActivityLog[]
  qrScans                 QrScan[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  supportTickets          SupportTicket[]
  ticketMessages          TicketMessage[]
  payoutMethods           PayoutMethod[]
  uploadedFiles           UploadedFile[]

  // Agent-specific profile (null if not an agent)
  agentProfile      AgentProfile?
  // Publisher-specific profile (null if not a publisher)
  publisherProfile  Publisher?
  // Advertiser-specific profile (null if not an advertiser)
  advertiserProfile Advertiser?
  placedOrders      Order[]       @relation("AdvertiserOrders")

  // Ported from legacy app
  advertiserKyc         AdvertiserKyc?
  employeeProfile       Employee?
  userKyc               UserKyc?
  onboardingSubmissions OnboardingSubmission[] @relation("OnboardingSubject")

  // Supply lifecycle
  agreementAcceptances      AgreementAcceptance[]
  createdListingAttempts    ListingAttempt[]
  reviewedListingDocuments  ListingDocument[]
  submittedVerifications    ListingVerification[]      @relation("VerificationSubmittedBy")
  reviewedVerifications     ListingVerification[]      @relation("VerificationReviewedBy")
  decidedListingClaims      ListingClaim[]
  assignedComplianceCases   ComplianceCase[]
  complianceContactAttempts ComplianceContactAttempt[]
  refundsRaised             WalletRefundRequest[]      @relation("RefundRaisedBy")
  refundsDecided            WalletRefundRequest[]      @relation("RefundDecidedBy")
  campaignsCreated          Campaign[]                 @relation("CampaignCreatedBy")
  packageSalesCreated       PackageSale[]              @relation("PackageSaleCreatedBy")
  disputesRaised            Dispute[]                  @relation("DisputesRaised")
  disputeMessages           DisputeMessage[]           @relation("DisputeMessages")
  disputeEvidence           DisputeEvidence[]          @relation("DisputeEvidence")
  safetyAlerts              SafetyAlert[]              @relation("SafetyAlertsRaised")
  preferences               UserPreference[]
  roleConfig                UserRoleConfig?
  adminInvitesSent          AdminInvite[]
  erasureRequests           ErasureRequest[]
  deviceTokens              DeviceToken[]
  dataExports               DataExportRequest[]
}

// ─── UserRole (a user can hold multiple roles) ────────────────────────────────

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

// ─── AgentProfile ─────────────────────────────────────────────────────────────

model AgentProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  /// Human-readable identifier, e.g. AGT-1009-2601. Issued once, never reissued.
  displayId        String?            @unique
  city             String?
  /// Lot X: the catalogue city the free-text `city` resolved to (null when it did not); every read that groups by city groups by this.
  cityId           String?
  state            String?
  referralCode     String             @unique @default(cuid())
  /// The ladder rung, derived from onboardings and written back on read
  /// (DR 05) — or pinned by ops, with a reason, until unpinned.
  tier             AgentTier          @default(BRONZE)
  tierLevel        TierLevel          @default(I)
  tierPinnedAt     DateTime?
  /// D5: whether the agent is offered work. Signing in at all is `User.isActive`;
  /// this is the field ops sets when someone is away or under review.
  status           AgentProfileStatus @default(ACTIVE)
  /// Lot A (Q52): which sections are suspended — BLOCK_NEW (no new offers, visits
  /// or milestones), STOP_OPEN_WORK (pending offers and scheduled work released),
  /// FREEZE_WALLET, BLOCK_SIGNIN. `status` stays SUSPENDED while BLOCK_NEW is
  /// present so every existing reader keeps working.
  suspensionScopes SuspensionScope[]  @default([])
  suspendedAt      DateTime?
  suspensionReason String?
  suspendedById    String?
  /// D5 — DR 10's territory, DR 07's edit-profile "Business / Org", and the
  /// work preferences DR 07 draws: service area, availability, orders.
  territory        String?
  homeZone         String?
  radiusKm         Int?
  /// MON..SUN, in week order.
  workingDays      String[]           @default([])
  /// "HH:MM", 24-hour.
  hoursFrom        String?
  hoursTo          String?
  autoAcceptInZone Boolean            @default(false)
  orderTypes       ListingCategory[]  @default([])
  maxActiveOrders  Int?
  businessName     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders           Order[]
  publishers       Publisher[]
  advertisers      Advertiser[]
  wallet           Wallet?
  listings         Listing[]
  transactions     Transaction[]
  agentMilestones  AgentMilestone[]
  orderMilestones  OrderMilestone[]
  agentAssignments OrderAgentAssignment[]
  accessGrants     DelegatedAccessGrant[]
  supportTickets   SupportTicket[]
  campaigns        Campaign[]
  packageSales     PackageSale[]
  incentives       AgentIncentive[]
  /// D4: the agent's own identity record, recorded at ADX's desk.
  kyc              AgentKyc?
  trainingProgress AgentTrainingProgress[]
  trainingAttempts TrainingAttempt[]
  certification    AgentCertification?
  rating           AgentRating?
  leads            Lead[]
  fieldVisits      FieldVisit[]
  tierEvents       AgentTierEvent[]
  accountActivity  AccountActivity[]
  cityRef          City?                   @relation("AgentCity", fields: [cityId], references: [id], onDelete: SetNull)

  @@index([cityId])
}

enum AgentTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum TierLevel {
  I
  II
  III
}

/// A rung changing hands — a promotion the GOLD Achieved screen fires on
/// once (`acknowledgedAt` is the once), or a fall, or an ops pin with its
/// reason. The tier's history, which used to be silent.
model AgentTierEvent {
  id             String    @id @default(cuid())
  agentId        String
  fromTier       AgentTier
  fromLevel      TierLevel
  toTier         AgentTier
  toLevel        TierLevel
  reason         String
  byUserId       String?
  at             DateTime  @default(now())
  acknowledgedAt DateTime?

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, at])
}

/// A CRM action against an account that is already onboarded — the "Check in"
/// and "Follow up" on the agent's advertiser book (decision 14). Not a lead
/// activity: a lead converts and stops being one; an account keeps its log.
/// Against exactly one party; the table's own check says so.
enum AccountActivityKind {
  CHECK_IN
  FOLLOW_UP
  CALLED
  MESSAGED
  NOTE
}

model AccountActivity {
  id              String              @id @default(cuid())
  advertiserId    String?
  publisherId     String?
  agentId         String
  kind            AccountActivityKind
  note            String?
  at              DateTime            @default(now())
  createdByUserId String

  advertiser Advertiser?  @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  publisher  Publisher?   @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  agent      AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([advertiserId, at])
  @@index([publisherId, at])
  @@index([agentId, at])
}

/// D5 — whether an agent is offered work. Distinct from `User.isActive`, which
/// is whether they can sign in at all: an agent on leave still reads their
/// dashboard, and still gets no offers.
enum AgentProfileStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
}

/// D4 — an agent's identity documents. Agents never self-serve: the admin who
/// met them records what they were shown (`recordedById`), and the review is
/// the same decision every other KYC row gets. One per agent.
model AgentKyc {
  id               String    @id @default(cuid())
  agentId          String    @unique
  govIdType        String? // "AADHAAR" | "PASSPORT" | "DRIVING_LICENCE"
  govIdFrontUrl    String?
  govIdBackUrl     String?
  panNumber        String?
  panFrontUrl      String?
  panSignatureUrl  String?
  addressProofType String? // "UTILITY_BILL" | "RENT_AGREEMENT" | "BANK_STATEMENT"
  addressProofUrl  String?
  selfieUrl        String?
  /// A cancelled cheque or passbook page — needed before anything is paid out.
  bankProofUrl     String?
  status           KycStatus @default(PENDING)
  rejectionReason  String?
  /// User.id of the admin who recorded the documents on the agent's behalf.
  recordedById     String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  // Lot N3: the Digio path and the desk's request, like the three parties
  method           String    @default("MANUAL")
  digioRequestId   String?
  digioReferenceId String?
  digioStatus      String?
  digioVerifiedAt  DateTime?
  digioPayload     Json?
  requestedAt      DateTime?
  requestedById    String?
  requestedChannel String?
  recordedVia      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@index([digioRequestId])
}

// ─── OTP ──────────────────────────────────────────────────────────────────────

/// Lot K (owner, 14 Sep 2026): an extra email or phone number on an account.
/// `User.mobile` and `User.email` stay the sign-in pair; a contact here is
/// reachable, verifiable, and can be promoted into that pair (the old primary
/// drops down to a contact) — by the person on the phone, or by an admin
/// with a reason. Unique across the platform, like the pair it can join.
model UserContact {
  id         String      @id @default(cuid())
  userId     String
  kind       ContactKind
  /// Normalised: a lower-cased email, an E.164 number.
  value      String
  label      String?
  verifiedAt DateTime?
  /// Who put it there — the person, or the admin whose audit row says why.
  addedById  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, value])
  @@index([userId])
}

enum ContactKind {
  EMAIL
  PHONE
}

/// Lot K2: one of the ten recovery codes issued when an authenticator is
/// enrolled (or regenerated). Stored hashed; shown once; spent on use.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Otp {
  id         String     @id @default(cuid())
  userId     String
  // Exactly one of mobile/email is set, depending on delivery channel (SMS vs Resend).
  mobile     String?
  email      String?
  purpose    OtpPurpose @default(LOGIN)
  // Stored as bcrypt hash
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mobile, purpose])
  @@index([email, purpose])
}

// ─── Order Lifecycle ──────────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PENDING_PUBLISHER
  PUBLISHER_REJECTED
  PENDING_PRINT
  SELF_INSTALL
  PENDING_AGENT
  AGENT_REJECTED
  SLOT_PROPOSED
  SLOT_CONFIRMED
  IN_PROGRESS
  PENDING_OTP
  PENDING_APPROVAL
  COMPLETED
  CANCELLED
}

enum AssetType {
  BILLBOARD
  TRANSIT
  INDOOR
  DIGITAL
}

model Site {
  id          String    @id @default(cuid())
  name        String
  address     String
  latitude    Float
  longitude   Float
  assetType   AssetType
  publisherId String?
  qrCodeId    String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  publisher Publisher? @relation(fields: [publisherId], references: [id])
}

model Order {
  id                            String      @id @default(cuid())
  advertiserId                  String
  listingId                     String
  agentId                       String?
  /// Lot B (Q3): the per-order agent fee ops typed, used only when the
  /// installation-commission mode is PER_ORDER; the flat rate stands otherwise.
  agentFeeAmount                Decimal?    @db.Decimal(14, 2)
  status                        OrderStatus @default(DRAFT)
  campaignName                  String?
  designUrl                     String?
  budget                        Float?
  startDate                     DateTime?
  endDate                       DateTime?
  notes                         String?
  publisherAcceptedAt           DateTime?
  publisherRejectedAt           DateTime?
  /// Lot D (Q6): set when the listing's instant booking accepted the order with
  /// no publisher tap; `publisherAcceptedAt` is set to the same instant.
  autoAcceptedAt                DateTime?
  /// Lot D (Q51/Q90): who cancelled and why, instead of overwriting the notes.
  cancelledAt                   DateTime?
  cancelledByUserId             String?
  cancellationReason            String?
  publisherTimerExpiry          DateTime?
  /// The agent's own acceptance window. The publisher's was the only one that
  /// existed, so an offer the agent never answered sat there for ever while
  /// DR 01 and DR 03 both draw a countdown on it.
  agentTimerExpiry              DateTime?
  /// Who puts the advertisement up, chosen per booking by the publisher.
  ///
  /// This was a per-listing boolean (`Listing.agentCanInstall`) that nothing
  /// ever wrote, so the whole self-install branch was unreachable. The frame
  /// asks the question per booking — the publisher may install one spot
  /// themselves and want ADX for the next — so it belongs here. Null means the
  /// publisher has not been asked yet.
  installBy                     InstallBy?
  publisherRejectionReason      String?
  meetingPlace                  String?
  slotProposedAt                DateTime?
  slotTime                      DateTime?
  slotConfirmedAt               DateTime?
  slotCounterCount              Int         @default(0)
  agentRejectionCount           Int         @default(0)
  agentEscalated                Boolean     @default(false)
  completionOtp                 String?
  completionOtpPlain            String?
  completionOtpExpiry           DateTime?
  printReadyAt                  DateTime?
  selfInstallCollectPhotoUrl    String?
  selfInstallConditionPhotoUrls String[]
  selfInstallInstallPhotoUrl    String?
  selfInstallCheckedInAt        DateTime?
  adminApprovedAt               DateTime?
  // Ported from legacy app: optional link to a reusable Advertisement creative
  agentLatitude                 Float?
  agentLongitude                Float?
  agentLocationUpdatedAt        DateTime?
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt

  advertiser       User                   @relation("AdvertiserOrders", fields: [advertiserId], references: [id])
  listing          Listing                @relation(fields: [listingId], references: [id])
  agent            AgentProfile?          @relation(fields: [agentId], references: [id])
  agentAssignments OrderAgentAssignment[]
  checkIn          CheckIn?
  verification     SiteVerification?
  milestones       OrderMilestone[]
  campaignSpot     CampaignSpot?

  // The four ways orders are actually listed: by advertiser, by agent, by
  // listing, and the admin board filtered on status.
  disputes     Dispute[]
  safetyAlerts SafetyAlert[]
  photos       OrderPhoto[]

  @@index([advertiserId, createdAt])
  @@index([agentId, status])
  @@index([listingId])
  @@index([status, createdAt])
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  /// Lot D (Q51): ops moved the order to another agent; this one is closed.
  REASSIGNED
}

model OrderAgentAssignment {
  id              String           @id @default(cuid())
  orderId         String
  agentId         String
  status          AssignmentStatus @default(PENDING)
  rejectionReason String?
  assignedAt      DateTime         @default(now())
  respondedAt     DateTime?

  /// Lot B (Q3): what this offer showed the agent, copied at offer time so a
  /// later change of mode or rate never changes what was promised.
  quotedFee Decimal? @db.Decimal(14, 2)

  order Order        @relation(fields: [orderId], references: [id])
  agent AgentProfile @relation(fields: [agentId], references: [id])

  @@index([orderId])
  @@index([agentId])
}

model CheckIn {
  id          String   @id @default(cuid())
  orderId     String   @unique
  latitude    Float
  longitude   Float
  distanceM   Float // distance from site in metres
  checkedInAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model SiteVerification {
  id              String    @id @default(cuid())
  orderId         String    @unique
  wideAngleUrl    String?
  closeUpUrl      String?
  landmarkUrl     String?
  qrScanned       Boolean   @default(false)
  checklistPassed Boolean   @default(false)
  notes           String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

// ─── QR Code ──────────────────────────────────────────────────────────────────

enum QrType {
  SITE // Physical ad space — triggers onboarding or order check-in
  AD // Running ad placement — periodic health check
  AGENT // Agent referral QR
  ORDER // Specific order QR
  PUBLISHER // Publisher identity QR — generated by publisher app, scanned by agent to start onboarding
  ACCESS_GRANT // Delegated access QR — generated by publisher, scanned by the agent ADX assigned
  ADVERTISER // Advertiser identity QR — the door-to-door code, demand side
}

/// Why a DelegatedAccessGrant exists.
enum AccessGrantPurpose {
  /// A publisher lending an assigned agent a hand on a ticket.
  SUPPORT
  /// The authority an approved door-to-door scan opens for the onboarding.
  ONBOARDING
}

/// What a publisher is handing over when they show an access QR.
enum AccessGrantScope {
  /// The publisher's own record and KYC — the same surface the onboarding QR
  /// opens, reopened after onboarding is finished.
  PROFILE
  /// Their listings: prices, classification, availability.
  LISTINGS
}

enum AccessGrantStatus {
  /// Issued and on screen. Nobody has scanned it.
  PENDING
  /// Scanned by the assigned agent. The window is running.
  ACTIVE
  /// The window closed on its own.
  EXPIRED
  /// Closed early, by the publisher or by ops.
  REVOKED
}

/// A publisher lending an agent limited access to their own account.
///
/// The rule everywhere else is that an agent may act for the publishers they
/// onboarded and nobody else. This is the sanctioned exception, and it is the
/// publisher's to grant: they raise a support ticket, ADX assigns an agent, and
/// the publisher generates a QR from their own app. The agent scans it and the
/// window starts.
///
/// Every field here exists because the grant has to be answerable afterwards.
/// `reason` is what the publisher said they wanted changed, in their own words,
/// captured at generation time and shown to the agent on the scan — a grant
/// nobody can describe is a grant nobody can audit. `assignedAgentId` is why a
/// leaked QR image is not an open door: only the agent ADX put on the ticket can
/// claim it. `expiresAt` is set when it is *claimed*, not when it is issued, so
/// a publisher who generates one and puts their phone down has not started a
/// clock they cannot see.
model DelegatedAccessGrant {
  id              String             @id @default(cuid())
  /// Exactly one of the two: whose account the grant opens. The demand side
  /// gets the same door-to-door code, so the same authority.
  publisherId     String?
  advertiserId    String?
  /// What the publisher asked for help with. Their words, not a category.
  reason          String
  scope           AccessGrantScope
  /// Specific listings, when the publisher narrowed it. Empty means every
  /// listing they own — which is what the scope alone would have meant, so the
  /// distinction is deliberate rather than a default.
  listingIds      String[]           @default([])
  /// The agent ADX assigned on the ticket, and the only one who can claim this.
  assignedAgentId String
  /// The ticket that authorised it, when there was one.
  supportTicketId String?
  qrId            String?            @unique
  status          AccessGrantStatus  @default(PENDING)
  /// Why it exists. SUPPORT is the ticketed loan above; ONBOARDING is the
  /// authority a door-to-door scan opens once its owner approves — separate
  /// from Publisher.agentId, which only records who brought them in.
  purpose         AccessGrantPurpose @default(SUPPORT)
  /// How long the window runs once claimed.
  durationMinutes Int
  claimedAt       DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  publisher     Publisher?     @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  advertiser    Advertiser?    @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  assignedAgent AgentProfile   @relation(fields: [assignedAgentId], references: [id])
  supportTicket SupportTicket? @relation(fields: [supportTicketId], references: [id])

  // The read on every guarded write: does this agent hold a live grant here.
  @@index([assignedAgentId, status, expiresAt])
  @@index([publisherId, status])
  @@index([advertiserId, status])
}

model QrCode {
  id           String    @id @default(cuid())
  type         QrType
  // The signed token embedded in the QR image
  token        String    @unique
  // Role(s) that are allowed to act on this QR (empty = any authenticated user can view)
  allowedRoles Role[]
  // Polymorphic reference — points to siteId, adPlacementId, agentProfileId, or orderId
  refId        String
  metadata     Json?
  isActive     Boolean   @default(true)
  /// When the code dies on its own. Null for codes that do not expire. An
  /// onboarding code lives ninety seconds; "show my code again" reissues.
  expiresAt    DateTime?
  /// Where the issuer was when the code was made — the user's fix, so the
  /// agent's fix at scan can be measured against it. Recorded, not enforced.
  latitude     Float?
  longitude    Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  scans QrScan[]
}

model QrScan {
  id          String    @id @default(cuid())
  qrId        String
  scannedById String
  // GPS at time of scan
  latitude    Float?
  longitude   Float?
  // Role the user was acting as when they scanned
  role        Role?
  // What action was taken as a result
  action      String?
  /// Every attempt is a row, refusals included: GRANTED, PENDING_APPROVAL,
  /// EXPIRED, ALREADY_USED, NOT_AN_AGENT, USER_DECLINED. Rows from before
  /// this column were only ever written for a successful claim.
  outcome     String    @default("GRANTED")
  /// Metres between the issuer's fix at generation and the scanner's fix now.
  distanceM   Float?
  /// When the person whose code it was approved or declined the scan.
  decidedAt   DateTime?
  /// The authority the approval opened — a DelegatedAccessGrant id.
  grantId     String?
  createdAt   DateTime  @default(now())

  qr        QrCode @relation(fields: [qrId], references: [id])
  scannedBy User   @relation(fields: [scannedById], references: [id])

  @@index([qrId])
  @@index([scannedById])
}

// ─── Publisher & KYC ─────────────────────────────────────────────────────────

enum PublisherType {
  INDIVIDUAL
  BUSINESS
  NGO
  POLITICAL
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  /// Lot D (Q42/Q119): ops flagged documents; the party re-uploads only those.
  NEEDS_INFO
}

enum KycDocumentDecision {
  APPROVED
  FLAGGED
}

enum KycPartyType {
  PUBLISHER
  ADVERTISER
  PRINT_PARTNER
}

/// Lot D (Q42): one decision per document on a KYC record, so a re-upload
/// request names exactly the flagged ones.
model KycDocumentReview {
  id           String              @id @default(cuid())
  partyType    KycPartyType
  kycId        String
  field        String
  decision     KycDocumentDecision
  note         String?
  reviewedById String
  reviewedAt   DateTime            @default(now())

  @@unique([partyType, kycId, field])
  @@index([kycId])
}

enum OnboardingStatus {
  PENDING_ONBOARDING // Registered in user app, QR generated, waiting for agent
  IN_ONBOARDING // Agent scanned QR, onboarding in progress
  ONBOARDING_COMPLETE // Agent completed all steps, publisher dashboard unlocked
  ONBOARDING_CANCELLED // Agent cancelled OR 48hr timeout after scan
}

enum OnboardingSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum OrderMilestoneType {
  SURVEY
  CREATIVE_COLLECTION
  INSTALLATION
  VERIFICATION
  HEALTH_CHECK
  CUSTOM
}

enum OrderMilestoneStatus {
  PENDING
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model Publisher {
  id                 String            @id @default(cuid())
  userId             String?           @unique // user app login (User.id with role PUBLISHER)
  agentId            String? // AgentProfile.id — null until agent scans QR
  name               String
  mobile             String            @unique
  email              String?
  type               PublisherType     @default(INDIVIDUAL)
  /// DR 08 Steps 2–4, as the publisher types them. GSTIN for a business or
  /// organisation; the contact person is who ADX reaches about the account
  /// when the account is not a person.
  gstin              String?
  contactName        String?
  contactMobile      String?
  contactEmail       String?
  /// Where the publisher is, as given at sign-up. This is the meeting point an
  /// agent is sent to when the publisher accepts a booking, so it is an address
  /// somebody has to be able to find rather than a billing line.
  address            String?
  city               String?
  /// Lot X: the catalogue city the free-text `city` resolved to (null when it did not); every read that groups by city groups by this.
  cityId             String?
  state              String?
  /// Human-readable identifier, e.g. PUB-1909-2601. Issued once, never reissued.
  displayId          String?           @unique
  kycStatus          KycStatus         @default(PENDING)
  onboardingStatus   OnboardingStatus  @default(PENDING_ONBOARDING)
  /// Lot A (Q40/Q48): modular suspension — BLOCK_NEW, STOP_OPEN_WORK, STOP_ACCRUAL,
  /// FREEZE_WALLET, BLOCK_SIGNIN, each applied and reversed on its own with a
  /// reason; the history is PartySuspensionEvent.
  suspensionScopes   SuspensionScope[] @default([])
  suspendedAt        DateTime?
  suspensionReason   String?
  suspendedById      String?
  claimedAt          DateTime? // when agent scanned the QR
  /// Commercial designation, distinct from `type` (which is legal entity form).
  /// An agency controlling many spots is a Partner Publisher and may also be
  /// an NGO, so the two questions cannot share a column.
  isPartnerPublisher Boolean           @default(false)
  /// Which withdrawal ladder this publisher is on. Set by ops rather than
  /// derived: "smaller agency" and "larger agency" are commercial judgements
  /// about who ADX is dealing with, not a count of listings.
  sizeBand           PartySizeBand     @default(INDIVIDUAL)
  /// KYC verified and the platform agreement accepted.
  activatedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user                 User?                         @relation(fields: [userId], references: [id])
  agent                AgentProfile?                 @relation(fields: [agentId], references: [id])
  kyc                  PublisherKyc?
  listings             Listing[]
  accessGrants         DelegatedAccessGrant[]
  sites                Site[]
  agreementAcceptances AgreementAcceptance[]
  wallet               Wallet?
  listingAttempts      ListingAttempt[]
  listingClaims        ListingClaim[]
  complianceCases      ComplianceCase[]
  earningsHolds        EarningsHold[]
  /// Rate-card rows this publisher supplied. Provisional comparables only.
  marketDataPoints     MarketDataPoint[]
  subscriptions        PublisherSubscription[]
  subscriptionOrders   PublisherSubscriptionOrder[]
  commissionOverrides  PublisherCommissionOverride[]
  aiGenerations        AiGeneration[]
  earningAccruals      EarningAccrual[]
  activity             AccountActivity[]

  cityRef City? @relation("PublisherCity", fields: [cityId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([mobile])
  @@index([cityId])
}

model PublisherKyc {
  id                        String               @id @default(cuid())
  publisherId               String               @unique
  /// Lot E: the onboarding manifest version the party started on, so a later
  /// edit of the flow never changes the ladder under them.
  manifestVersion           Int?
  // Manual upload path
  aadhaarFrontUrl           String?
  aadhaarBackUrl            String?
  panFrontUrl               String?
  panBackUrl                String?
  gstUrl                    String?
  addressProofUrl           String?
  bankStatement             String?
  /// DR 08 self-service capture (Steps 6–10). The frames let the publisher
  /// choose which government ID they hold, print the PAN as a string, take a
  /// signature and a live selfie — none of which the columns above could hold.
  govIdType                 String? // "AADHAAR" | "PASSPORT" | "DRIVING_LICENCE"
  govIdFrontUrl             String?
  govIdBackUrl              String?
  panNumber                 String?
  panSignatureUrl           String?
  addressProofType          String? // "UTILITY_BILL" | "RENT_AGREEMENT" | "BANK_STATEMENT"
  selfieUrl                 String?
  // Business / NGO documents ported from legacy AdSpaceKyc
  businessRegCertUrl        String?
  directorIdUrl             String?
  businessAddressProofUrl   String?
  adAuthLetterUrl           String?
  ngoRegCertUrl             String?
  ngoAddressProofUrl        String?
  ngoTaxExemptionCertUrl    String?
  ngoOperationalOverviewUrl String?
  // Digio path
  digioRequestId            String? // Digio's kycId returned on initiate
  digioReferenceId          String? // our referenceId sent to Digio
  digioStatus               String? // raw status from Digio webhook (APPROVED/REJECTED/PENDING)
  digioVerifiedAt           DateTime?
  digioPayload              Json? // full webhook payload stored for audit
  // Common
  method                    String               @default("MANUAL") // "MANUAL" | "DIGIO"
  status                    KycStatus            @default(PENDING)
  rejectionReason           String?
  submittedAt               DateTime?
  reviewedAt                DateTime?
  /// Lot D (Q42/Q61): who decided and what they said; who is working the case
  /// (a filter, not ownership); when the images were purged after verification.
  reviewedById              String?
  reviewNote                String?
  assignedToId              String?
  assignedAt                DateTime?
  /// Lot G (Q127/142): escalated by age past N×SLA, a fraud link or a reviewer's
  /// flag — to the Compliance role; cleared when the case is decided.
  escalatedAt               DateTime?
  escalationSource          KycEscalationSource?
  escalationReason          String?
  escalatedToUserId         String?
  escalatedById             String?
  imagesPurgedAt            DateTime?
  /// Lot N: the desk asked for this KYC (a notice, and for DIGIO the link) —
  /// who, when, over which path; and who recorded the documents when it was
  /// not the party themselves (an agent, or an admin at the desk).
  requestedAt               DateTime?
  requestedById             String?
  requestedChannel          String?
  recordedById              String?
  recordedVia               String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
}

// ─── Listings ─────────────────────────────────────────────────────────────────

/// Ordered by the supply funnel. The middle states exist so ops can tell
/// "waiting on the publisher" from "waiting on us" — see
/// docs/publisher-supply-lifecycle.md.
enum ListingStatus {
  /// Seeded from scraped data, no owner yet.
  UNCLAIMED
  DRAFT
  /// Listed, but the attempt's listing agreement is not yet accepted.
  AWAITING_AGREEMENT
  /// Agreement accepted, per-listing documents still outstanding.
  AWAITING_DOCUMENTS
  /// Documents in, desk verification due.
  PENDING_REVIEW
  /// Desk cleared, agent site visit due.
  AWAITING_SITE_VERIFICATION
  ACTIVE
  /// Enforcement: verification lapsed past the compliance window.
  SUSPENDED
  REJECTED
  INACTIVE
}

enum ListingCategory {
  INDOOR
  OUTDOOR
  TRANSIT
  MEDIA
}

model Listing {
  id                     String              @id @default(cuid())
  /// Null while a scraped listing is unclaimed.
  publisherId            String?
  /// Null for listings ADX seeds or imports without an agent involved.
  agentId                String?
  /// The batch this listing was created in; its agreement covers this listing.
  attemptId              String?
  title                  String
  category               ListingCategory
  subType                String?
  description            String?
  address                String
  city                   String?
  /// Lot X: the catalogue city the free-text `city` resolved to (null when it did not); every read that groups by city groups by this.
  cityId                 String?
  latitude               Float?
  longitude              Float?
  size                   String?
  /// Canonical price unit for the whole platform. `monthlyPrice` below is
  /// derived from this and deprecated — it is a Float, which is the wrong type
  /// for money, and it stays only until listings, orders, the marketplace and
  /// both mobile apps move across together.
  ratePerDay             Decimal?            @db.Decimal(14, 2)
  /// Lot D (Q6/Q105): the publisher opts this spot into automatic acceptance.
  /// Off by default, behind the instant-booking flag, never recommended.
  instantBooking         Boolean             @default(false)
  /// Lot G (Q116/136): how many advertisers this spot carries at once — a
  /// digital screen's loop capacity, set by the publisher; a static wall is 1.
  /// Availability is "n slots left" and the clash check counts slots.
  slotsTotal             Int                 @default(1)
  /// Lot D (Q5): denormalised from Review on every write so browse needs no join.
  ratingAvg              Decimal?            @db.Decimal(3, 2)
  reviewCount            Int                 @default(0)
  /// Lot A (Q48): modular suspension of one spot — BLOCK_NEW (status SUSPENDED,
  /// no new bookings), STOP_OPEN_WORK (running orders cancelled), STOP_ACCRUAL (the
  /// daily earning skips it). Written only by the suspension service; the
  /// supply sweep's lapsed-verification suspension keeps writing `suspendedAt`
  /// below and now also sets BLOCK_NEW so the two agree.
  suspensionScopes       SuspensionScope[]   @default([])
  suspensionReason       String?
  suspendedById          String?
  /// When the rate was last set. Dates the listing as a comparable — a price
  /// edited yesterday on a listing published last year is current evidence, and
  /// dating it by `publishedAt` would label it stale.
  ratePerDaySetAt        DateTime?
  /// When the surge window that was lifting the ceiling as this rate was set
  /// ends. Null when no window covered the spot.
  ///
  /// Surge is meant to move the indicator, never the pool. Comparables read
  /// listing prices live, so a publisher who raises their rate during a window —
  /// which the indicator invites — would otherwise feed that inflated rate into
  /// every neighbour's baseline. Recorded at write time, when the surge state is
  /// already known, rather than reconstructed later against a calendar that may
  /// since have changed.
  ///
  /// A timestamp rather than a flag, because the exclusion has to *expire*. A
  /// boolean was never cleared by anything, and since a NATIONAL window covers
  /// everywhere, one election or World Cup would have permanently removed every
  /// listing priced during it from every pool — a slow invisible drain whose
  /// only symptom is the indicator going quiet more often. Once the window has
  /// passed, a rate the publisher chose to leave in place is their baseline.
  ratePerDaySurgeUntil   DateTime?
  /// DR 02 step 2. Part of the comparable match key: a gym mirror decal and a
  /// hospital one are different markets.
  venueTypeId            String?
  /// Locality grade, for rate-card lookup. Null until somebody grades the spot;
  /// the lookup falls back to the card's default grade rather than refusing.
  rateGrade              RateGrade?
  /// DR 02 step 4. Measured rather than picked; `sizeClassId` is derived from
  /// these the way a media type is derived from a name.
  widthFt                Decimal?            @db.Decimal(8, 2)
  heightFt               Decimal?            @db.Decimal(8, 2)
  areaSqFt               Decimal?            @db.Decimal(10, 2)
  placement              String?
  /// DR 02 step 7. The unit the publisher thinks in, and the figure they typed.
  /// `ratePerDay` above is computed from the pair and stays canonical.
  pricingUnit            PricingUnit         @default(PER_DAY)
  basePrice              Decimal?            @db.Decimal(14, 2)
  minBookingDays         Int?
  availableFrom          DateTime?
  /// "10:00"-"22:00". Free-form because DR 02 draws it as a picker, not a rule.
  availableHoursFrom     String?
  availableHoursTo       String?
  /// "Evenings and weekends". DR 02 calls this the peak period, which is a
  /// claim about when the spot is worth most - not, as the old name suggested,
  /// a note about which days it is available at all.
  peakPeriodNote         String?
  /// The rate card the publisher uploaded. Evidence, not a price ADX applies.
  rateCardUrl            String?
  /// DR 02 step 5 — the selling story. Kept as separate columns rather than one
  /// blob because each is a distinct claim an advertiser may act on.
  targetAudience         String?
  /// "Eye-level visibility near reception". DR 02 asks for the unique selling
  /// point, which is an argument the publisher is making - not, as the old name
  /// suggested, a note about sightlines. `visibility` below is the observable
  /// property a factor rule reads; this is the sales pitch.
  uniqueSellingPoint     String?
  footfallNote           String?
  /// A number, where the note is prose. Feeds the estimated-reach figure on
  /// campaign analytics, and is null until somebody states one — which is why
  /// that figure also reports how many spots it was derived from.
  estimatedDailyFootfall Int?
  /// Physical attributes a pricing factor can key on.
  ///
  /// DR 10 models these as fixed multipliers on a central rate card —
  /// illumination 1.6x for digital, facing 1.2x at a junction, and so on. That
  /// engine is superseded, but the *attributes* are the right ones: they are
  /// observable properties of a spot that genuinely move what it is worth, and
  /// they are what a factor rule needs to read. Stored as controlled strings
  /// rather than enums so ops can extend the vocabulary without a migration —
  /// the same reason media types are a table.
  illumination           String?
  facing                 String?
  elevation              String?
  visibility             String?
  trafficGrade           String?
  monthlyPrice           Float
  pricingModel           String              @default("fixed")
  /// Structured attributes the pricing engine matches comparables on. Nullable
  /// because listings predate the engine and scraped ones arrive unclassified.
  mediaTypeId            String?
  sizeClassId            String?
  materialId             String?
  availableNow           Boolean             @default(true)
  status                 ListingStatus       @default(DRAFT)
  /// Human-readable, e.g. ADX-LST-24018. What AG-25 prints back to the publisher
  /// and what support asks for on the phone. Issued once, never reissued.
  displayId              String?             @unique
  /// When the publisher sent it for review. Distinct from `publishedAt`, which
  /// is when ADX let it onto the marketplace — the SLA runs between the two.
  submittedAt            DateTime?
  planId                 String?
  agentCanInstall        Boolean             @default(true)
  qrToken                String              @unique @default(cuid())
  plan                   MilestonePlan?      @relation(fields: [planId], references: [id])
  rejectionReason        String?
  publishedAt            DateTime?
  /// Drives the re-verification cadence.
  removability           ListingRemovability @default(PERMANENT)
  /// Last accepted verification, and when the next one falls due.
  verifiedAt             DateTime?
  verificationExpiresAt  DateTime?
  /// All required documents verified. Gates the site visit.
  documentsClearedAt     DateTime?
  suspendedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  publisher       Publisher?             @relation(fields: [publisherId], references: [id])
  agent           AgentProfile?          @relation(fields: [agentId], references: [id])
  attempt         ListingAttempt?        @relation(fields: [attemptId], references: [id])
  photos          ListingPhoto[]
  orders          Order[]
  documents       ListingDocument[]
  verifications   ListingVerification[]
  claims          ListingClaim[]
  complianceCases ComplianceCase[]
  earningsHolds   EarningsHold[]
  priceLocks      PriceLock[]
  mediaType       MediaType?             @relation(fields: [mediaTypeId], references: [id])
  sizeClass       SizeClass?             @relation(fields: [sizeClassId], references: [id])
  material        Material?              @relation(fields: [materialId], references: [id])
  pricingFactors  ListingPricingFactor[]
  campaignSpots   CampaignSpot[]
  venueType       VenueType?             @relation(fields: [venueTypeId], references: [id])
  contentRules    ListingContentRule[]

  // Access paths, not a blanket index — each one is a query that runs today.
  // `status` leads the verification index so the funnel's per-status counts
  // ride the same structure as the expiry sweep.
  priceApprovals PriceApproval[]

  disputes        Dispute[]
  earningAccruals EarningAccrual[]

  cityRef City? @relation("ListingCity", fields: [cityId], references: [id], onDelete: SetNull)

  @@index([publisherId, createdAt])
  @@index([agentId])
  @@index([attemptId])
  @@index([status, verificationExpiresAt])
  // findSimilar: same city and category, active only.
  @@index([city, category, status])
  // The pricing engine's comparable query: match key, then a coordinate
  // bounding box narrowed to the exact radius in SQL.
  // Venue joins the comparable match key, so it leads the index with the rest
  // of the key rather than sitting beside it.
  @@index([venueTypeId, mediaTypeId, sizeClassId, status])
  @@index([latitude, longitude])
  @@index([cityId])
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  url       String
  type      String   @default("main")
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// ─── Earnings & Payouts ───────────────────────────────────────────────────────

enum TransactionType {
  ORDER_COMPLETION
  BONUS
  REFERRAL
  PAYOUT
  ADJUSTMENT
}

model Transaction {
  id        String          @id @default(cuid())
  agentId   String
  type      TransactionType
  title     String
  amount    Float // positive = credit, negative = debit
  orderId   String?
  status    String          @default("COMPLETED")
  createdAt DateTime        @default(now())

  agent AgentProfile @relation(fields: [agentId], references: [id])

  @@index([agentId])
}

// ─── Milestones ───────────────────────────────────────────────────────────────

enum MilestoneType {
  ONBOARDING
  REVENUE
  ACTIVITY
  QUALITY
}

/// A growth milestone as ops define it. `target` is a count — onboardings,
/// visits, rupees, on-time arrivals — drawn as segments on the tracker.
/// `windowDays` and `startsAt` give the board its "Starts in 5 days" and
/// "Due in 10 days"; `unlockAfter` is how many milestones must be completed
/// before this one opens, which is what LOCKED means.
model MilestoneTemplate {
  id           String        @id @default(cuid())
  type         MilestoneType
  title        String
  description  String
  target       Int
  rewardAmount Decimal       @default(0) @db.Decimal(14, 2)
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  windowDays   Int?
  startsAt     DateTime?
  unlockAfter  Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  agentMilestones AgentMilestone[]
}

/// One agent's standing on one template. `progress` is a cache of a
/// derivation from the counters that already exist — never read as a source
/// (the AgentRating rule). `completedAt` is stamped the first time the
/// derivation reaches `target`; `claimedAt` and `incentiveId` are the claim,
/// which happens once.
model AgentMilestone {
  id          String    @id @default(cuid())
  agentId     String
  templateId  String
  progress    Int       @default(0)
  computedAt  DateTime?
  completedAt DateTime?
  claimedAt   DateTime?
  incentiveId String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agent    AgentProfile      @relation(fields: [agentId], references: [id])
  template MilestoneTemplate @relation(fields: [templateId], references: [id])

  @@unique([agentId, templateId])
  @@index([agentId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

/// Where a notification is delivered. IN_APP is the list the bell counts and
/// the only one wired today; the others are the frame's sections, honoured the
/// day delivery lands rather than drawn as switches that do nothing.
enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum NotificationType {
  BOOKING
  PAYOUT
  KYC
  MESSAGE
  SYSTEM
  ORDER
  DISPUTE
  /// Lot E (Q64): a broadcast from ops.
  ANNOUNCEMENT
  /// Lot AA: a work task assigned, due, blocked or awaiting review.
  WORK
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// Lot E (Q46/Q87/Q147): the outbound copy for one event, per channel. In-app
/// copy stays in code; email and SMS render from here. An SMS renders through
/// a DLT-registered template on each rail, named by `smsKind`.
model NotificationTemplate {
  id            String                @id @default(cuid())
  key           String                @unique
  event         String
  channels      NotificationChannel[] @default([])
  subject       String?
  emailBody     String?
  smsKind       String?
  smsBody       String?
  /// An OTP or a payment link: never resent from the delivery log, variables purged sooner.
  isSensitive   Boolean               @default(false)
  /// Lot G (Q117): a transactional notice ignores quiet hours and the weekly cap.
  transactional Boolean               @default(true)
  /// Lot G (Q103): push copy edited on its own; falls back to subject / smsBody.
  pushTitle     String?
  pushBody      String?
  status        TemplateStatus        @default(ACTIVE)
  version       Int                   @default(1)
  updatedById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([event, status])
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

/// One outbound send. The recipient is masked and hashed — the log is
/// readable by support and must not be a directory of phone numbers — and the
/// body is the template plus its variables, never the rendered OTP; variables
/// are purged after the retention window.
model NotificationDelivery {
  id                String              @id @default(cuid())
  userId            String?
  notificationId    String?
  templateKey       String?
  channel           NotificationChannel
  recipientMasked   String
  recipientHash     String
  variables         Json?
  status            DeliveryStatus      @default(QUEUED)
  attempts          Int                 @default(0)
  provider          String?
  providerMessageId String?
  lastError         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  purgedAt          DateTime?
  /// Lot G (Q117): a non-transactional notice deferred past quiet hours waits here.
  scheduledFor      DateTime?
  createdAt         DateTime            @default(now())

  attemptRows DeliveryAttempt[]

  @@index([status, scheduledFor])
  @@index([status, createdAt])
  @@index([recipientHash, createdAt])
  @@index([providerMessageId])
  @@index([userId, createdAt])
}

/// Lot G (Q121): one row per try, with the provider's own response text.
model DeliveryAttempt {
  id                String   @id @default(cuid())
  deliveryId        String
  attempt           Int
  provider          String?
  providerMessageId String?
  ok                Boolean
  responseText      String?
  error             String?
  at                DateTime @default(now())

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attempt])
}

/// Lot G (Q103): a phone's push registration. One row per token; a token moves
/// to whoever signs in on that device.
model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  app        DeviceApp
  platform   DevicePlatform
  token      String         @unique
  appVersion String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DeviceApp {
  USER
  AGENT
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// Lot G (Q104): a person's copy of their data, assembled by a job and mailed as
/// a time-limited link.
model DataExportRequest {
  id          String           @id @default(cuid())
  userId      String
  status      DataExportStatus @default(PENDING)
  fileId      String?
  error       String?
  requestedAt DateTime         @default(now())
  readyAt     DateTime?
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
}

enum DataExportStatus {
  PENDING
  READY
  FAILED
  EXPIRED
}

enum AnnouncementAudience {
  ALL
  PUBLISHERS
  ADVERTISERS
  AGENTS
}

enum AnnouncementImportance {
  NORMAL
  CRITICAL
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

/// Lot E (Q64/Q130): a broadcast — in-app always, email to everyone with an
/// address, SMS only when CRITICAL (service notices, never promotion).
model Announcement {
  id                 String                 @id @default(cuid())
  title              String
  body               String
  audience           AnnouncementAudience   @default(ALL)
  city               String?
  channels           NotificationChannel[]  @default([])
  importance         AnnouncementImportance @default(NORMAL)
  scheduledAt        DateTime?
  status             AnnouncementStatus     @default(DRAFT)
  recipientCount     Int                    @default(0)
  deliveredByChannel Json?
  createdById        String
  sentAt             DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  deliveries AnnouncementDelivery[]

  @@index([status, scheduledAt])
}

model AnnouncementDelivery {
  id             String              @id @default(cuid())
  announcementId String
  userId         String
  channel        NotificationChannel
  status         DeliveryStatus      @default(QUEUED)
  at             DateTime            @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, channel])
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  type            NotificationType
  title           String
  subtitle        String?
  message         String
  suggestedAction String?
  relatedId       String?
  /// Lot E7: what relatedId names, so a push opens the right record —
  /// ORDER | PUBLISHER | ADVERTISER | CAMPAIGN | STATEMENT | WITHDRAWAL | TICKET …
  relatedType     String?
  /// Lot E7: the structured facts behind a notice the apps draw as a modal
  /// (KYC_DECISION_AGENT, INCENTIVE_RECORDED, ANNOUNCEMENT), beside the prose.
  payload         Json?
  read            Boolean          @default(false)
  createdAt       DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id      String              @id @default(cuid())
  userId  String
  type    NotificationType
  /// One row per (kind, channel). Rows written before DR 07 wave 5 are IN_APP.
  channel NotificationChannel @default(IN_APP)
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([userId])
}

// ─── Support Tickets ─────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  /// Lot D (Q53): waiting on the requester; the SLA clock is paused.
  WAITING
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// DR 07 files feedback ("Suggest a feature") as a ticket with a kind of its
/// own rather than as a second ticket system: same thread, same queue, its
/// own FB- number and its own three categories.
enum TicketKind {
  ISSUE
  FEEDBACK
}

model SupportTicket {
  id                    String         @id @default(cuid())
  userId                String
  kind                  TicketKind     @default(ISSUE)
  /// TKT-1109-2601 or FB-1109-2601, minted by the identifiers module on create.
  /// Null only on rows older than the column.
  displayId             String?        @unique
  title                 String
  category              String         @default("other")
  description           String
  /// Files attached at creation — the report's upload, the feedback's screenshot.
  attachmentUrls        String[]       @default([])
  /// DR 07's Rate your experience (4453:686): 1–5 on a FEEDBACK ticket. Null
  /// on everything else — an issue is not a score.
  rating                Int?
  /// What stood out, from that frame's chips. Separate from `category`, which
  /// says what kind of feedback it is rather than what it was about.
  tags                  String[]       @default([])
  status                TicketStatus   @default(OPEN)
  relatedOrderId        String?
  /// The agent ADX put on this request.
  ///
  /// Where delegated access comes from. A publisher asking for help should never
  /// have to know an agent's id — they raise a ticket, ADX decides who handles
  /// it, and the access code they then generate is bound to whoever that was.
  /// Asking the publisher to type it would have made the assignment something
  /// they could get wrong, or be talked into getting wrong.
  assignedAgentId       String?
  assignedAt            DateTime?
  /// The ops user who made the assignment. Kept because the assignment is what
  /// authorises access to somebody else's account.
  assignedById          String?
  /// Lot D (Q53/Q91): priority, the SLA clock and the ops owner (distinct from
  /// the field agent above). The clock pauses while WAITING on the requester.
  priority              TicketPriority @default(NORMAL)
  slaFirstResponseDueAt DateTime?
  slaResolutionDueAt    DateTime?
  firstRespondedAt      DateTime?
  slaPausedAt           DateTime?
  slaPausedMs           Int            @default(0)
  assignedAdminUserId   String?
  assignedAdminAt       DateTime?
  team                  String?
  /// Lot I: live chat for paid subscribers. A LIVE_CHAT ticket streams over SSE,
  /// carries seen marks on both sides, the first-response moment (the live
  /// SLA), and the last message time the reconnect catches up from.
  channel               TicketChannel  @default(TICKET)
  requesterSeenAt       DateTime?
  agentSeenAt           DateTime?
  firstResponseAt       DateTime?
  lastMessageAt         DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user          User                   @relation(fields: [userId], references: [id])
  assignedAgent AgentProfile?          @relation(fields: [assignedAgentId], references: [id])
  messages      TicketMessage[]
  accessGrants  DelegatedAccessGrant[]

  @@index([userId])
  // The ops queue: open tickets, with the unassigned ones findable.
  @@index([status, assignedAgentId])
  @@index([channel, status, lastMessageAt])
}

enum TicketChannel {
  TICKET
  LIVE_CHAT
}

model TicketMessage {
  id               String      @id @default(cuid())
  ticketId         String
  authorId         String
  authorName       String
  message          String
  /// Lot D (Q53): an ops note the requester never sees.
  internal         Boolean     @default(false)
  /// Lot I: a private file on the message (purpose SUPPORT_ATTACHMENT), or a
  /// SYSTEM line ("Priya joined", "Converted to a ticket") the thread prints.
  kind             MessageKind @default(TEXT)
  attachmentFileId String?
  attachmentName   String?
  seenAt           DateTime?
  createdAt        DateTime    @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

enum MessageKind {
  TEXT
  ATTACHMENT
  SYSTEM
}

/// Lot I: the desk's canned replies for live chat.
model CannedReply {
  id          String   @id @default(cuid())
  title       String
  body        String
  team        String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([team, isActive])
}

// ─── Training Resources ───────────────────────────────────────────────────────

model TrainingResource {
  id            String   @id @default(cuid())
  title         String
  category      String
  duration      String?
  subtitle      String?
  topic         String?
  status        String?
  statusVariant String?
  videoUrl      String?
  documentUrl   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Training curriculum (DR 05) ──────────────────────────────────────────────
//
// The library above is flat and stays as it is; two apps read it. The
// curriculum is ordered modules with a lesson, a transcript and takeaways,
// questions whose correctness never crosses the wire, per-agent progress,
// attempts, and the certificate.

model TrainingModule {
  id                 String   @id @default(cuid())
  ordinal            Int
  title              String
  summary            String?
  durationMins       Int?
  videoUrl           String?
  /// The Lesson tab, markdown.
  lessonBody         String?
  /// The Transcript tab.
  transcript         String?
  /// The KEY TAKEAWAYS card.
  takeaways          String[] @default([])
  /// Locked until the module with this ordinal has a passed attempt; null is open.
  unlockAfterOrdinal Int?
  /// The quiz's pass mark, in percent.
  passPercent        Int      @default(80)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  questions TrainingQuestion[]
  progress  AgentTrainingProgress[]
  attempts  TrainingAttempt[]

  @@index([isActive, ordinal])
}

model TrainingQuestion {
  id        String   @id @default(cuid())
  moduleId  String
  ordinal   Int
  prompt    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  module  TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  options TrainingOption[]

  @@index([moduleId, ordinal])
}

model TrainingOption {
  id         String  @id @default(cuid())
  questionId String
  ordinal    Int
  label      String
  /// Never serialised to an agent. The quiz frame shows no feedback on purpose.
  isCorrect  Boolean @default(false)

  question TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, ordinal])
}

/// The resume card, the per-row state and the "60%". `percent` never goes
/// backwards; `completedAt` is stamped only by a passed quiz.
model AgentTrainingProgress {
  id              String    @id @default(cuid())
  agentId         String
  moduleId        String
  percent         Int       @default(0)
  lastPositionSec Int?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt

  agent  AgentProfile   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([agentId, moduleId])
}

/// "Score 5/5 — perfect run", and the retry rule: attempts are unlimited and
/// the best one counts.
model TrainingAttempt {
  id          String   @id @default(cuid())
  agentId     String
  moduleId    String
  startedAt   DateTime @default(now())
  submittedAt DateTime
  score       Int
  total       Int
  passed      Boolean
  answers     Json

  agent  AgentProfile   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([agentId, moduleId])
}

/// ADX-CERT-…, minted through `identifiers` when every active module is passed.
model AgentCertification {
  id              String    @id @default(cuid())
  agentId         String    @unique
  certificateId   String    @unique
  issuedAt        DateTime  @default(now())
  revokedAt       DateTime?
  revokedReason   String?
  revokedByUserId String?

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

// ─── Bank Accounts ────────────────────────────────────────────────────────────

/// Where a party's money goes when they withdraw.
///
/// Renamed from BankAccount because DR 04 draws UPI beside bank on the same
/// screen, and a table called BankAccount holding a VPA is a table nobody can
/// read. Verification is a state rather than a boolean: the frame draws
/// "Verification pending" as a screen of its own, and a rejected method has to
/// be able to say why.
model PayoutMethod {
  id                    String                    @id @default(cuid())
  userId                String
  type                  PayoutMethodType          @default(BANK)
  /// Bank fields. Null on a UPI method.
  accountHolder         String?
  bankName              String?
  accountNumber         String?
  ifscCode              String?
  /// Lot B (Q11): what the public IFSC directory said, and when it said it.
  /// Null when the directory was down and the typed bank name stood.
  bankBranch            String?
  ifscVerifiedAt        DateTime?
  /// UPI field. Null on a bank method.
  upiVpa                String?
  isDefault             Boolean                   @default(false)
  status                PayoutMethodStatus        @default(PENDING_VERIFICATION)
  /// How it was proved. A rail that offers a penny drop uses one; ops can
  /// always verify by hand, which is the fallback while no rail is chosen.
  verifiedVia           PayoutVerificationMethod?
  /// What the rail returned, so a disputed verification can be traced.
  verificationReference String?
  /// How closely the account holder matched the name on the KYC record. Kept
  /// even when it passes, because "passed at 71%" is a different fact from
  /// "passed at 99%" when a payout is later disputed.
  nameMatchPct          Decimal?                  @db.Decimal(5, 2)
  verifiedAt            DateTime?
  verifiedByUserId      String?
  rejectionReason       String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals WithdrawalRequest[]

  @@index([userId, status])
}

// ─── Uploaded Files ───────────────────────────────────────────────────────────

enum FileVisibility {
  PUBLIC
  PRIVATE
}

model UploadedFile {
  id          String         @id @default(cuid())
  userId      String
  url         String
  filename    String
  mimeType    String
  sizeBytes   Int
  purpose     String // e.g. "KYC", "LISTING_PHOTO", "VERIFICATION"
  /// Lot D (Q61): private files are served only through GET /files/:id to the
  /// owner, the party's agent under a live grant, or an admin.
  visibility  FileVisibility @default(PUBLIC)
  /// The party whose document this is, when it is not the uploader's own.
  ownerUserId String?
  storageKey  String?
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── RefreshToken ─────────────────────────────────────────────────────────────

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  // Stored as SHA-256 hash of the actual token
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── PasswordResetToken ───────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // Stored as SHA-256 hash of the actual token sent to the user
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── ActivityLog ──────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  /// Lot A (Q28/Q66): what the action was done to (`targetType` is a model
  /// name, `targetId` its id), which module did it, the request that carried
  /// it, and — for the named money and status models only — the values before
  /// and after, as `{ field: { before, after } }`. Everything else is "fields
  /// touched" in `metadata`, the convention the first 59 call sites set.
  targetType String?
  targetId   String?
  module     String?
  requestId  String?
  diff       Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ─── App Configuration ────────────────────────────────────────────────────────

model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Order Milestone System ───────────────────────────────────────────────────

model OrderMilestoneTemplate {
  id                    String             @id @default(cuid())
  title                 String
  description           String?
  type                  OrderMilestoneType
  requirements          Json // MilestoneRequirement[]
  estimatedDurationMins Int?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  planItems       MilestonePlanItem[]
  orderMilestones OrderMilestone[]
}

model MilestonePlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items           MilestonePlanItem[]
  listings        Listing[]
  orderMilestones OrderMilestone[]
}

model MilestonePlanItem {
  id         String  @id @default(cuid())
  planId     String
  templateId String
  order      Int
  isOptional Boolean @default(false)

  plan     MilestonePlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  template OrderMilestoneTemplate @relation(fields: [templateId], references: [id])

  @@unique([planId, order])
  @@index([planId])
}

model OrderMilestone {
  id                   String               @id @default(cuid())
  orderId              String
  templateId           String
  planId               String?
  assignedAgentId      String?
  /// Lot D (Q54): raised by a dispute's REINSTALL resolution on a finalised order.
  reinstallOfDisputeId String?
  status               OrderMilestoneStatus @default(PENDING)
  order                Int
  isOptional           Boolean              @default(false)
  dueDate              DateTime?
  notes                String?
  startedAt            DateTime?
  completedAt          DateTime?
  /// A12 — a visit dispatched to an agent who is not already holding the order
  /// is an OFFER (DR 01 3424:26829): it expires unanswered, is accepted, or is
  /// rejected with a coded reason. A milestone issued to the order's own agent
  /// is accepted on creation. The slot is the "Available slots" answer.
  offeredAt            DateTime?
  offerExpiresAt       DateTime?
  acceptedAt           DateTime?
  rejectionReason      String?
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  orderRecord   Order                    @relation(fields: [orderId], references: [id])
  template      OrderMilestoneTemplate   @relation(fields: [templateId], references: [id])
  plan          MilestonePlan?           @relation(fields: [planId], references: [id])
  assignedAgent AgentProfile?            @relation(fields: [assignedAgentId], references: [id])
  evidence      OrderMilestoneEvidence[]

  @@unique([orderId, order])
  @@index([orderId, order])
  @@index([assignedAgentId, status, dueDate])
  @@index([planId])
}

model OrderMilestoneEvidence {
  id          String   @id @default(cuid())
  milestoneId String
  kind        String
  label       String?
  value       String
  createdAt   DateTime @default(now())

  milestone OrderMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

// ─── Ported from legacy app: Advertiser KYC, Employee, RoleConfig, Advertisement, User self-KYC ──

model AdvertiserKyc {
  id                              String               @id @default(cuid())
  /// The advertiser's USER id — the legacy key. Null for an advertiser ops
  /// created on the console who has no app account yet (Lot N3); the
  /// profile key below is the one every read resolves first.
  advertiserId                    String?              @unique
  /// Lot N3: the Advertiser profile this record belongs to. Backfilled from
  /// the user link for every row that had one; new rows always carry it.
  advertiserProfileId             String?              @unique
  /// Lot E: the onboarding manifest version the party started on.
  manifestVersion                 Int?
  kycType                         String               @default("INDIVIDUAL") // "INDIVIDUAL" | "COMMERCIAL" | "NGO" | "AGENCY"
  nationalIdUrl                   String?
  panCardUrl                      String?
  utilityBillUrl                  String?
  drivingLicenseUrl               String?
  commercialIncCertUrl            String?
  commercialAssociationArticleUrl String?
  commercialPanIdUrl              String?
  commercialGstCertUrl            String?
  ngoRegCertUrl                   String?
  ngo80gCertUrl                   String?
  ngoFcraRegUrl                   String?
  agencyAuthLetterUrl             String?
  agencyGovtIdUrl                 String?
  /// DR 08 self-service capture (Steps 6–10), the same fields the publisher
  /// side holds, so the one ladder differs in data rather than in code.
  govIdType                       String? // "AADHAAR" | "PASSPORT" | "DRIVING_LICENCE"
  govIdFrontUrl                   String?
  govIdBackUrl                    String?
  panNumber                       String?
  panSignatureUrl                 String?
  addressProofType                String? // "UTILITY_BILL" | "RENT_AGREEMENT" | "BANK_STATEMENT"
  addressProofUrl                 String?
  selfieUrl                       String?
  /// U7, demand side: "MANUAL" (uploads) or "DIGIO". The Digio columns mirror PublisherKyc.
  method                          String               @default("MANUAL")
  digioRequestId                  String?
  digioReferenceId                String?
  digioStatus                     String?
  digioVerifiedAt                 DateTime?
  digioPayload                    Json?
  status                          KycStatus            @default(PENDING)
  rejectionReason                 String?
  submittedAt                     DateTime?
  reviewedAt                      DateTime?
  /// Lot D (Q42/Q61): see PublisherKyc.
  reviewedById                    String?
  reviewNote                      String?
  assignedToId                    String?
  assignedAt                      DateTime?
  /// Lot G (Q127/142): see PublisherKyc.
  escalatedAt                     DateTime?
  escalationSource                KycEscalationSource?
  escalationReason                String?
  escalatedToUserId               String?
  escalatedById                   String?
  imagesPurgedAt                  DateTime?
  /// Lot N: the desk asked for this KYC (a notice, and for DIGIO the link) —
  /// who, when, over which path; and who recorded the documents when it was
  /// not the party themselves (an agent, or an admin at the desk).
  requestedAt                     DateTime?
  requestedById                   String?
  requestedChannel                String?
  recordedById                    String?
  recordedVia                     String?
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt

  advertiser User?       @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  profile    Advertiser? @relation(fields: [advertiserProfileId], references: [id], onDelete: Cascade)

  @@index([digioRequestId])
}

/// Lot D (Q68/Q131): KYC for staff, recorded at the desk like an agent's.
model EmployeeKyc {
  id               String    @id @default(cuid())
  employeeId       String    @unique
  govIdType        String?
  govIdFrontUrl    String?
  govIdBackUrl     String?
  panNumber        String?
  panFrontUrl      String?
  panSignatureUrl  String?
  addressProofType String?
  addressProofUrl  String?
  selfieUrl        String?
  bankProofUrl     String?
  status           KycStatus @default(PENDING)
  rejectionReason  String?
  recordedById     String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  // Lot N3: the Digio path and the desk's request, like the three parties
  method           String    @default("MANUAL")
  digioRequestId   String?
  digioReferenceId String?
  digioStatus      String?
  digioVerifiedAt  DateTime?
  digioPayload     Json?
  requestedAt      DateTime?
  requestedById    String?
  requestedChannel String?
  recordedVia      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@index([digioRequestId])
}

model Employee {
  id                           String          @id @default(cuid())
  userId                       String          @unique
  /// Human-readable identifier, e.g. EMP-1209-2601. Issued once, never reissued.
  displayId                    String?         @unique
  /// Lot E (Q69): the id in the HR tool ADX links to.
  externalHrmsId               String?         @unique
  /// The free string stays for one release; departmentId is the record (Lot G, Q122).
  department                   String?
  departmentId                 String?
  designation                  String?
  /// Lot G (Q122/140): where and how the person works.
  region                       String?
  workMode                     WorkMode?
  employmentType               EmploymentType?
  isActive                     Boolean         @default(true)
  passportPhotoUrl             String?
  referenceLetterUrl           String?
  ndaAgreementUrl              String?
  nonCompeteAgreementUrl       String?
  class10MarksheetUrl          String?
  class12MarksheetUrl          String?
  graduationMarksheetUrl       String?
  postGraduationMarksheetUrl   String?
  form2NominationUrl           String?
  form6aUrl                    String?
  esiFormUrl                   String?
  form2FamilyDeclarationUrl    String?
  form6EmployeeRegistrationUrl String?
  salaryAccountLetterUrl       String?
  salarySlipUrls               String[]        @default([])
  complianceFormUrls           String[]        @default([])
  epfFormUrls                  String[]        @default([])
  gratuityFormUrls             String[]        @default([])
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc              EmployeeKyc?
  departmentRecord Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headOf           Department[] @relation("DepartmentHead")

  @@index([departmentId])
}

/// Lot G (Q122/140): the org structure ADX keeps itself — task assignment and
/// milestone analysis build on it. Hiring stays in the HR tool; openRoles is a
/// number ops keeps by hand.
model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  headId      String?
  parentId    String?
  regions     String[] @default([])
  openRoles   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

