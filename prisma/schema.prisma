}

enum ComplianceCaseStatus {
  OPEN
  CONTACTED
  RESOLVED
  ESCALATED
}

enum ContactAttemptChannel {
  CALL
  SMS
  EMAIL
  WHATSAPP
  IN_APP
}

enum EarningsHoldStatus {
  HELD
  RELEASED
  FORFEITED
}

/// One version of one kind of agreement. Managed by modules/agreements; the
/// supply and advertisers modules read the live version through their gates.
model AgreementTemplate {
  id                   String        @id @default(cuid())
  kind                 AgreementKind
  version              Int
  title                String
  /// Markdown. LISTING templates may reference {{listings}} for the enumeration.
  body                 String
  isActive             Boolean       @default(false)
  effectiveFrom        DateTime      @default(now())
  /// When this version was made the live one. Null means it never was: a
  /// draft, the only kind of version whose text may still change, because
  /// nobody can have accepted it. Restamped when an older version is brought
  /// back; the acceptance rows carry the true timeline either way.
  activatedAt          DateTime?
  /// When a later version replaced it. Null while live or still a draft.
  retiredAt            DateTime?
  /// Who wrote this version. An id without a relation, like campaignId on the
  /// acceptance: the User model is not this module's to extend.
  createdByUserId      String?
  /// What changed from the previous version, for the person reading the list.
  changeNote           String?
  /// Lot D (Q55): a platform-scope version that every party must accept again
  /// before transacting; transaction kinds never need it — each transaction
  /// accepts the version live at that moment.
  requiresReacceptance Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  acceptances AgreementAcceptance[]

  @@unique([kind, version])
  @@index([kind, isActive])
}

/// A click-accept, not a signature: who accepted, which version, when, from where.
model AgreementAcceptance {
  id                String            @id @default(cuid())
  templateId        String
  templateKind      AgreementKind
  templateVersion   Int
  /// Exactly one of publisherId / advertiserId / agentId is set, decided by templateKind.
  publisherId       String?
  advertiserId      String?
  /// Lot D (Q55): JOB_TERMS are the agent's own acceptance.
  agentId           String?
  /// Set for LISTING acceptances; one acceptance per attempt.
  attemptId         String?
  /// Set for INSERTION_ORDER acceptances; one acceptance per campaign.
  campaignId        String?
  /// Lot D (Q55): PACKAGE_SALE and JOB_TERMS anchors.
  packageSaleId     String?
  orderId           String?
  acceptedByUserId  String
  acceptedAt        DateTime          @default(now())
  ipAddress         String?
  userAgent         String?
  /// The enumerated listing agreement exactly as accepted. Listings change.
  renderedDocument  String?
  /// Lot D (Q123): click-accept today; the seam for an e-sign later.
  signatureProvider SignatureProvider @default(NONE)
  signatureRef      String?

  template   AgreementTemplate @relation(fields: [templateId], references: [id])
  publisher  Publisher?        @relation(fields: [publisherId], references: [id])
  advertiser Advertiser?       @relation(fields: [advertiserId], references: [id])
  attempt    ListingAttempt?   @relation(fields: [attemptId], references: [id])
  acceptedBy User              @relation(fields: [acceptedByUserId], references: [id])

  // The uniqueness rules live in the migration as partial indexes: a party
  // accepts a PLATFORM-scope template version once; a transaction (attempt,
  // campaign, package sale, order) accepts a template version once.
  @@index([publisherId, templateKind])
  @@index([advertiserId, templateKind])
  @@index([agentId, templateKind])
  @@index([campaignId])
  @@index([attemptId])
  @@index([packageSaleId])
  @@index([orderId])
}

/// The batch a listing agreement attaches to. Every listing belongs to one.
model ListingAttempt {
  id              String               @id @default(cuid())
  /// Null for SCRAPE attempts until a listing in them is claimed.
  publisherId     String?
  origin          ListingAttemptOrigin
  status          ListingAttemptStatus @default(DRAFT)
  createdByUserId String?
  /// ADMIN_BULK: the spreadsheet this batch came from.
  sourceFilename  String?
  note            String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  publisher   Publisher?            @relation(fields: [publisherId], references: [id])
  createdBy   User?                 @relation(fields: [createdByUserId], references: [id])
  listings    Listing[]
  /// Lot D: one acceptance per template version per attempt — a list in the
  /// schema, a partial unique in the migration.
  acceptances AgreementAcceptance[]

  @@index([publisherId, status])
  @@index([status, createdAt])
}

model ListingDocument {
  id               String                @id @default(cuid())
  listingId        String
  kind             ListingDocumentKind
  url              String
  status           ListingDocumentStatus @default(PENDING)
  rejectionReason  String?
  expiresAt        DateTime?
  submittedAt      DateTime              @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation(fields: [reviewedByUserId], references: [id])

  @@index([listingId, status])
  @@index([status, submittedAt])
}

/// Photographic proof the spot exists, with the coordinates it was taken at.
model ListingVerification {
  id                String             @id @default(cuid())
  listingId         String
  type              VerificationType
  status            VerificationStatus @default(SUBMITTED)
  photoUrl          String
  latitude          Float
  longitude         Float
  /// Distance from the listing's stored coordinates, in metres.
  distanceMeters    Float?
  /// A QR scan at the site alongside the photo widens the accepted radius.
  qrScanned         Boolean            @default(false)
  capturedAt        DateTime
  submittedByUserId String?
  /// AGENT_INITIAL visits ride the order machine; this is that order.
  orderId           String?
  reviewedAt        DateTime?
  reviewedByUserId  String?
  rejectionReason   String?
  createdAt         DateTime           @default(now())

  listing     Listing                    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  submittedBy User?                      @relation("VerificationSubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedBy  User?                      @relation("VerificationReviewedBy", fields: [reviewedByUserId], references: [id])
  photos      ListingVerificationPhoto[]

  @@index([listingId, createdAt])
  @@index([status])
}

/// One named shot inside a site verification.
///
/// A guided visit asks for several proofs by name — the decal straight on, the
/// decal from an angle, the fixture, the wider zone — and a reviewer can only
/// judge a shot if they know which one it was meant to be. `photoUrl` on the
/// parent stays the first of these, so everything that reads a verification's
/// single photo is unaffected.
model ListingVerificationPhoto {
  id             String   @id @default(cuid())
  verificationId String
  url            String
  /// The requirement label this shot answers, verbatim from the milestone
  /// template. Null for a single-photo submission that named nothing.
  label          String?
  /// Position in the sequence the agent was walked through.
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  verification ListingVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId, order])
}

/// A publisher asserting ownership of a scraped listing. Two can claim one spot.
model ListingClaim {
  id                  String             @id @default(cuid())
  listingId           String
  claimantPublisherId String
  status              ListingClaimStatus @default(PENDING)
  evidenceNote        String?
  decisionNote        String?
  decidedAt           DateTime?
  decidedByUserId     String?
  createdAt           DateTime           @default(now())

  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  claimant  Publisher @relation(fields: [claimantPublisherId], references: [id])
  decidedBy User?     @relation(fields: [decidedByUserId], references: [id])

  @@unique([listingId, claimantPublisherId])
  @@index([status, createdAt])
}

/// Opened three days into a lapse; 3-4 contact attempts across 48 hours.
model ComplianceCase {
  id               String               @id @default(cuid())
  listingId        String
  publisherId      String?
  reason           ComplianceCaseReason
  status           ComplianceCaseStatus @default(OPEN)
  openedAt         DateTime             @default(now())
  /// Suspension falls due here if the case is still open.
  dueAt            DateTime
  resolvedAt       DateTime?
  assignedToUserId String?

  listing    Listing                    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  publisher  Publisher?                 @relation(fields: [publisherId], references: [id])
  assignedTo User?                      @relation(fields: [assignedToUserId], references: [id])
  attempts   ComplianceContactAttempt[]

  @@index([status, dueAt])
  @@index([listingId])
}

model ComplianceContactAttempt {
  id                String                @id @default(cuid())
  caseId            String
  channel           ContactAttemptChannel
  outcome           String
  note              String?
  attemptedAt       DateTime              @default(now())
  attemptedByUserId String?

  case        ComplianceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attemptedBy User?          @relation(fields: [attemptedByUserId], references: [id])

  @@index([caseId, attemptedAt])
}

/// Records the obligation only. Moving money needs the ledger the money
/// workstream will build - see docs/publisher-supply-lifecycle.md.
model EarningsHold {
  id          String             @id @default(cuid())
  listingId   String
  publisherId String
  amount      Float              @default(0)
  status      EarningsHoldStatus @default(HELD)
  heldFrom    DateTime           @default(now())
  /// heldFrom + 24h: the hold converts to a penalty at this point.
  convertsAt  DateTime
  releasedAt  DateTime?
  forfeitedAt DateTime?
  note        String?

  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  publisher Publisher @relation(fields: [publisherId], references: [id])

  @@index([status, convertsAt])
  @@index([listingId])
}

// --- Human-readable identifiers ----------------------------------------------
// PUB-1909-2601 reads as: a publisher, joined 19 September, 2026, first that day.
// See src/modules/identifiers/README.md.

// ─────────────────────────────────────────────────────────────────────────────
// Advertiser onboarding — see docs/advertiser-onboarding.md
//
// Deliberately symmetrical with the publisher supply lifecycle: five gates, an
// umbrella agreement then a per-transaction one, and money that moves through
// holds rather than direct debits.
// ─────────────────────────────────────────────────────────────────────────────

/// Legal entity form. Mirrors the four document sets already encoded in
/// AdvertiserKyc.kycType, which is a String there and stays one.
enum AdvertiserType {
  INDIVIDUAL
  COMMERCIAL
  NGO
  AGENCY
}

/// Restricted in Indian OOH to varying degrees, by state and by media type.
/// The sector is a property of the brand; what it may do is decided by the
/// category rules, not here.
enum BrandSector {
  GENERAL
  ALCOHOL
  TOBACCO
  GAMBLING
  PHARMA
  POLITICAL
  FINANCIAL
  REAL_ESTATE
  EDUCATION
  HEALTHCARE
  INFANT_NUTRITION
}

/// Every way money moves through a wallet, on both sides of the balance sheet.
///
/// The first five are the demand side: an advertiser funds a wallet, spends it
/// on a campaign, receives goodwill when a listing lapses under them, or is
/// refunded. The rest are the earning side, absorbed from the agent-only
/// `Transaction` model so publishers, agents and partners share one ledger
/// rather than each growing their own.
enum WalletEntryType {
  TOPUP
  CAMPAIGN_DEBIT
  /// A subscription package bought from an agent. Named rather than folded into
  /// CAMPAIGN_DEBIT, because a statement that calls a plan a campaign is a
  /// statement nobody can reconcile.
  PACKAGE_DEBIT
  GOODWILL_CREDIT
  REFUND
  ADJUSTMENT
  /// Work done: an order completed, a listing earning for its flight.
  EARNING
  BONUS
  REFERRAL
  /// Paid out to a verified bank account. The earning side's exit.
  PAYOUT
  /// The counterpart of GOODWILL_CREDIT: what a lapsed publisher forfeits.
  PENALTY
  /// Credit that went unused for the dormancy window and lapsed.
  EXPIRY
}

/// Why a refund was asked for. Not exhaustive by design — support raises the
/// request and an admin ratifies it, so OTHER is a legitimate answer with a
/// note rather than a gap in the taxonomy.
enum RefundReason {
  /// ADX could not offer an alternative the advertiser found acceptable.
  NO_SUITABLE_ALTERNATIVE
  /// The publisher stopped providing the site mid-campaign.
  PUBLISHER_WITHDREW
  /// Leaving ADX, with unspent top-up left over.
  ADVERTISER_LEAVING
  OTHER
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Support pulled it before anyone decided.
  WITHDRAWN
  /// Lot B (Q41): an approved BANK_TRANSFER refund that finance has paid out.
  PAID
  FAILED
}

/// Lot B (Q41): where an approved refund goes. Wallet credit-back is the
/// preference; a bank transfer or a return to the original method needs the
/// consumer's recorded agreement first.
enum RefundDestination {
  WALLET_CREDIT
  BANK_TRANSFER
  ORIGINAL_METHOD
}

enum TopUpMethod {
  BANK_TRANSFER
  CHEQUE
  GATEWAY
}

/// Lot B (Q41): a bank transfer (or cheque) ops record against an advertiser
/// wallet — with the UTR, the date it landed, which ADX account it landed in
/// and the proof — so a bank statement line can later be matched to it.
model WalletTopUp {
  id                  String      @id @default(cuid())
  walletId            String
  amount              Decimal     @db.Decimal(14, 2)
  method              TopUpMethod
  utr                 String?
  receivedAt          DateTime
  bankAccountId       String?
  proofFileId         String?
  paymentId           String?
  note                String?
  recordedByUserId    String
  walletEntryId       String?
  ledgerTransactionId String?
  reconciledAt        DateTime?
  createdAt           DateTime    @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, receivedAt])
  @@index([utr])
}

enum CampaignRefundStatus {
  PENDING
  RELEASED
  REJECTED
}

/// Lot B (Q41): a campaign cancelled after its money was captured. The credit
/// back to the advertiser waits for finance — the disputes pattern.
model CampaignRefund {
  id                  String               @id @default(cuid())
  campaignId          String               @unique
  amount              Decimal              @db.Decimal(14, 2)
  status              CampaignRefundStatus @default(PENDING)
  reason              String
  requestedByUserId   String
  releasedByUserId    String?
  releasedAt          DateTime?
  ledgerTransactionId String?
  createdAt           DateTime             @default(now())

  @@index([status, createdAt])
}

enum WalletHoldStatus {
  HELD
  CAPTURED
  RELEASED
}

model Advertiser {
  id               String            @id @default(cuid())
  /// Null while an AGENT_ADVERTISER holds the account open for someone who has
  /// not registered yet — the same arrangement Publisher.userId has.
  userId           String?           @unique
  /// AgentProfile.id of whoever brought the account. Nothing pays out on this
  /// yet; it is here so attribution is not lost before B5 can use it.
  agentId          String?
  name             String
  mobile           String            @unique
  email            String?
  type             AdvertiserType    @default(INDIVIDUAL)
  companyName      String?
  gstin            String?
  billingAddress   String?
  city             String?
  /// Lot X: the catalogue city the free-text `city` resolved to (null when it did not); every read that groups by city groups by this.
  cityId           String?
  state            String?
  /// Lot G (Q119): an optional picklist value captured at onboarding, editable by ops.
  industry         String?
  /// Human-readable identifier, e.g. ADV-1909-2601. Issued once, never reissued.
  displayId        String?           @unique
  kycStatus        KycStatus         @default(PENDING)
  /// Null for everyone. Prepay is the only funded state today; the column
  /// exists so granting terms later is a value change, not a migration.
  creditLimit      Decimal?          @db.Decimal(14, 2)
  /// KYC verified and the platform agreement accepted.
  activatedAt      DateTime?
  /// Lot A (Q40): modular suspension — BLOCK_NEW (no new campaigns or package
  /// purchases), STOP_OPEN_WORK (running campaigns halted), FREEZE_WALLET, BLOCK_SIGNIN.
  suspensionScopes SuspensionScope[] @default([])
  suspendedAt      DateTime?
  suspensionReason String?
  suspendedById    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user                 User?                  @relation(fields: [userId], references: [id])
  /// Lot N3: the KYC record, keyed by this profile rather than the user.
  kyc                  AdvertiserKyc?
  agent                AgentProfile?          @relation(fields: [agentId], references: [id])
  brands               Brand[]
  wallet               Wallet?
  agreementAcceptances AgreementAcceptance[]
  priceLocks           PriceLock[]
  accessGrants         DelegatedAccessGrant[]
  aiGenerations        AiGeneration[]

  quotes       Quote[]
  campaigns    Campaign[]
  packageSales PackageSale[]
  activity     AccountActivity[]

  cityRef City? @relation("AdvertiserCity", fields: [cityId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([mobile])
  @@index([kycStatus, createdAt])
  @@index([cityId])
}

/// Campaigns, creatives and brand-safety decisions belong to a brand; the
/// wallet, invoices, KYC and the platform agreement belong to the account. A
/// direct advertiser is the degenerate case of one brand, created at gate 2.
model Brand {
  id           String      @id @default(cuid())
  advertiserId String
  name         String
  sector       BrandSector @default(GENERAL)
  logoUrl      String?
  website      String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaigns  Campaign[]

  @@unique([advertiserId, name])
  @@index([advertiserId])
  @@index([sector])
}

/// MONEY IS Decimal HERE, not Float.
///
/// The rest of the schema stores amounts as Float, which is survivable for a
/// budget or a payout figure and is not survivable for a running balance: the
/// error compounds every entry. This is the ledger, so it takes the correct
/// type, and the Float columns feeding it convert at the boundary.
/// ONE WALLET MODEL, EVERY PARTY.
///
/// Ownership is nullable foreign keys with exactly one set, not a `partyType` +
/// `partyId` pair. The polymorphic shape reads better and matches the
/// identifier vocabulary, but Prisma cannot express a polymorphic relation, so
/// it would cost the foreign key — and a row holding a balance with no owner is
/// the one kind of orphan a money table must not permit. It would also break
/// every existing join, starting with the advertiser activation funnel.
///
/// The CHECK constraint enforcing "exactly one" is added by the migration,
/// since Prisma has no syntax for it. A fourth key joins here when print
/// partners get a model of their own.
model Wallet {
  id             String    @id @default(cuid())
  advertiserId   String?   @unique
  publisherId    String?   @unique
  agentId        String?   @unique
  /// Lot B (Q50): the fourth owner — a print partner is a payee.
  printPartnerId String?   @unique
  /// Settled balance. Open holds are NOT deducted here — spendable balance is
  /// this minus open holds, computed rather than stored, so the two can never
  /// drift apart.
  balance        Decimal   @default(0) @db.Decimal(14, 2)
  /// Tracked apart from balance because goodwill is spendable on bookings and
  /// never withdrawable. Mixing the two would make it withdrawable by accident.
  goodwill       Decimal   @default(0) @db.Decimal(14, 2)
  currency       String    @default("INR")
  /// When money last moved, in either direction. Denormalised deliberately:
  /// dormancy is swept across every wallet, and deriving it from the newest
  /// entry per wallet would be a correlated subquery over the whole ledger.
  /// Written in the same transaction as the entry that sets it.
  lastActivityAt DateTime?
  /// Lot A (Q40/Q54): a frozen wallet refuses withdrawals (payout parties) and
  /// new holds or debits (advertisers). Accruals and credits still land, so the
  /// books stay true; only money leaving is stopped.
  frozenAt       DateTime?
  frozenReason   String?
  frozenById     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  advertiser     Advertiser?           @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  publisher      Publisher?            @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  agent          AgentProfile?         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  printPartner   PrintPartner?         @relation(fields: [printPartnerId], references: [id], onDelete: Cascade)
  entries        WalletEntry[]
  holds          WalletHold[]
  refundRequests WalletRefundRequest[]
  withdrawals    WithdrawalRequest[]
  topUps         WalletTopUp[]
  statements     Statement[]
  /// The double-entry account that mirrors this wallet. WalletEntry stays as the
  /// party's own statement; this is the side that has to balance against ADX.
  ledgerAccount  LedgerAccount?

  @@index([lastActivityAt])
}

/// A refund asked for through support and decided by an admin.
///
/// Never self-service: the advertiser wallet holds credit for future bookings,
/// and a refund is the exception to that rather than a feature of it. Raising a
/// request freezes the amount with a WalletHold so money that has been asked
/// back cannot be spent on a booking while the decision is outstanding.
model WalletRefundRequest {
  id                  String              @id @default(cuid())
  walletId            String
  amount              Decimal             @db.Decimal(14, 2)
  reason              RefundReason
  /// Why, in the raiser's own words. Required — a refund with no stated reason
  /// is not reviewable six months later.
  note                String
  status              RefundRequestStatus @default(PENDING)
  /// The hold freezing the money while this is open.
  holdId              String?             @unique
  /// The support ticket it came from, when there was one.
  ticketId            String?
  raisedByUserId      String
  decidedByUserId     String?
  decidedAt           DateTime?
  decisionNote        String?
  /// Lot B (Q41): where the money goes and the consumer's agreement to it.
  /// A BANK_TRANSFER needs a payout method to send to and a consent note; once
  /// finance has paid it the UTR and the date are here.
  destination         RefundDestination   @default(WALLET_CREDIT)
  consentNote         String?
  payoutMethodId      String?
  rail                PayoutRailName?
  railReference       String?
  paidAt              DateTime?
  paidByUserId        String?
  ledgerTransactionId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  wallet    Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  raisedBy  User   @relation("RefundRaisedBy", fields: [raisedByUserId], references: [id])
  decidedBy User?  @relation("RefundDecidedBy", fields: [decidedByUserId], references: [id])

  @@index([status, createdAt])
  @@index([walletId])
}

/// One PACKAGE_DEBIT pair per sale is enforced by a partial unique index added
/// in the migration -- ("reference", "isGoodwill") where type = 'PACKAGE_DEBIT'.
/// Prisma cannot express a partial index, and a whole-table one would break the
/// other entry types, whose references legitimately repeat.
model WalletEntry {
  id           String          @id @default(cuid())
  walletId     String
  type         WalletEntryType
  /// Signed: credits positive, debits negative.
  amount       Decimal         @db.Decimal(14, 2)
  /// Balance immediately after this entry, so a statement renders without
  /// replaying the ledger from the beginning.
  balanceAfter Decimal         @db.Decimal(14, 2)
  /// True when the entry moved goodwill rather than settled balance.
  isGoodwill   Boolean         @default(false)
  campaignId   String?
  /// The earning side's equivalent of campaignId, absorbed from Transaction.
  orderId      String?
  holdId       String?         @unique
  reference    String?
  note         String?
  createdAt    DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([campaignId])
  @@index([orderId])
}

/// Placed when a campaign is confirmed, captured when it starts, released if it
/// is cancelled first. Same shape as EarningsHold on the supply side, for the
/// same reason: a release is cheap and a refund is not.
model WalletHold {
  id         String           @id @default(cuid())
  walletId   String
  /// No Campaign model yet (B2), so this is an id without a relation.
  campaignId String
  amount     Decimal          @db.Decimal(14, 2)
  status     WalletHoldStatus @default(HELD)
  heldAt     DateTime         @default(now())
  capturedAt DateTime?
  releasedAt DateTime?
  note       String?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@index([campaignId])
}

enum PartyType {
  PUBLISHER
  ADVERTISER
  PARTNER
  EMPLOYEE
  AGENT
  /// Not parties: the two support series (TKT-, FB-) mint through the same
  /// counter so a ticket number is issued once and never derived on read.
  TICKET
  FEEDBACK
  /// DSP-…, the dispute series.
  DISPUTE
  /// SFT-…, the safety series.
  SAFETY
  /// LED-#### on a prospect, so ops can name one on the phone.
  LEAD
  /// VST-#### on a field visit.
  VISIT
  /// ADX-CERT-…, the certificate series.
  CERTIFICATE
  /// FRD-…, the fraud-case series (Lot E).
  FRAUD_CASE
  /// Lot AA: TSK-…, ISS-…, PRJ-… — the DR 10 work series.
  TASK
  ISSUE
  PROJECT
}

/// The shape a party's identifier takes when the next one is issued.
///
/// Changing this never rewrites an identifier already handed out: issued values
/// are stored on the party, not derived on read, because they end up on
/// agreements, invoices and support tickets and must not move.
model IdentifierFormat {
  id         String    @id @default(cuid())
  party      PartyType @unique
  /// Leading segment, e.g. "PUB".
  prefix     String
  /// Tokens: {PREFIX} {DD} {MM} {YY} {YYYY} {SEQ}. Anything else is literal.
  pattern    String    @default("{PREFIX}-{DD}{MM}-{YY}{SEQ}")
  /// Width the daily sequence is padded to. A busier day simply grows past it
  /// rather than colliding — padding is cosmetic, uniqueness is not.
  seqPadding Int       @default(2)
  /// IANA zone deciding which calendar day a signup falls on.
  timeZone   String    @default("Asia/Kolkata")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// One row per party per day, incremented atomically to hand out sequences.
///
/// The increment is an upsert so two simultaneous signups cannot both take 01;
/// the unique constraint on each party's displayId is the backstop behind it.
model IdentifierCounter {
  id      String    @id @default(cuid())
  party   PartyType
  /// Calendar day in the format's timeZone, YYYY-MM-DD.
  dateKey String
  next    Int       @default(1)

  @@unique([party, dateKey])
}

// ─── Pricing engine ───────────────────────────────────────────────────────────
//
// A price-range suggester, not a quoter. See docs/pricing-engine.md.
//
// The whole subsystem rests on one query: find the spots that are the same kind
// of thing within 200 m, and report the lowest and highest price among them.
// Every model below either feeds that query or explains its answer.

enum MediaTypeStatus {
  ACTIVE
  /// Folded into another type by ops. Kept as a tombstone so old references
  /// still resolve rather than dangling.
  MERGED
}

enum MediaTypeOrigin {
  SEEDED
  OPS
  /// Created by the similarity threshold when a listing matched nothing.
  AUTO_MATCHED
}

enum MediaTypeMatchOutcome {
  MATCHED
  CREATED
}

enum MarketDataSource {
  /// Imported output of the research team's fieldwork. Their process happens
  /// entirely outside this platform; only the rows land here.
  RESEARCH
  /// Publisher-supplied and unverified. Provisional evidence, displaced as soon
  /// as real comparables exist.
  RATE_CARD
}

enum PricingFactorKind {
  BASE_ADJUST
  MULTIPLIER
}

enum SurgeEventScope {
  CITY
  NATIONAL
  INTERNATIONAL
}

enum SurgeEventSource {
  SCRAPER
  OPS
  AI_AGENT
}

enum VocabularyKind {
  MEDIA_TYPE
  SIZE_CLASS
  MATERIAL
  VENUE_TYPE
}

/// The taxonomy the comparable set is keyed on.
///
/// Fragmentation is the failure mode that matters: two types that should be one
/// is repairable, but a split taxonomy empties every comparable set silently.
/// So matching is biased toward MATCHED, every decision is logged, and ops can
/// merge afterwards.
model MediaType {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  category        ListingCategory
  description     String?
  status          MediaTypeStatus  @default(ACTIVE)
  origin          MediaTypeOrigin  @default(OPS)
  /// The venue this spot type lives in. Null for outdoor, which has no venue —
  /// a hoarding is on a road, not inside anything.
  venueTypeId     String?
  /// The heading this format sits under in the catalogue — "Digital Displays",
  /// "Static Formats", "Experiential & Ambient". A shopping mall has sixty-four
  /// formats, and step 3 of the listing wizard is unreadable as one flat list.
  /// Presentation only: nothing in the match key reads it.
  formatGroup     String?
  /// Set when this type is merged away. Listings are re-pointed; this row stays.
  mergedIntoId    String?
  mergedAt        DateTime?
  createdAt       DateTime         @default(now())
  commissionRates CommissionRate[]
  updatedAt       DateTime         @updatedAt

  mergedInto MediaType?  @relation("MediaTypeMerge", fields: [mergedIntoId], references: [id])
  mergedFrom MediaType[] @relation("MediaTypeMerge")
  venueType  VenueType?  @relation(fields: [venueTypeId], references: [id])

  listings    Listing[]
  dataPoints  MarketDataPoint[]
  factors     PricingFactor[]
  matchLogs   MediaTypeMatchLog[]
  sizeClasses MediaTypeSizeClass[]
  materials   MediaTypeMaterial[]

  rateCardEntries RateCardEntry[]

  pricingCategoryRules PricingCategoryRule[]
  quoteLines           QuoteLine[]

  @@index([category, status])
  @@index([mergedIntoId])
}

/// Standard OOH dimensions. Size matches exactly within a class — a 10-footer
/// compares only to 10-footers, because price per square foot is not linear
/// across sizes and averaging across regimes invents a number nobody quotes.
model SizeClass {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  widthFt   Decimal? @db.Decimal(8, 2)
  heightFt  Decimal? @db.Decimal(8, 2)
  /// Reference only — nothing in the engine divides by it.
  ///
  /// Per-sq-ft normalisation would be the obvious thing to do here and is
  /// deliberately absent: the match key requires an exact size class, so every
  /// price in a pool is already for an identical area and dividing by a
  /// constant before taking a min and a max changes nothing. Kept because ops
  /// and the console display it, and because a future class defined as a range
  /// rather than exact dimensions would need it. Null for classes that are not
  /// rectangular panels.
  areaSqFt  Decimal? @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings   Listing[]
  dataPoints MarketDataPoint[]
  mediaTypes MediaTypeSizeClass[]

  @@index([isActive])
}

/// Installation material. Not part of the comparable match key — it is
/// approximate by nature and gating on it would empty the set. It earns its
/// keep as an input to media-type similarity.
model Material {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings   Listing[]
  dataPoints MarketDataPoint[]
  mediaTypes MediaTypeMaterial[]
}

/// A value that arrived not matching any controlled list.
///
/// Logged rather than silently created: free text is what shatters a taxonomy,
/// and the whole point of the controlled lists is that ops decides what joins
/// them.
model VocabularyProposal {
  id           String         @id @default(cuid())
  kind         VocabularyKind
  rawValue     String
  /// Where it came from, for ops to trace back.
  listingId    String?
  importId     String?
  occurrences  Int            @default(1)
  resolvedAt   DateTime?
  resolvedById String?
  /// Slug ops mapped it onto, if they mapped rather than created.
  resolvedTo   String?
  createdAt    DateTime       @default(now())

  @@unique([kind, rawValue])
  @@index([resolvedAt])
}

/// Every media-type match decision, kept whether it matched or created.
///
/// This log is how fragmentation gets noticed early. Without it, a drifting
/// threshold shows up months later as an indicator that stopped appearing.
model MediaTypeMatchLog {
  id           String                @id @default(cuid())
  proposedName String
  /// The attribute vector the threshold read.
  attributes   Json
  mediaTypeId  String?
  similarity   Decimal?              @db.Decimal(5, 4)
  outcome      MediaTypeMatchOutcome
  listingId    String?
  createdAt    DateTime              @default(now())

  mediaType MediaType? @relation(fields: [mediaTypeId], references: [id])

  @@index([outcome, createdAt])
  @@index([mediaTypeId])
}

/// One upload of research output or a rate card.
model MarketDataImport {
  id            String           @id @default(cuid())
  source        MarketDataSource
  filename      String?
  note          String?
  uploadedById  String?
  rowCount      Int              @default(0)
  acceptedCount Int              @default(0)
  rejectedCount Int              @default(0)
  /// Rows that failed validation, kept so ops can fix and re-upload.
  rejections    Json?
  createdAt     DateTime         @default(now())

  dataPoints MarketDataPoint[]

  @@index([source, createdAt])
}

/// A comparable that is not an ADX listing.
///
/// ADX listings are comparables too, read from `Listing` directly — they are
/// not copied here, because a copy would go stale the moment a publisher edits
/// their price.
model MarketDataPoint {
  id              String           @id @default(cuid())
  source          MarketDataSource
  importId        String?
  /// Whose opinion this is. One data point per contributor per range: a
  /// competitor with ten hoardings on one road is one opinion, not ten. The
  /// same key covers ADX listings, where the contributor is the publisher.
  contributorKey  String
  contributorName String?
  /// Set when the row came from a publisher's own rate card.
  publisherId     String?
  /// Part of the match key, so a researched gym decal compares to gym decals.
  /// Null on rows gathered before venues existed, which then match nothing —
  /// visible as a gap rather than as a silently wrong comparison.
  venueTypeId     String?
  mediaTypeId     String
  sizeClassId     String
  materialId      String?
  latitude        Float
  longitude       Float
  city            String?
  locality        String?
  /// Canonical unit for the whole platform.
  ratePerDay      Decimal          @db.Decimal(14, 2)
  /// When the price was observed, not when it was uploaded. Drives staleness.
  observedAt      DateTime
  /// Cleared rather than deleted, so a bad import can be undone without losing
  /// the audit trail.
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  import    MarketDataImport? @relation(fields: [importId], references: [id])
  publisher Publisher?        @relation(fields: [publisherId], references: [id])
  mediaType MediaType         @relation(fields: [mediaTypeId], references: [id])
  sizeClass SizeClass         @relation(fields: [sizeClassId], references: [id])
  material  Material?         @relation(fields: [materialId], references: [id])

  // The comparable query: match key first, then a bounding box on coordinates.
  @@index([venueTypeId, mediaTypeId, sizeClassId, isActive])
  @@index([latitude, longitude])
  @@index([importId])
  @@index([publisherId])
}

/// A per-media-type adjustment to a suggested price.
///
/// Two kinds because the answer to "does this move the base or scale it" is not
/// the same for every factor, and one nullable-value column per kind keeps the
/// arithmetic honest rather than overloading a single number.
///
/// Size is deliberately absent: it is a base pricing factor, already counted
/// once in the size class. Counting it again here is the classic double-count.
enum PricingFactorMode {
  ADVISORY
  BINDING
}

model PricingFactor {
  id                     String            @id @default(cuid())
  name                   String
  slug                   String
  description            String?
  kind                   PricingFactorKind
  mediaTypeId            String
  /// Set when kind is MULTIPLIER. e.g. 1.1500
  multiplier             Decimal?          @db.Decimal(6, 4)
  /// Set when kind is BASE_ADJUST, in rupees per day.
  baseAdjust             Decimal?          @db.Decimal(14, 2)
  /// The engine proposes a factor when a listing's derived attributes match
  /// this expression. Null means it is never auto-proposed — ops applies it by
  /// hand or not at all.
  suggestWhen            Json?
  /// Lot E (Q59/Q125): ADVISORY proposes a rate the publisher may accept;
  /// BINDING reprices the listing when applied — within `maxBindingChangePct`
  /// of PricingSettings, and only inside an active surge when the flag says so.
  mode                   PricingFactorMode @default(ADVISORY)
  bindingDuringSurgeOnly Boolean           @default(false)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  mediaType   MediaType              @relation(fields: [mediaTypeId], references: [id], onDelete: Cascade)
  application ListingPricingFactor[]

  @@unique([mediaTypeId, slug])
  @@index([mediaTypeId, isActive])
}

/// Which factors the engine proposed for a listing, and which a person applied.
///
/// The engine never multiplies a price on its own. It suggests the favourable
/// ones, lists every candidate alongside, and a person decides — so `suggested`
/// and `applied` are separate columns rather than one state.
model ListingPricingFactor {
  id                String    @id @default(cuid())
  listingId         String
  factorId          String
  suggested         Boolean   @default(false)
  applied           Boolean   @default(false)
  /// Lot E: the rate a BINDING apply wrote, for the trail.
  appliedRatePerDay Decimal?  @db.Decimal(14, 2)
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  listing Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  factor  PricingFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)

  @@unique([listingId, factorId])
  @@index([listingId, applied])
}

/// A window during which the indicator tolerates a higher price.
///
/// Surge moves the indicator, never the price and never the pool. A publisher
/// can raise their rate during a window without being flagged as too high; the
/// baselines the engine compares against are unaffected.
model SurgeEvent {
  id              String           @id @default(cuid())
  name            String
  scope           SurgeEventScope
  source          SurgeEventSource @default(SCRAPER)
  /// Which configured source produced this, when one did. Lets ops disable a
  /// source and see everything it was responsible for.
  scraperSourceId String?
  /// Provider's id for the event, so a re-scrape updates rather than duplicates.
  externalRef     String?
  city            String?
  /// `city` resolved through the City table. Null when it resolved to nothing,
  /// which is itself the signal that a window will never match on name.
  citySlug        String?
  latitude        Float?
  longitude       Float?
  radiusMeters    Int?
  startsAt        DateTime
  endsAt          DateTime
  /// How far the TOO_HIGH edge lifts, e.g. 0.2500 for 25%.
  upliftPct       Decimal          @db.Decimal(5, 4)
  /// The kill switch. A scraper that invents an event has to be stoppable
  /// without a deploy.
  isEnabled       Boolean          @default(true)
  disabledById    String?
  disabledAt      DateTime?
  disabledNote    String?
  /// National events are surfaced to advertisers; city ones are not.
  isPublic        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([source, externalRef])
  @@index([isEnabled, startsAt, endsAt])
  @@index([city, startsAt])
}

/// Engine tuning, one row. Values live here rather than in code because every
/// one of them is a number research will want to move without a deploy.
model PricingSettings {
  id                      String   @id @default("default")
  /// Lot E (Q125): a binding factor may move a rate at most this much; above
  /// it the apply is refused and a price case is raised instead.
  maxBindingChangePct     Decimal  @default(0.25) @db.Decimal(5, 4)
  /// Comparable radius. Deliberately does not widen when the circle is empty.
  radiusMeters            Int      @default(200)
  /// Fraction of the top of the range at which a price reads as too high.
  highEdgePct             Decimal  @default(0.05) @db.Decimal(5, 4)
  /// Fraction above the bottom at which a price reads as on the cheap side.
  lowEdgePct              Decimal  @default(0.05) @db.Decimal(5, 4)
  /// At or below this many contributors the indicator still shows, but says
  /// what it is standing on. Governs a sentence, nothing else.
  thinEvidenceCount       Int      @default(3)
  /// Distinct ADX contributors with a sale before research is dropped entirely.
  /// Governs which data decides the price. Starts equal to thinEvidenceCount
  /// but is a different question, and sharing one column meant that raising the
  /// caveat threshold silently postponed the research-to-ADX handover.
  validatedTakeoverCount  Int      @default(3)
  /// Below this, no indicator at all.
  minContributors         Int      @default(1)
  /// A data point older than this is labelled stale and its owner nudged. It
  /// still counts — stale evidence beats none in a 200 m circle.
  stalenessMonths         Int      @default(6)
  /// Similarity at or above which a proposed media type matches an existing
  /// one. Biased low on purpose: fragmentation is the worse failure.
  mediaTypeMatchThreshold Decimal  @default(0.75) @db.Decimal(5, 4)
  /// Ceiling on the compounded product of applied multipliers. A listing that
  /// hits it is flagged, not silently clamped.
  maxCompoundMultiplier   Decimal  @default(3.0) @db.Decimal(6, 4)
  /// How far a measurement may sit from an existing size class and still be
  /// filed as that class, as a fraction of each dimension.
  ///
  /// The industry builds to standard sizes, so a 20 x 10.5 is a 20 x 10 that
  /// somebody measured with a tape rather than read off a drawing. Without a
  /// tolerance every such measurement mints its own class, and a class is a
  /// pool — two spots a metre apart, identical to any buyer, would never be
  /// compared. Three per cent is tight enough that a genuine 20 x 12 stays its
  /// own size.
  sizeTolerancePct        Decimal  @default(0.03) @db.Decimal(5, 4)
  updatedAt               DateTime @updatedAt
  updatedById             String?
}

/// A city, with the other spellings that mean the same place.
///
/// Exists because surge matching compared free text and "Bengaluru" never
/// equalled "Bangalore". That was survivable while a miss only failed to render
/// a sentence; it stopped being survivable once the same comparison decided
/// whether a listing's rate is excluded from every neighbour's comparable pool.
///
/// Deliberately small and owned by pricing for now — it is the only consumer.
/// Listings, orders and publishers all still carry free-text city names, and
/// pointing them here is a larger migration than this one.
model City {
  id       String   @id @default(cuid())
  /// Canonical key. Lowercase, hyphenated: "bengaluru".
  slug     String   @unique
  /// How it is written on screen: "Bengaluru".
  name     String
  state    String?
  /// Every other spelling that resolves here, already normalised.
  /// e.g. ["bangalore", "bengaluru-urban"]
  aliases  String[]
  /// Kept as a mirror of `stage` (SEEDING, LAUNCHED and PAUSED resolve; PLANNED
  /// and WITHDRAWN do not) so every reader of the old flag keeps working.
  isActive Boolean  @default(true)

  /// Lot V (owner, 15 Sep 2026): every town of India, not forty-four cities.
  /// The catalogue is GeoNames' populated places of 5,000 people or more under
  /// their district and state; `stage` and the six switches are how ops choose
  /// where ADX goes in, gathers listings, launches, pauses or pulls out.
  stateId         String?
  districtId      String?
  latitude        Float?
  longitude       Float?
  population      Int?
  /// NATIONAL_CAPITAL | STATE_CAPITAL | DISTRICT_HQ | SUBDISTRICT_HQ | TOWN
  kind            String?
  geonameId       Int?      @unique
  /// SEED (the original forty-six), GEONAMES, MANUAL
  source          String    @default("SEED")
  stage           CityStage @default(PLANNED)
  supplyIntake    Boolean   @default(false)
  publishing      Boolean   @default(false)
  demand          Boolean   @default(false)
  agentOnboarding Boolean   @default(false)
  printPartners   Boolean   @default(false)
  leadFeeds       Boolean   @default(false)
  launchedAt      DateTime?
  pausedAt        DateTime?
  withdrawnAt     DateTime?
  rolloutNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCards     RateCard[]
  /// `state` above is the free-text state name the seed carried; the catalogue relation is `geoState`.
  geoState      GeoState?          @relation(fields: [stateId], references: [id])
  geoDistrict   GeoDistrict?       @relation(fields: [districtId], references: [id])
  rolloutEvents CityRolloutEvent[]

  publishers       Publisher[]    @relation("PublisherCity")
  advertisers      Advertiser[]   @relation("AdvertiserCity")
  agents           AgentProfile[] @relation("AgentCity")
  printPartnerRows PrintPartner[] @relation("PrintPartnerCity")
  listings         Listing[]      @relation("ListingCity")
  leads            Lead[]         @relation("LeadCity")
  fieldVisits      FieldVisit[]   @relation("FieldVisitCity")
  campaigns        Campaign[]     @relation("CampaignTargetCity")

  @@index([isActive])
  @@index([stage])
  @@index([stateId, stage])
  @@index([districtId])
}

/// Lot V: where a city stands with ADX.
enum CityStage {
  /// In the catalogue, nothing switched on.
  PLANNED
  /// Gathering supply: listings can be created, imported and verified; nothing sells.
  SEEDING
  /// Open for business.
  LAUNCHED
  /// Nothing new; what runs, runs.
  PAUSED
  /// Pulled out: the wind-down job unpublished the listings.
  WITHDRAWN
}

model GeoState {
  id        String @id @default(cuid())
  /// GeoNames admin1 code, e.g. "19" for Karnataka.
  code      String @unique
  name      String
  latitude  Float?
  longitude Float?
  geonameId Int?   @unique

  districts GeoDistrict[]
  cities    City[]
}

model GeoDistrict {
  id        String @id @default(cuid())
  stateId   String
  /// GeoNames admin2 code, unique within the state.
  code      String
  name      String
  latitude  Float?
  longitude Float?
  geonameId Int?   @unique

  state  GeoState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  cities City[]

  @@unique([stateId, code])
  @@index([stateId, name])
}

/// Lot V: every change of a city's stage or switches, by whom and why.
model CityRolloutEvent {
  id        String    @id @default(cuid())
  cityId    String
  fromStage CityStage
  toStage   CityStage
  flags     Json
  byUserId  String
  note      String?
  at        DateTime  @default(now())

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId, at])
}

// ─── Revenue: commission, fees, tax ──────────────────────────────────────────
//
// The pricing engine decides what a publisher lists at. This decides what
// happens to that number afterwards. See docs/revenue-model.md.
//
// The load-bearing fact: COMMISSION COMES OUT OF THE PUBLISHER'S EARNINGS and is
// never added to the advertiser's price. The advertiser sees the publisher's own
// rate; ADX's take is invisible to them, and ADX shares in any surge the
// publisher captures without a separate split.

enum FeeKind {
  /// Percentage of media value. The one fee that scales.
  PLATFORM
  INSTALLATION
  PRINTING
  /// The one fee shown with its amount in the cart: an advertiser choosing
  /// whether ADX makes their creative decides that before checkout.
  DESIGN
}

enum SubscriptionTierName {
  STANDARD
  PLUS
  PRO
}

/// Commission ADX takes, by media category.
///
/// A null category is the platform default, and exactly one such row may be
/// active — enforced by a partial unique index, since a default that is
/// ambiguous is worse than one that is wrong.
model CommissionRate {
  id            String           @id @default(cuid())
  /// Null for the platform default.
  category      ListingCategory?
  /// Lot B (Q10/Q38): the pricing engine's own "ad type". A row keyed by media
  /// type beats one keyed by category; a row with a rental slab beats one
  /// without. Most specific wins, under any override or subscription.
  mediaTypeId   String?
  /// Rental slab on the per-day media value the advertiser is billed for
  /// (after any rate discount, before campaign discount and fees). Null bound
  /// means open-ended. A ₹1,500/month spot and a ₹10 lakh/month spot can carry
  /// different takes without a second table.
  minMediaValue Decimal?         @db.Decimal(14, 2)
  maxMediaValue Decimal?         @db.Decimal(14, 2)
  /// 0.1500 is fifteen percent of what the publisher earns.
  ratePct       Decimal          @db.Decimal(5, 4)
  note          String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  updatedById   String?

  mediaType MediaType? @relation(fields: [mediaTypeId], references: [id])

  @@index([isActive, category])
  @@index([isActive, mediaTypeId])
}

/// A subscription a publisher buys to reduce their commission.
model PublisherSubscription {
  id            String               @id @default(cuid())
  publisherId   String
  tier          SubscriptionTierName
  /// The commission rate this tier grants, stored rather than looked up: a tier
  /// whose price changes must not silently re-rate subscriptions already sold.
  ratePct       Decimal              @db.Decimal(5, 4)
  pricePerMonth Decimal              @db.Decimal(14, 2)
  startsAt      DateTime
  /// Null while it runs. Set when it lapses or is cancelled.
  endsAt        DateTime?
  /// Lot J: granted from the console, or bought on the phone (then `order` names the purchase).
  source        SubscriptionSource   @default(ADMIN_GRANT)
  /// Lot J2: the subscriber asked for the next term to be bought from their
  /// wallet when this one ends. Honoured only while the audience's policy allows it.
  autoRenew     Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  publisher Publisher                   @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  order     PublisherSubscriptionOrder?

  @@index([publisherId, startsAt])
  @@index([endsAt])
}

enum SubscriptionSource {
  ADMIN_GRANT
  SELF_SERVICE
}

/// Lot J (owner, 14 Sep 2026): the publisher plan catalogue — what a tier
/// costs, the commission it grants, and what it promises. Seeded on first
/// read with the defaults; edited on the console's Subscription plans desk.
/// A subscription keeps its own copy of the price and the rate, so an edit
/// here only ever changes the next purchase.
model PublisherSubscriptionPlan {
  id            String               @id @default(cuid())
  tier          SubscriptionTierName @unique
  name          String
  pricePerMonth Decimal              @db.Decimal(14, 2)
  /// The commission rate the tier grants, copied onto every subscription sold.
  ratePct       Decimal              @db.Decimal(5, 4)
  description   String?
  /// Drawn as the POPULAR flag on the middle card.
  isPopular     Boolean              @default(false)
  /// What the plan promises, named so a screen can list it. `liveChat` is
  /// read by support's live-chat entitlement; the rest is copy, as on the
  /// advertiser catalogue.
  entitlements  Json                 @default("{}")
  isActive      Boolean              @default(true)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive, sortOrder])
}

enum PublisherSubscriptionOrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  /// Never paid inside its window; the sweep closes it.
  EXPIRED
}

/// Lot J: a publisher buying a plan on the phone. Snapshotted like a package
/// sale — the tier, name, price and rate are copies made at the order — and
/// on payment it becomes the PublisherSubscription it names.
model PublisherSubscriptionOrder {
  id              String                           @id @default(cuid())
  /// SUB-2026-000123
  reference       String                           @unique
  publisherId     String
  createdByUserId String
  tier            SubscriptionTierName
  planName        String
  pricePerMonth   Decimal                          @db.Decimal(14, 2)
  ratePct         Decimal                          @db.Decimal(5, 4)
  cycle           PackageBillingCycle              @default(MONTHLY)
  /// Months billed at once — 1 monthly, 12 annually.
  months          Int                              @default(1)
  subtotal        Decimal                          @default(0) @db.Decimal(14, 2)
  discountPct     Decimal                          @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal                          @default(0) @db.Decimal(14, 2)
  gstPct          Decimal                          @default(18) @db.Decimal(5, 2)
  gstAmount       Decimal                          @default(0) @db.Decimal(14, 2)
  total           Decimal                          @default(0) @db.Decimal(14, 2)
  status          PublisherSubscriptionOrderStatus @default(PENDING_PAYMENT)
  /// When the term starts: now for a first or changed tier, the running
  /// term's end for a renewal of the same tier. Set at payment.
  startsAt        DateTime?
  paidAt          DateTime?
  paidMethod      String?
  paidReference   String?
  cancelledAt     DateTime?
  subscriptionId  String?                          @unique
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt

  publisher    Publisher              @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  subscription PublisherSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([publisherId, createdAt])
  @@index([status, createdAt])
}

/// A promotional commission rate for one publisher, approved by a person.
///
/// Beats a subscription because it is the more specific instrument: it exists
/// to win a particular publisher, and losing that fight to a tier they also
/// happen to hold would defeat the point.
model PublisherCommissionOverride {
  id           String    @id @default(cuid())
  publisherId  String
  ratePct      Decimal   @db.Decimal(5, 4)
  /// Why ADX gave this up. Required — an unexplained discount on our own take
  /// is the thing finance will ask about first.
  reason       String
  approvedById String
  startsAt     DateTime
  endsAt       DateTime?
  createdAt    DateTime  @default(now())

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@index([publisherId, startsAt])
}

/// A charge the advertiser pays on top of the publisher's rate.
model FeeSchedule {
  id                String   @id @default(cuid())
  kind              FeeKind
  name              String
  /// Set for PLATFORM. A fraction of media value: 0.0050 is half a percent.
  percentPct        Decimal? @db.Decimal(5, 4)
  /// Set for the flat fees, in rupees.
  flatAmount        Decimal? @db.Decimal(14, 2)
  /// GST on this line specifically. Lines can differ, so tax is per line rather
  /// than one rate applied to a total.
  gstPct            Decimal  @default(0.18) @db.Decimal(5, 4)
  /// Lot B: the SAC printed on the invoice line for this fee.
  sacCode           String?
  /// Whether the cart shows this fee's *amount*. Every mandatory fee is named
  /// in the cart regardless; this decides whether the number appears with it.
  amountShownInCart Boolean  @default(false)
  /// Charged once per spot, rather than once per booking.
  perSpot           Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedById       String?

  @@index([isActive, kind])
}

/// Tax on the media itself, separate from the per-fee rates above.
/// Lot B (Q13/Q34): ADX as the supplier on every tax invoice. One row. While
/// `gstin` is empty every invoice is a PROFORMA and no tax number is consumed.
model LegalEntitySettings {
  id                      String   @id @default("default")
  legalName               String?
  tradeName               String?
  gstin                   String?
  pan                     String?
  tan                     String?
  cin                     String?
  registeredAddress       String?
  city                    String?
  /// Two-digit GST state code ("29" Karnataka). Decides CGST+SGST vs IGST
  /// against the recipient's state.
  stateCode               String?
  stateName               String?
  invoicePrefix           String   @default("INV")
  financialYearStartMonth Int      @default(4)
  updatedById             String?
  updatedAt               DateTime @updatedAt
}

enum InvoiceKind {
  TAX_INVOICE
  PROFORMA
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum InvoiceLineKind {
  MEDIA
  PLATFORM
  INSTALLATION
  PRINTING
  DESIGN
  DISCOUNT
  PACKAGE
  OTHER
}

/// Lot B (Q13): one document per sale from one series, whatever collected the
/// money — a gateway payment id or a bank UTR hangs off it, it never hangs off
/// them. GST split by the supplier's and the recipient's state; rupee rounding
/// carried as `roundOff` so the lines and the total reconcile to the paisa.
model Invoice {
  id                  String        @id @default(cuid())
  /// Consecutive within the series for the financial year — INV/2026-27/000018.
  number              String        @unique
  kind                InvoiceKind
  status              InvoiceStatus @default(DRAFT)
  advertiserId        String
  campaignId          String?
  packageSaleId       String?
  /// The gateway payment (Lot C) or the recorded top-up that paid it.
  paymentId           String?
  topUpId             String?
  /// A credit note points at the invoice it reverses.
  voidsInvoiceId      String?
  issuedAt            DateTime?
  dueAt               DateTime?
  supplierName        String?
  supplierGstin       String?
  supplierStateCode   String?
  recipientName       String
  recipientGstin      String?
  recipientStateCode  String?
  recipientAddress    String?
  placeOfSupply       String?
  taxableValue        Decimal       @db.Decimal(14, 2)
  cgst                Decimal       @default(0) @db.Decimal(14, 2)
  sgst                Decimal       @default(0) @db.Decimal(14, 2)
  igst                Decimal       @default(0) @db.Decimal(14, 2)
  roundOff            Decimal       @default(0) @db.Decimal(14, 2)
  total               Decimal       @db.Decimal(14, 2)
  currency            String        @default("INR")
  pdfFileId           String?
  ledgerTransactionId String?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  lines InvoiceLine[]

  @@index([advertiserId, issuedAt])
  @@index([campaignId])
  @@index([packageSaleId])
  @@index([status, issuedAt])
}

model InvoiceLine {
  id             String          @id @default(cuid())
  invoiceId      String
  kind           InvoiceLineKind
  description    String
  /// Services Accounting Code printed on the line.
  sacCode        String?
  quantity       Decimal         @default(1) @db.Decimal(14, 4)
  unitRate       Decimal         @db.Decimal(14, 2)
  taxableValue   Decimal         @db.Decimal(14, 2)
  gstPct         Decimal         @db.Decimal(5, 4)
  gstAmount      Decimal         @db.Decimal(14, 2)
  campaignSpotId String?
  sortOrder      Int             @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
}

/// Consecutive numbering per series — the GST rule an invoice number must obey.
model InvoiceSequence {
  series String @id
  next   Int    @default(1)
}

enum PublisherInvoiceStatus {
  UPLOADED
  MATCHED
  REJECTED
}

/// Lot B (Q13): a GST-registered publisher's own invoice to ADX for a month, so
/// ADX can claim the input credit. Beside it ADX generates a payment advice.
model PublisherInvoice {
  id           String                 @id @default(cuid())
  publisherId  String
  /// "2026-09"
  period       String
  fileId       String?
  fileUrl      String?
  gstin        String?
  amount       Decimal                @db.Decimal(14, 2)
  status       PublisherInvoiceStatus @default(UPLOADED)
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime               @default(now())

  @@unique([publisherId, period])
  @@index([status, createdAt])
}

model TaxSettings {
  id           String   @id @default("default")
  /// GST on advertising services. 18% at the time of writing.
  mediaGstPct  Decimal  @default(0.18) @db.Decimal(5, 4)
  /// Lot B: the SAC printed on media lines.
  mediaSacCode String?
  updatedAt    DateTime @updatedAt
  updatedById  String?
}

/// A held rate, so a price cannot move while someone is deciding.
///
/// Holds the *price* and not the inventory: a lock that reserved the site would
/// let anyone empty the marketplace by filling a cart and walking away.
model PriceLock {
  id           String    @id @default(cuid())
  advertiserId String
  listingId    String
  /// The rate as it stood when the lock was taken.
  ratePerDay   Decimal   @db.Decimal(14, 2)
  expiresAt    DateTime
  /// True once the lock was used to price a booking.
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  listing    Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// One live lock per advertiser per listing; re-locking refreshes it.
  @@unique([advertiserId, listingId])
  @@index([expiresAt])
}

/// Where the event scraper looks, and how it reads what it finds.
///
/// The scraper itself stays headless — nobody wants a cron job with a settings
/// screen. What ops needs is the part that changes: which sites are watched,
/// how often, how a page maps onto a surge window, and the ability to stop one
/// without a deploy. A source that starts inventing events is a data problem,
/// and a data problem you cannot switch off is an outage.
model ScraperSource {
  id                String            @id @default(cuid())
  name              String
  /// Where to fetch. A page to scrape, a feed, or an API endpoint.
  url               String
  kind              ScraperSourceKind @default(HTML)
  /// Which cities this source is expected to cover, as canonical City slugs.
  /// Empty means national.
  citySlugs         String[]
  /// How a fetched record becomes a surge window: which field carries the
  /// event name, the dates, the venue. Shape depends on `kind`, so it is JSON
  /// rather than columns — an HTML source needs selectors where a JSON feed
  /// needs paths, and modelling both as columns would leave half of them null.
  fieldMap          Json?
  /// Uplift applied to windows from this source when a record carries none of
  /// its own. Research sets the real figures; this is the floor.
  defaultUpliftPct  Decimal           @default(0.10) @db.Decimal(5, 4)
  /// Minutes between runs.
  intervalMinutes   Int               @default(360)
  /// Windows from a source below this confidence are created disabled, so a
  /// shaky source proposes rather than acts.
  autoEnableWindows Boolean           @default(false)
  isEnabled         Boolean           @default(true)
  disabledById      String?
  disabledAt        DateTime?
  disabledNote      String?

  /// Filled in by the scraper so ops can see whether a source still works.
  lastRunAt      DateTime?
  lastRunStatus  ScraperRunStatus?
  lastRunMessage String?
  lastRunFound   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs ScraperRun[]

  @@index([isEnabled, lastRunAt])
}

enum ScraperSourceKind {
  /// A page whose markup is read with selectors.
  HTML
  /// RSS or Atom.
  FEED
  /// A JSON API.
  JSON
  /// Rows handed over by the research team rather than fetched.
  MANUAL
}

enum ScraperRunStatus {
  OK
  /// Fetched, but nothing matched the field map. Usually a site redesign.
  NO_MATCHES
  FETCH_FAILED
  PARSE_FAILED
}

/// One execution of a source. Kept so a source that quietly stopped working is
/// visible as a run history rather than as an absence of surge windows.
model ScraperRun {
  id              String           @id @default(cuid())
  sourceId        String
  status          ScraperRunStatus
  message         String?
  /// Records the fetch returned.
  found           Int              @default(0)
  /// Surge windows created or updated from them.
  windowsUpserted Int              @default(0)
  startedAt       DateTime         @default(now())
  finishedAt      DateTime?

  source ScraperSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
}

/// Which size classes a media type actually comes in.
///
/// A unipole hoarding is built in a handful of standard sizes; a bus back panel
/// in different ones entirely. Without this the listing form offers every size
/// for every type, and a spot recorded as a 3x2 gantry is a comparable pool of
/// one that nobody will ever match.
///
/// It constrains what can be recorded; it does not change the match key, which
/// is still media type and size class exactly.
model MediaTypeSizeClass {
  mediaTypeId String
  sizeClassId String

  mediaType MediaType @relation(fields: [mediaTypeId], references: [id], onDelete: Cascade)
  sizeClass SizeClass @relation(fields: [sizeClassId], references: [id], onDelete: Cascade)

  @@id([mediaTypeId, sizeClassId])
  @@index([sizeClassId])
}

/// Which materials a media type is built from. Same reasoning as sizes, except
/// material is not in the match key at all — it feeds media-type similarity and
/// tells the listing form what to offer.
model MediaTypeMaterial {
  mediaTypeId String
  materialId  String

  mediaType MediaType @relation(fields: [mediaTypeId], references: [id], onDelete: Cascade)
  material  Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([mediaTypeId, materialId])
  @@index([materialId])
}

// ─── Listing flow: venue, content rules, availability ────────────────────────
//
// From DR 02. Three things here change the pricing engine rather than sitting
// beside it, and they are worth naming together:
//
//   1. The taxonomy is three levels, not two. Category -> Venue -> Spot type.
//      A mirror decal in a gym and one in a hospital are different markets, so
//      venue joins the comparable match key.
//   2. Size is measured, not picked. The wizard takes width and height; the
//      size class is derived from them the same way a media type is derived
//      from a name, so exact-size matching survives without a publisher ever
//      choosing from a list.
//   3. The publisher's pricing unit is their own. Per sq ft per month, per day,
//      whatever suits the medium. `ratePerDay` stays the canonical figure and
//      is computed from it.

/// Where an indoor or transit spot lives: a gym, a mall, a metro station.
///
/// Part of the comparable match key. Splitting on it costs pool density — an
/// already thin 200 m circle divides again — but a gym mirror decal genuinely
/// does not price like a hospital one, and a pool that mixes them answers the
/// wrong question confidently.
model VenueType {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  category    ListingCategory
  description String?
  /// The named areas inside this venue - a mall's atrium, food court, lift
  /// lobbies. DR 02 asks a publisher for a "placement area" in step 4, and this
  /// is the list that question offers. An array rather than a table because
  /// nothing points at a sub-venue: it is a label on a listing, not an entity
  /// with a price, a status or a history of its own.
  subVenues   String[]        @default([])
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  mediaTypes MediaType[]
  listings   Listing[]

  @@index([category, isActive])
}

/// How a publisher states their price.
///
/// The unit they think in, not the one ADX stores. A billboard owner quotes a
/// day rate; a mall quotes per square foot per month. Forcing either into the
/// other at data entry is how a rate gets mistyped by a factor of thirty.
enum PricingUnit {
  PER_DAY
  PER_WEEK
  PER_MONTH
  PER_SQFT_PER_DAY
  PER_SQFT_PER_MONTH
}

/// What a listing will and will not carry.
///
/// One mechanism rather than two, though DR 02 draws them as dropdowns and
/// checkboxes: "no alcohol" and "adult content is never allowed here" are the
/// same statement at different strengths, and modelling them separately would
/// mean asking twice whether a category is permitted.
enum ContentStance {
  ALLOWED
  /// "Yes, with approval token" — the owner sees it before it runs.
  REQUIRES_APPROVAL
  NOT_ALLOWED
  /// Never, on this venue. What DR 02 draws as Prohibited Content.
  PROHIBITED
}

/// A category a listing can take a position on.
///
/// Seeded and ops-extendable. Distinct from `BrandSector`, which describes what
/// an advertiser *is*; this is what a publisher will accept.
model ContentCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  /// Drawn as a checkbox rather than a dropdown, and prohibited by default.
  isSensitive Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  listingRules ListingContentRule[]

  @@index([isActive])
}

model ListingContentRule {
  listingId         String
  contentCategoryId String
  stance            ContentStance

  listing  Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category ContentCategory @relation(fields: [contentCategoryId], references: [id], onDelete: Cascade)

  @@id([listingId, contentCategoryId])
  @@index([contentCategoryId])
}

// ─── AI assistance ────────────────────────────────────────────────────────────

enum AiGenerationKind {
  LISTING_DESCRIPTION
  /// Lot E: a campaign's ADX landing page drafted from the brief.
  LANDING_PAGE
}

/// One AI draft, and the reason the quota exists.
///
/// Every generation is a row rather than a counter, so "how many has this
/// publisher had" and "what did the model actually say" are the same question.
/// A counter would answer the first and lose the second, and the second is what
/// gets looked at when a description reads oddly.
model AiGeneration {
  id           String           @id @default(cuid())
  /// One of the two is set: the publisher whose listing description this is, or
  /// the advertiser whose landing page it is (Lot E).
  publisherId  String?
  advertiserId String?
  /// What the quota is counted against: the listing once it exists, and the
  /// wizard's own draft key before it does — a description is regenerated while
  /// it is still being written, which is before there is anything to point at.
  subjectKey   String
  kind         AiGenerationKind @default(LISTING_DESCRIPTION)
  /// Kept for cost attribution and for explaining a bad draft later.
  provider     String
  model        String
  output       String
  createdAt    DateTime         @default(now())

  publisher  Publisher?  @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  advertiser Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  /// The quota query: every generation for one description or one page.
  @@index([publisherId, subjectKey])
  @@index([advertiserId, subjectKey])
  @@index([createdAt])
}

/// A translated string, cached by the hash of what it was translated from.
///
/// Keyed by content rather than by listing, so the same sentence written on
/// forty listings is paid for once — and a listing edited back to its previous
/// wording costs nothing at all. The source language is stored as the provider
/// reported it rather than guessed at read time.
model Translation {
  id         String   @id @default(cuid())
  /// SHA-256 of the source text. The text itself is not stored twice.
  sourceHash String
  targetLang String
  sourceLang String?
  text       String
  provider   String
  createdAt  DateTime @default(now())

  @@unique([sourceHash, targetLang])
  @@index([createdAt])
}

// ─── Rate cards ───────────────────────────────────────────────────────────────

/// Where a rate card is in its life. A card is a governance artifact, not a
/// draft document: what it says decides whether a listing may be published, so
/// it is approved by a person before it can decide anything.
enum RateCardStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  /// Replaced by a newer version. Kept, because a listing published against it
  /// was published against these numbers and that has to stay answerable.
  SUPERSEDED
  ARCHIVED
}

/// Locality grade. The old pricing model's Premium / A / B / C, which is a
/// judgement about the pitch rather than anything measurable off the listing.
enum RateGrade {
  PREMIUM
  A
  B
  C
}

/// ADX's own position on what a kind of spot is worth, approved by a person.
///
/// Not a comparable and not in the same business. `MarketDataPoint` and the
/// listings around a spot say what the market is doing; this says what ADX has
/// agreed is sellable, and it is the thing DR 10 gates publishing on. The two
/// meet in exactly one place — the simulator, which can trace a quote from
/// either base through the same factors.
model RateCard {
  id             String         @id @default(cuid())
  name           String
  /// Bumped on every republish. A card is never edited in place once ACTIVE;
  /// approving a new version supersedes the old one.
  version        Int            @default(1)
  status         RateCardStatus @default(DRAFT)
  /// Null means every city. A card scoped to a city beats the national one.
  cityId         String?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  /// The share of the card rate below which a listing needs a person to sign it
  /// off. DR 10 draws 82%.
  floorPct       Decimal        @default(0.82) @db.Decimal(5, 4)
  /// Lot E (Q97): days a listing left under a revised floor has before a
  /// rejected case unpublishes it — never while it has a running order.
  graceDays      Int            @default(14)
  /// Quotes are rounded to this many rupees after factors are applied.
  roundingRupees Int            @default(100)
  notes          String?

  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  /// The version this one replaced, so a chain can be walked backwards.
  supersedesId  String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city         City?           @relation(fields: [cityId], references: [id])
  supersedes   RateCard?       @relation("RateCardChain", fields: [supersedesId], references: [id])
  supersededBy RateCard?       @relation("RateCardChain")
  entries      RateCardEntry[]
  approvals    PriceApproval[]

  quoteLines QuoteLine[]

  @@index([status, effectiveFrom])
  @@index([cityId, status])
}

/// One cell of the grid: what a media type at a grade costs per day.
///
/// Per day, not per week. The platform settled on a daily rate everywhere else
/// — `Listing.ratePerDay`, the comparables range, the indicator — and a second
/// unit here is how a card rate and a listing rate get compared wrongly.
model RateCardEntry {
  id          String    @id @default(cuid())
  rateCardId  String
  mediaTypeId String
  grade       RateGrade
  /// Null means this combination is not sold, which is different from free.
  ratePerDay  Decimal?  @db.Decimal(14, 2)

  rateCard  RateCard  @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  mediaType MediaType @relation(fields: [mediaTypeId], references: [id], onDelete: Cascade)

  @@unique([rateCardId, mediaTypeId, grade])
  @@index([mediaTypeId])
}

enum PriceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A listing priced below the card floor, and the person who decided about it.
///
/// The answer to "no role can approve a price". Publishing is gated on the card
/// when one covers the listing; this is the way through that gate, and it is a
/// person's decision with their name on it rather than a setting somebody flips.
enum PriceApprovalSource {
  PUBLISH_REQUEST
  CARD_REVISION
}

model PriceApproval {
  id                  String              @id @default(cuid())
  listingId           String
  rateCardId          String?
  status              PriceApprovalStatus @default(PENDING)
  /// Lot E (Q67/Q97): raised by a publisher publishing under the floor, or by
  /// a revised card whose floor rose above an ACTIVE listing.
  source              PriceApprovalSource @default(PUBLISH_REQUEST)
  graceUntil          DateTime?
  /// Lot E (Q97): a rejected CARD_REVISION case cannot unpublish a listing with a
  /// running order — the case stays PENDING with this flag until ops decide again.
  heldByRunningOrder  Boolean             @default(false)
  /// What the publisher wants to charge, and what the card says, both frozen at
  /// request time — the card can be superseded while this sits in a queue.
  requestedRatePerDay Decimal             @db.Decimal(14, 2)
  cardRatePerDay      Decimal?            @db.Decimal(14, 2)
  floorRatePerDay     Decimal?            @db.Decimal(14, 2)
  reason              String?
  requestedById       String
  decidedById         String?
  decidedAt           DateTime?
  decisionNote        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  rateCard RateCard? @relation(fields: [rateCardId], references: [id])

  @@index([status, createdAt])
  @@index([listingId])
}

// ─── The manual pricing model ─────────────────────────────────────────────────
//
// Levers ops set by hand, as against the comparables engine which computes from
// the market. These were hardcoded in the console for months — size bands,
// illumination multipliers, category rules, a rule builder — and looked exactly
// like configuration while being nothing of the kind.

/// A property of a spot that has exactly one value, and a multiplier per value.
///
/// Distinct from `PricingFactor`, which is per media type and applies
/// independently: a hoarding may carry a corner-site factor and a heritage-zone
/// factor at once, but it is either back-lit or front-lit and never both. That
/// exclusivity is the whole reason this is its own table — a quote picks one
/// value per dimension, and a grid that let two apply would silently double.
model PriceDimension {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  /// Ordering on screen and in a quote trace, so a trace reads the same twice.
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values PriceDimensionValue[]

  @@index([isActive, sortOrder])
}

/// One option within a dimension, and what it does to a price.
model PriceDimensionValue {
  id          String   @id @default(cuid())
  dimensionId String
  label       String
  /// 1.0000 is "no effect", which is a real answer worth storing rather than
  /// leaving as an absent row.
  multiplier  Decimal  @db.Decimal(6, 4)
  /// Size bands are chosen by area rather than by hand, so they carry the range
  /// they cover. Null on every other kind of dimension.
  minAreaSqFt Decimal? @db.Decimal(12, 2)
  maxAreaSqFt Decimal? @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  dimension PriceDimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  @@unique([dimensionId, label])
  @@index([dimensionId, sortOrder])
}

/// What a category rule does when it matches.
enum CategoryRuleEffect {
  MULTIPLIER
  /// This sector may not book this media type at all.
  BLOCKED
  /// Bookable, but a person signs it off first.
  LEGAL_APPROVAL
}

/// An advertiser sector against a kind of inventory.
///
/// Not `ContentCategory`, which is brand safety and asks what may be *shown*.
/// This asks what a sector *pays*, and whether it may book at all — alcohol on
/// a school-adjacent hoarding is a different question from alcohol in a
/// creative.
model PricingCategoryRule {
  id          String             @id @default(cuid())
  /// Free text rather than an enum: advertiser sectors are a taxonomy nobody
  /// has settled, and an enum would need a migration per addition.
  sector      String
  /// Null means the rule covers every media type.
  mediaTypeId String?
  effect      CategoryRuleEffect
  /// Set when effect is MULTIPLIER.
  multiplier  Decimal?           @db.Decimal(6, 4)
  note        String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  mediaType MediaType? @relation(fields: [mediaTypeId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([sector])
}

enum PriceRuleAdjustment {
  MULTIPLIER
  BASE_ADJUST
  /// Replaces the running figure outright. The frame calls it "Override rate".
  OVERRIDE
}

/// A conditional adjustment ops writes by hand.
///
/// The rule builder DR 10 draws. Priority is explicit rather than by creation
/// date because "which rule won" is the question somebody asks when a price
/// looks wrong, and an answer of "whichever was saved first" is not one.
model PriceRule {
  id          String              @id @default(cuid())
  name        String
  description String?
  /// Lower fires first. Ties break on id, so the order is total and stable.
  priority    Int                 @default(100)
  /// False: every clause must hold. True: any one clause is enough. The rule
  /// builder draws this as Match ALL / Match ANY.
  matchAny    Boolean             @default(false)
  adjustment  PriceRuleAdjustment
  /// A multiplier, or rupees per day, according to `adjustment`.
  value       Decimal             @db.Decimal(14, 4)
  /// Null on either side means open-ended.
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  conditions PriceRuleCondition[]

  @@index([isActive, priority])
}

/// One clause of a rule. Every clause must hold for the rule to fire.
model PriceRuleCondition {
  id       String @id @default(cuid())
  ruleId   String
  /// The fact being tested — city, mediaTypeId, sector, areaSqFt, days.
  field    String
  /// eq, ne, in, gt, gte, lt, lte.
  operator String
  /// Compared as a string, or parsed as a number for the ordering operators.
  value    String

  rule PriceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

// ─── Manual quotes ────────────────────────────────────────────────────────────

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  WITHDRAWN
}

/// A priced offer put in front of an advertiser, usually because they want to
/// negotiate or are buying several spots at once.
///
/// Stored rather than computed on demand, for the reason the pricing docs give
/// for everything else here: somebody argues about a price months later, and
/// "here is what we quoted and every step that produced it" has to still be
/// answerable after the card behind it has been superseded twice.
model Quote {
  id           String      @id @default(cuid())
  /// Human-readable, and what gets said on the phone. QT-2609-4F2A1C.
  reference    String      @unique
  status       QuoteStatus @default(DRAFT)
  /// Null for a prospect with no account yet, which is most of them.
  advertiserId String?
  /// The sector, which is what category rules are matched on.
  sector       String?
  notes        String?

  /// What was given away at the table, as a fraction. 0.1000 is ten per cent.
  discountPct    Decimal? @db.Decimal(5, 4)
  /// Every line daily rate summed, before the discount.
  subtotalPerDay Decimal  @db.Decimal(14, 2)
  /// After the discount.
  totalPerDay    Decimal  @db.Decimal(14, 2)
  /// Across the whole flight, which is what the advertiser actually pays.
  grandTotal     Decimal  @db.Decimal(14, 2)
  /// True when any line fell under its card floor. Recorded rather than
  /// recomputed, because the floor moves when a card is superseded.
  belowFloor     Boolean  @default(false)

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime?

  advertiser Advertiser? @relation(fields: [advertiserId], references: [id])
  lines      QuoteLine[]

  @@index([status, createdAt])
  @@index([advertiserId])
}

/// One spot on a quote, and the arithmetic that priced it.
model QuoteLine {
  id          String    @id @default(cuid())
  quoteId     String
  /// Set when quoting a real listing rather than a hypothetical spot.
  listingId   String?
  mediaTypeId String
  grade       RateGrade
  cityId      String?
  label       String?

  /// How many of this spot, and for how long.
  quantity Int @default(1)
  days     Int @default(1)

  /// The card that supplied the base, frozen with its rate.
  rateCardId     String?
  cardRatePerDay Decimal? @db.Decimal(14, 2)
  floorPerDay    Decimal? @db.Decimal(14, 2)

  ratePerDay Decimal @db.Decimal(14, 2)
  lineTotal  Decimal @db.Decimal(14, 2)

  /// Every step that produced ratePerDay, exactly as it was computed. The
  /// replayability the engine docs ask for: the card can be superseded and the
  /// dimensions retuned, and this still explains the number.
  trace Json

  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  mediaType MediaType @relation(fields: [mediaTypeId], references: [id])
  rateCard  RateCard? @relation(fields: [rateCardId], references: [id])

  @@index([quoteId])
  @@index([listingId])
}

/// The knobs on the General tab of the pricing model: rate basis, duration
/// discounts and guardrails. One row, because there is one platform.
///
/// Separate from `PricingSettings`, which tunes the comparables engine. These
/// are commercial dials on the manual model, and mixing the two would put "how
/// wide is the search radius" beside "how big a discount needs sign-off".
model PriceModelSettings {
  id                   String   @id @default("default")
  /// Quotes round to this many rupees after every multiplier.
  roundingRupees       Int      @default(100)
  /// No spot quotes below this a day, whatever the multipliers say.
  minimumRatePerDay    Decimal  @default(0) @db.Decimal(14, 2)
  /// Shortest sellable flight.
  minimumBookingDays   Int      @default(7)
  /// Whether the floor is enforced at all. Off means a card floor is advisory.
  floorProtection      Boolean  @default(true)
  /// Discount tiers by flight length: [{ "minDays": 14, "pct": 2 }, ...].
  /// JSON rather than a table because the tiers are edited as one ladder.
  durationDiscounts    Json     @default("[]")
  /// A negotiated discount at or above this needs a person.
  approvalThresholdPct Decimal  @default(10) @db.Decimal(5, 2)
  /// No quote may discount beyond this, approval or not.
  discountCeilingPct   Decimal  @default(15) @db.Decimal(5, 2)
  /// Ceiling on the compounded multipliers of the manual model.
  maxStackedUplift     Decimal  @default(2.2) @db.Decimal(6, 4)
  /// Refuse a quote under the floor rather than flag it.
  blockBelowFloor      Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  updatedById          String?
}

/// ══════════════════════════════════════════════════════════════════
/// Campaigns — DR 02's booking flow.
///
/// The seventeen screens of that flow are not a checkout; they are the
/// campaign brief, and the brief is worth keeping. Every answer lands in a
/// column here so a campaign can be re-opened, re-run, argued about and
/// reported on. A draft is saved from step one, because seventeen steps on a
/// phone will be abandoned halfway and resumed on a different day.
///
/// The seam to fulfilment is `CampaignSpot.orderId`: a spot becomes an Order
/// when the campaign launches, and DR 03's publisher-accept, print, agent and
/// installation chain runs unchanged from there. Campaigns decide what is
/// bought; orders remain how it gets installed.
/// ══════════════════════════════════════════════════════════════════

enum CampaignStatus {
  /// The wizard is open and nothing is committed.
  DRAFT
  /// Reviewed and awaiting authorization. Inventory is reserved, money is not.
  PENDING_PAYMENT
  /// Paid, holds placed, but the start date has not arrived.
  SCHEDULED
  LIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignGoal {
  BRAND_AWARENESS
  DIGITAL_LIFT
  LOCAL_FOOTFALL
}

enum BrandAwarenessLevel {
  BRAND_NEW
  ALREADY_ESTABLISHED
}

enum TargetingMethod {
  RADIUS
  MARKET_OR_DMA
  POI_VENUE
}

enum CampaignStrategy {
  DEFENSIVE
  GENERAL
  ATTACK
}

enum AudiencePersona {
  B2B_DECISION_MAKERS
  STUDENTS_OR_GEN_Z
  HIGH_INCOME_CONSUMERS
  FAMILIES_OR_SUBURBAN
}

enum CampaignTriggerType {
  NONE
  WEATHER
  TIME_OF_DAY
  EVENT
}

enum CreativePath {
  STATIC_IMAGES
  VIDEO_OR_MOTION
  DYNAMIC_HTML5
  ADX_DESIGN_AGENCY
}

enum TrackingMethod {
  QR_OR_DEEPLINK
  VANITY_OR_PROMO
  LOCATION_LIFT
  NONE
}

enum FulfilmentChoice {
  ADX_PRINTS
  ADVERTISER_SHIPS
}

enum CampaignSpotStatus {
  /// In the cart. Holds no inventory and expires with the draft.
  RESERVED
  /// Paid for, with an Order raised against it.
  BOOKED
  LIVE
  COMPLETED
  CANCELLED
}

enum CreativeStatus {
  PENDING_UPLOAD
  UPLOADED
  IN_REVIEW
  APPROVED
  REJECTED
  /// Lot D (Q44): ops asked for a change; the advertiser re-uploads.
  CHANGES_REQUESTED
  /// Lot D (Q44): ADX designed it; the advertiser must accept before ops review.
  AWAITING_ADVERTISER
}

enum TrackingEventType {
  /// A QR code or short link was opened.
  SCAN
  /// The redirect completed to the advertiser's destination.
  CLICK
  /// A promo code was redeemed, reported by the advertiser.
  REDEMPTION
  /// Lot D (Q7/Q139): interactions on the ADX landing page.
  VIEW
  CTA_CLICK
  FORM_SUBMIT
}

model Campaign {
  id                    String    @id @default(cuid())
  /// ADX-CMP-2026-482913. Issued at launch, printed on the Campaign Live screen.
  reference             String    @unique
  advertiserId          String
  brandId               String?
  /// The agent who ran the wizard for the advertiser. Null when self-serve, and
  /// the reason the same flow ships in both apps.
  agentId               String?
  createdByUserId       String
  /// Lot B (Q1): the field visit this campaign was launched on, and the
  /// CAMPAIGN_ASSIST incentive recorded at authorisation — one per campaign.
  visitId               String?
  assistIncentiveId     String?   @unique
  /// Lot C (Q47/Q88): ops prepared it and sent it to the advertiser to pay.
  submittedForPaymentAt DateTime?
  submittedByUserId     String?
  /// Lot D (Q8/Q107): every market the campaign targets. `targetMarket` below
  /// stays the first entry for existing readers.
  targetMarkets         String[]  @default([])
  /// Lot D (Q138): the content category the venue-stance check reads.
  contentCategoryId     String?

  name   String
  status CampaignStatus @default(DRAFT)
  /// Which of the seventeen steps this draft reached, so it reopens where it stopped.
  step   Int            @default(1)

  /// Step 1 — describe the brand
  brandName   String?
  productName String?
  industry    String?
  subCategory String?

  /// Steps 2 and 3
  goal      CampaignGoal?
  awareness BrandAwarenessLevel?

  /// Steps 4 and 5 — how the area is defined, then the area itself
  targetingMethod    TargetingMethod?
  targetLocation     String?
  targetLatitude     Float?
  targetLongitude    Float?
  targetRadiusKm     Int?
  /// The market or DMA, when targeting is by market rather than radius.
  targetMarket       String?
  /// Lot X: the catalogue city `targetMarket` resolved to.
  targetMarketCityId String?

  /// Steps 6 and 7
  strategy CampaignStrategy?
  persona  AudiencePersona?

  /// Step 8. The config shape follows the type — weather conditions and a
  /// response, dayparts and days, or an event with its dates. JSON rather than
  /// three tables because nothing dereferences it yet: no delivery engine reads
  /// these, they are the brief. Validated by zod on the way in.
  triggerType   CampaignTriggerType @default(NONE)
  triggerConfig Json?

  /// Step 9
  budget    Decimal?  @db.Decimal(14, 2)
  startDate DateTime?
  endDate   DateTime?

  /// Step 12 — creative path, and the answers its branch asked for.
  creativePath   CreativePath?
  creativeConfig Json?

  /// Step 13 — measurement.
  trackingMethod TrackingMethod @default(QR_OR_DEEPLINK)
  trackingConfig Json?

  /// Step 14
  fulfilment FulfilmentChoice?

  /// Steps 15 and 16 — the money, snapshotted at review so the total an
  /// advertiser authorised is the total that was shown, whatever moves later.
  spotsSubtotal Decimal? @db.Decimal(14, 2)
  feesTotal     Decimal? @db.Decimal(14, 2)
  discount      Decimal? @db.Decimal(14, 2)
  gstAmount     Decimal? @db.Decimal(14, 2)
  total         Decimal? @db.Decimal(14, 2)
  /// The wallet hold taken at authorization, captured at launch.
  walletHoldId  String?  @unique

  paidAt             DateTime?
  launchedAt         DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advertiser  Advertiser             @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  brand       Brand?                 @relation(fields: [brandId], references: [id])
  agent       AgentProfile?          @relation(fields: [agentId], references: [id])
  createdBy   User                   @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id])
  spots       CampaignSpot[]
  pois        CampaignPoi[]
  creatives   CampaignCreative[]
  codes       CampaignTrackingCode[]
  metrics     CampaignDailyMetric[]
  landingPage LandingPage?

  targetMarketCity City? @relation("CampaignTargetCity", fields: [targetMarketCityId], references: [id], onDelete: SetNull)

  @@index([advertiserId, status])
  @@index([agentId])
  @@index([status, startDate])
  @@index([targetMarketCityId])
}

/// A pin dropped on the POI-venue targeting screen.
model CampaignPoi {
  id         String  @id @default(cuid())
  campaignId String
  label      String
  address    String?
  latitude   Float?
  longitude  Float?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

/// One booked spot: a listing, for a flight, at a price agreed on the day.
///
/// The rate is snapshotted rather than read back off the listing, because a
/// publisher may reprice tomorrow and the advertiser paid today's number.
model CampaignSpot {
  id         String             @id @default(cuid())
  campaignId String
  listingId  String
  status     CampaignSpotStatus @default(RESERVED)

  /// Why the matcher offered it — 0 to 100. Kept so a booking can explain itself.
  matchScore Int?

  ratePerDay       Decimal   @db.Decimal(14, 2)
  days             Int
  quantity         Int       @default(1)
  /// Media value before fees and tax: rate x days x quantity.
  lineTotal        Decimal   @db.Decimal(14, 2)
  /// Lot C (Q88): a prepared campaign holds its spots for 24 hours; the clash
  /// check treats a live reservation as booked.
  reservedUntil    DateTime?
  /// Lot B (Q38): the commission rate resolved ONCE at authorisation and
  /// stamped here, so the accrual charges what was quoted and a later rate
  /// change never re-rates a running flight. `commissionSource` names which
  /// instrument won — OVERRIDE, SUBSCRIPTION, MEDIA_TYPE_SLAB, MEDIA_TYPE,
  /// CATEGORY, DEFAULT. Null on spots authorised before this landed; the
  /// accrual then resolves at accrual time and says so.
  commissionPct    Decimal?  @db.Decimal(5, 4)
  commissionSource String?

  startDate DateTime?
  endDate   DateTime?

  /// Raised at launch. Fulfilment — publisher accept, print, agent, install —
  /// runs against this, unchanged from DR 03.
  orderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign        Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  listing         Listing                @relation(fields: [listingId], references: [id])
  order           Order?                 @relation(fields: [orderId], references: [id])
  creatives       CampaignCreative[]
  codes           CampaignTrackingCode[]
  earningAccruals EarningAccrual[]

  @@unique([campaignId, listingId])
  @@index([campaignId, status])
  @@index([listingId])
}

/// Artwork for a campaign, or for one spot of it.
///
/// Per spot when the sizes differ, which they usually do; per campaign for a
/// design brief or a feed, which produce one thing for all of them. That is why
/// the Review screen can say "2 of 3 uploaded".
model CampaignCreative {
  id         String         @id @default(cuid())
  campaignId String
  spotId     String?
  path       CreativePath
  status     CreativeStatus @default(PENDING_UPLOAD)

  fileUrl  String?
  fileName String?
  fileSize Int?
  mimeType String?

  /// What the specs screen asked for, and what was measured on upload.
  widthPx    Int?
  heightPx   Int?
  durationMs Int?

  reviewNote             String?
  reviewedById           String?
  reviewedAt             DateTime?
  /// Lot D (Q44/Q120): the moderation record. Ops alone approve; flags are the
  /// reviewer's notes (VENUE_REQUIRES_APPROVAL, QR_MISSING …); checks are the
  /// computed ones (dimensions, venue stance); a re-upload after a refusal
  /// points at what it replaces; ADX-designed artwork waits for the advertiser.
  submittedAt            DateTime?
  flags                  String[]  @default([])
  checks                 Json?
  resubmissionOfId       String?
  designedByAdx          Boolean   @default(false)
  advertiserAcceptedAt   DateTime?
  advertiserAcceptedById String?
  /// Lot D (Q7): the tracking code this artwork embeds, so the desk can check it.
  trackingCodeId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  spot     CampaignSpot? @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([spotId])
  @@index([status, submittedAt])
}

/// Lot G (Q127): what escalated a KYC case.
enum KycEscalationSource {
  AGE
  FRAUD_LINK
  REVIEWER
}

enum FraudCaseStatus {
  OPEN
  INVESTIGATING
  /// Lot G (Q118): handed to legal / compliance with a note and an assignee.
  ESCALATED
  CONFIRMED
  DISMISSED
}

/// Lot D (Q54/Q92): fraud as its own case, not a flag on a dispute — the place
/// that records which sections were suspended, why, and on what evidence.
model FraudCase {
  id                String             @id @default(cuid())
  /// FRD-1209-2601
  displayId         String?            @unique
  subjectType       SuspendedPartyType
  subjectId         String
  kind              String
  status            FraudCaseStatus    @default(OPEN)
  summary           String
  openedByUserId    String
  assignedToUserId  String?
  disputeId         String?
  decision          String?
  decidedByUserId   String?
  decidedAt         DateTime?
  /// Lot E: the suspension scopes this case applied on CONFIRMED, so a later
  /// DISMISSED lifts exactly those.
  appliedScopes     SuspensionScope[]  @default([])
  /// Lot G (Q118/138): the explainable score 0–1 and the signals behind it —
  /// [{ key, weight, value, detail }] — recomputed on demand, never acted on alone.
  score             Decimal?           @db.Decimal(4, 3)
  signals           Json?
  scoredAt          DateTime?
  escalatedAt       DateTime?
  escalatedToUserId String?
  escalationNote    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  notes    FraudCaseNote[]
  evidence FraudCaseEvidence[]

  @@index([subjectType, subjectId])
  @@index([status, createdAt])
}

model FraudCaseNote {
  id        String   @id @default(cuid())
  caseId    String
  byUserId  String
  body      String
  createdAt DateTime @default(now())

  case FraudCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model FraudCaseEvidence {
  id            String   @id @default(cuid())
  caseId        String
  kind          String
  fileId        String?
  url           String?
  note          String?
  addedByUserId String
  createdAt     DateTime @default(now())

  case FraudCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

enum LandingPageStatus {
  DRAFT
  PUBLISHED
}

/// Lot E (Q7/Q106): the page a printed QR leads to when the advertiser gives
/// no destination — blocks the ADX builder drafted from the brief, published
/// at /p/:slug by the backend, every view and tap a TrackingEvent.
model LandingPage {
  id              String            @id @default(cuid())
  campaignId      String            @unique
  slug            String            @unique
  blocks          Json
  theme           Json?
  version         Int               @default(1)
  status          LandingPageStatus @default(DRAFT)
  generatedByAi   Boolean           @default(false)
  publishedAt     DateTime?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

enum ReviewSubjectType {
  LISTING
  AGENT
}

enum ReviewAnchorKind {
  ORDER
  CAMPAIGN_SPOT
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/// Lot D (Q5/Q19/Q137): one table for what people say about a spot or an
/// agent. Every review hangs off the transaction that earned the right to
/// write it — an advertiser's completed spot, a publisher's completed install
/// — so "24 reviews" is a claim about 24 bookings. The partial unique in the
/// migration keeps a publisher from rating the same agent twice, ever.
model Review {
  id                 String            @id @default(cuid())
  subjectType        ReviewSubjectType
  subjectId          String
  authorUserId       String
  authorPublisherId  String?
  authorAdvertiserId String?
  anchorKind         ReviewAnchorKind
  anchorId           String
  rating             Int
  note               String?
  status             ReviewStatus      @default(PUBLISHED)
  hiddenReason       String?
  hiddenById         String?
  createdAt          DateTime          @default(now())

  @@unique([anchorKind, anchorId, subjectType])
  @@index([subjectType, subjectId, status, createdAt])
  @@index([authorUserId])
}

/// Lot D (Q5/Q104): the heart. Per advertiser account, so an agent working
/// under a grant saves into the advertiser's book, not their own.
model SavedListing {
  id           String   @id @default(cuid())
  advertiserId String
  listingId    String
  createdAt    DateTime @default(now())

  @@unique([advertiserId, listingId])
  @@index([listingId])
}

/// One measurable code per booked slot — "one unique QR code is generated per
/// booked slot", as the tracking screen puts it.
///
/// The short code resolves through the platform, so a scan is a fact ADX holds
/// rather than a number the advertiser reports.
model CampaignTrackingCode {
  id          String         @id @default(cuid())
  campaignId  String
  spotId      String?
  /// The path segment behind /t/. Short, unambiguous, never reissued.
  code        String         @unique
  method      TrackingMethod
  /// Where a scan is sent, with the UTM tags already applied.
  destination String?
  /// The vanity path or promo code, when that is the method.
  vanityPath  String?
  promoCode   String?

  scans       Int @default(0)
  clicks      Int @default(0)
  redemptions Int @default(0)

  createdAt DateTime @default(now())

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  spot     CampaignSpot?   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  events   TrackingEvent[]

  @@index([campaignId])
  @@index([spotId])
}

/// A single scan, redirect or redemption. Rows, not counters, because a total
/// nobody can decompose is a number nobody can defend.
model TrackingEvent {
  id         String            @id @default(cuid())
  codeId     String
  type       TrackingEventType
  occurredAt DateTime          @default(now())
  /// Coarse only — a city and a device class. No identifiers, nothing that
  /// makes a scan traceable to a person.
  city       String?
  device     String?
  referer    String?
  /// Lot D (Q7): the IST hour (0–23) and the CTA that was pressed, for the
  /// interactions breakdown.
  hourIst    Int?
  ctaLabel   String?

  code CampaignTrackingCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId, occurredAt])
  @@index([type, occurredAt])
}

/// One row a day a campaign is live: what it cost, what was measured, and what
/// is only estimated.
///
/// Measured and estimated are separate columns on purpose. Spend and scans are
/// facts. Reach is arithmetic over whatever footfall figures the booked
/// listings carry, and is null when none of them carry one — an empty tile is
/// honest where an invented number is not.
model CampaignDailyMetric {
  id         String   @id @default(cuid())
  campaignId String
  day        DateTime @db.Date

  spotsLive Int     @default(0)
  spend     Decimal @default(0) @db.Decimal(14, 2)

  scans       Int @default(0)
  clicks      Int @default(0)
  redemptions Int @default(0)

  /// Null when no booked listing states a footfall figure.
  estimatedReach Int?
  /// How many of the day's live spots contributed to that estimate.
  reachFromSpots Int  @default(0)

  computedAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, day])
  @@index([day])
}

/// ══════════════════════════════════════════════════════════════════
/// Advertiser packages — DR 02's four-step sale.
///
/// A subscription an agent sells to an advertiser, sitting beside the
/// campaigns they book rather than inside them. The flow is four screens:
/// choose a package, confirm the cycle and add-ons, send a payment link, and
/// the activation receipt.
///
/// The third of those is the one that shapes this schema. The agent does not
/// take the money — the frame says a link goes to the advertiser by email, SMS
/// and WhatsApp, and the agent waits. So a sale is a record that exists before
/// it is paid for, carries a token somebody else opens, and activates when the
/// money actually lands. That is why `PackageSale` has a status ladder and a
/// payment token rather than being written once at the end.
/// ══════════════════════════════════════════════════════════════════

enum PackageTier {
  STARTER
  GROWTH
  PRO
}

enum PackageBillingCycle {
  MONTHLY
  ANNUAL
}

enum PackageSaleStatus {
  /// The agent is still on the wizard. Nothing has been sent.
  DRAFT
  /// The link has gone out and the advertiser has not paid.
  PENDING_PAYMENT
  ACTIVE
  /// Ran to the end of its term. Renewal is a new sale, deliberately.
  EXPIRED
  CANCELLED
}

enum PackagePaymentMethod {
  /// Lot J2: a free trial — nothing was paid; the term is the trial's days.
  TRIAL
  /// Paid from the advertiser's own ADX wallet, which is the only rail the
  /// platform actually holds money on today.
  WALLET
  /// A bank transfer or a cheque, recorded by an admin with its reference.
  OFFLINE
  /// Lot C (Q12): card / UPI / net banking through a gateway; the Payment row
  /// carries which one and what it returned.
  GATEWAY
}

enum PaymentGateway {
  RAZORPAY
  CASHFREE
  CCAVENUE
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Lot C (Q12/Q110): one attempt to pay through a gateway. On CAPTURED the
/// money passes through the advertiser wallet — a TOPUP with reference = this
/// payment, then the capture — so every rail tells the ledger the same story.
model Payment {
  id                  String         @id @default(cuid())
  /// PAY-2026-000482
  reference           String         @unique
  /// Lot J: exactly one of advertiserId / publisherId — who is paying.
  advertiserId        String?
  publisherId         String?
  campaignId          String?
  packageSaleId       String?
  /// Lot J: a publisher's plan purchase, the third thing a payment can settle.
  subscriptionOrderId String?
  gateway             PaymentGateway
  gatewayOrderId      String?
  gatewayPaymentId    String?
  amount              Decimal        @db.Decimal(14, 2)
  currency            String         @default("INR")
  /// card | upi | netbanking | wallet, as the gateway reported it.
  method              String?
  status              PaymentStatus  @default(CREATED)
  failureReason       String?
  topUpId             String?
  walletEntryId       String?
  ledgerTransactionId String?
  invoiceId           String?
  createdByUserId     String?
  createdAt           DateTime       @default(now())
  capturedAt          DateTime?
  updatedAt           DateTime       @updatedAt

  refunds PaymentRefund[]

  @@index([advertiserId, createdAt])
  @@index([publisherId, createdAt])
  @@index([campaignId])
  @@index([packageSaleId])
  @@index([subscriptionOrderId])
  @@index([gateway, gatewayOrderId])
  @@index([status, createdAt])
}

enum PaymentRefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model PaymentRefund {
  id              String              @id @default(cuid())
  paymentId       String
  amount          Decimal             @db.Decimal(14, 2)
  gatewayRefundId String?
  status          PaymentRefundStatus @default(PENDING)
  reason          String
  refundRequestId String?
  createdAt       DateTime            @default(now())
  processedAt     DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

/// Every gateway webhook once, whatever the gateway retries. Signature-checked
/// before it is written; processed at most once.
model WebhookEvent {
  id          String         @id @default(cuid())
  gateway     PaymentGateway
  eventId     String
  eventType   String?
  payload     Json
  receivedAt  DateTime       @default(now())
  processedAt DateTime?
  outcome     String?

  @@unique([gateway, eventId])
  @@index([receivedAt])
}

/// A plan in the catalogue. Prices are per month; the annual cycle discounts.
model AdvertiserPackage {
  id            String      @id @default(cuid())
  tier          PackageTier @unique
  name          String
  pricePerMonth Decimal     @db.Decimal(14, 2)
  description   String?
  /// Drawn as the POPULAR flag on the middle card.
  isPopular     Boolean     @default(false)
  /// What the plan promises, named so a screen can list it. Nothing enforces
  /// these yet, and the sale is honest about that rather than implying a gate
  /// that does not exist.
  entitlements  Json        @default("{}")
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sales PackageSale[]

  @@index([isActive, sortOrder])
}

/// An extra sold alongside a plan. Global rather than per plan, because the
/// frame offers the same three under every package.
model PackageAddOn {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  pricePerMonth Decimal  @db.Decimal(14, 2)
  description   String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// One sale, from the agent opening the wizard to the term running out.
model PackageSale {
  id        String @id @default(cuid())
  /// PKG-2026-482913. Quoted on the payment link and the receipt.
  reference String @unique

  advertiserId    String
  /// The agent who sold it. Null when an admin sells or renews from the console.
  agentId         String?
  createdByUserId String
  /// Lot B (Q1): the field visit this sale was made on, when the agent was on
  /// one — the outcome the visit reports, not a second record of the work.
  visitId         String?

  packageId     String
  /// Snapshotted: a plan whose price changes must not re-rate a sale already made.
  tier          PackageTier
  packageName   String
  pricePerMonth Decimal             @db.Decimal(14, 2)
  cycle         PackageBillingCycle @default(MONTHLY)
  /// Months billed at once — 1 monthly, 12 annually.
  months        Int                 @default(1)

  /// The money, in the order the review screen prints it.
  addOnsPerMonth Decimal @default(0) @db.Decimal(14, 2)
  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  /// 20 on the annual cycle, as the SAVE 20% badge promises.
  discountPct    Decimal @default(0) @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  gstPct         Decimal @default(18) @db.Decimal(5, 2)
  gstAmount      Decimal @default(0) @db.Decimal(14, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)

  status PackageSaleStatus @default(DRAFT)

  /// The token in the link the advertiser opens. Never reissued, so a link
  /// already sent keeps working and a resend does not orphan the first one.
  paymentToken      String    @unique
  paymentLinkSentAt DateTime?
  /// How many times the agent pressed Resend. Worth knowing when a sale stalls.
  paymentLinkSends  Int       @default(0)

  paidAt        DateTime?
  paidMethod    PackagePaymentMethod?
  /// A wallet entry id, or the bank reference an admin typed in.
  paidReference String?

  /// The term. Set on payment, not on creation — a package that was never paid
  /// for never ran, and dating it from the sale would say otherwise.
  startsAt      DateTime?
  endsAt        DateTime?
  nextBillingAt DateTime?
  /// Lot J2: renew from the wallet at endsAt, while the policy allows it.
  autoRenew     Boolean   @default(false)

  cancelledAt        DateTime?
  cancellationReason String?

  /// The PACKAGE_SOLD incentive recorded when the sale was paid — "₹2,500
  /// comm." on the card is this row's amount, never a second calculation.
  incentiveId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advertiser Advertiser        @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  agent      AgentProfile?     @relation(fields: [agentId], references: [id])
  createdBy  User              @relation("PackageSaleCreatedBy", fields: [createdByUserId], references: [id])
  package    AdvertiserPackage @relation(fields: [packageId], references: [id])
  lines      PackageSaleLine[]

  @@index([advertiserId, status])
  @@index([agentId])
  @@index([status, nextBillingAt])
}

/// Every line the receipt shows: the plan itself, then each add-on.
model PackageSaleLine {
  id     String @id @default(cuid())
  saleId String

  /// PLAN or ADDON. A string rather than an enum: two values that will not grow.
  kind          String
  code          String
  label         String
  pricePerMonth Decimal @db.Decimal(14, 2)
  months        Int     @default(1)
  amount        Decimal @db.Decimal(14, 2)

  sale PackageSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * The ledger
 */
/**
 * ------------------------------------------------------------------
 */

/// Whose book an account belongs to.
enum LedgerAccountKind {
  /// A party's wallet — advertiser, publisher or agent. One per wallet.
  WALLET
  /// ADX's own books: revenue, tax payable, payouts clearing, goodwill expense.
  PLATFORM
}

/// Why money moved. Kept coarse: the leg's own reference says which campaign,
/// order or sale, and a vocabulary that grows a member per feature stops being
/// reportable.
enum LedgerTransactionKind {
  TOPUP
  CAMPAIGN_SPEND
  PACKAGE_SPEND
  PUBLISHER_EARNING
  AGENT_INCENTIVE
  PAYOUT
  REFUND
  GOODWILL
  PENALTY
  ADJUSTMENT
  EXPIRY
  /// Lot B (Q50): a print job's approved cost, owed to the partner.
  PRINT_COST
  /// The mirror of an earlier transaction. The only way to undo anything.
  REVERSAL
}

/// One side of the book.
///
/// Party wallets get an account each; ADX's own positions get named accounts
/// seeded from a fixed chart. Nothing else may open one, because an account
/// nobody planned is a number nobody reconciles.
model LedgerAccount {
  id        String            @id @default(cuid())
  /// Stable machine name — "platform:revenue", "wallet:<walletId>".
  code      String            @unique
  name      String
  kind      LedgerAccountKind
  /// Set on a WALLET account, null on a PLATFORM one.
  walletId  String?           @unique
  createdAt DateTime          @default(now())

  wallet Wallet?     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  legs   LedgerLeg[]

  @@index([kind])
}

/// An immutable, balanced movement of money.
///
/// Four guards live in the migration rather than here, because Prisma cannot
/// express any of them: an append-only trigger on this table and on LedgerLeg,
/// a deferred constraint trigger asserting the legs sum to zero at commit, a
/// CHECK that a REVERSAL is exactly a transaction with `reversesId` set, and a
/// CHECK that nothing reverses itself.
///
/// Append-only, enforced by a trigger rather than by convention: UPDATE and
/// DELETE both raise. A mistake is corrected by posting its reversal, which
/// leaves both the error and the correction on the record — the only version of
/// this that survives an audit.
///
/// `idempotencyKey` is the caller's promise that two attempts are one event. A
/// retried webhook, a double-tapped button and a replayed job all collapse onto
/// the same transaction.
model LedgerTransaction {
  id              String                @id @default(cuid())
  /// Human-readable, e.g. LGR-2026-000412.
  reference       String                @unique
  kind            LedgerTransactionKind
  idempotencyKey  String                @unique
  /// Set when this transaction reverses another, and unique so one transaction
  /// can only ever be reversed once.
  reversesId      String?               @unique
  /// When the money moved, which is not always when the row was written.
  occurredAt      DateTime              @default(now())
  createdByUserId String?
  note            String?
  createdAt       DateTime              @default(now())

  reverses   LedgerTransaction? @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy LedgerTransaction? @relation("LedgerReversal")
  legs       LedgerLeg[]

  @@index([kind, occurredAt])
  @@index([occurredAt])
}

/// One leg of a transaction. The legs of a transaction sum to zero, enforced by
/// a deferred constraint trigger so legs can be inserted one at a time inside
/// the same database transaction and still be checked as a set at commit.
model LedgerLeg {
  id            String   @id @default(cuid())
  transactionId String
  accountId     String
  /// Signed: credits positive, debits negative. Never zero.
  amount        Decimal  @db.Decimal(14, 2)
  /// What this leg is about, so a statement line can point at its cause.
  campaignId    String?
  orderId       String?
  /// A sale, a withdrawal, a batch — whatever the kind implies.
  reference     String?
  note          String?
  createdAt     DateTime @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId, createdAt])
  @@index([campaignId])
  @@index([orderId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * DR 04 — earnings, withdrawal and payout
 */
/**
 * ------------------------------------------------------------------
 */

enum PayoutMethodType {
  BANK
  UPI
}

enum PayoutMethodStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum PayoutVerificationMethod {
  /// A rupee sent and matched. Available only where the rail offers it.
  PENNY_DROP
  /// A VPA resolved to a name.
  NAME_LOOKUP
  /// Ops checked the papers. Always available, and the only option until a
  /// rail is chosen.
  MANUAL
}

/// Which withdrawal ladder a party is on.
///
/// The caps are a commercial judgement about who ADX is dealing with rather
/// than anything derivable from the data, so ops set it.
enum PartySizeBand {
  /// An individual or a small publisher.
  INDIVIDUAL
  /// A smaller agency holding a handful of spots.
  SMALL_AGENCY
  /// A large agency or media owner.
  LARGE_AGENCY
}

/// The daily ceiling on withdrawals, by band and by how long the party has been
/// on the platform.
///
/// A table rather than constants because these numbers have already changed
/// once. `minMonths` is months of history since onboarding; the row with the
/// highest `minMonths` a party qualifies for is the one that applies.
model WithdrawalLimit {
  id        String        @id @default(cuid())
  band      PartySizeBand
  minMonths Int
  dailyCap  Decimal       @db.Decimal(14, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([band, minMonths])
}

enum TaxParty {
  PUBLISHER
  AGENT
  /// Lot B (Q50): print partners are paid under 194C too.
  PARTNER
}

enum PrintJobStatus {
  REQUESTED
  ACCEPTED
  PRINTING
  READY
  COLLECTED
  CANCELLED
}

/// Lot B (Q50): a print partner is a payee — a User with role PARTNER that
/// cannot sign in, a wallet, a payout method — so an offline NEFT is still a
/// PAID withdrawal on the books, never a note in a spreadsheet.
model PrintPartner {
  id                   String    @id @default(cuid())
  /// PRT-1209-2601
  displayId            String?   @unique
  userId               String    @unique
  name                 String
  legalName            String?
  gstin                String?
  panNumber            String?
  contactName          String?
  mobile               String
  email                String?
  address              String?
  city                 String?
  /// Lot X: the catalogue city the free-text `city` resolved to (null when it did not); every read that groups by city groups by this.
  cityId               String?
  latitude             Float?
  longitude            Float?
  capabilities         String[]  @default([])
  maxWidthFt           Decimal?  @db.Decimal(8, 2)
  turnaroundDays       Int?
  isActive             Boolean   @default(true)
  notes                String?
  /// Lot H (Q147, the owner's 6 Sep mechanics): the partner signs in once ops
  /// activates the account; a rate card uploaded at profile configuration puts
  /// the partner first in line, else quote requests reach them.
  activatedAt          DateTime?
  activatedById        String?
  rateCardFileId       String?
  rateCardUpdatedAt    DateTime?
  /// Structured rows the partner keys in: [{ material, sizeClass?, unit, ratePerUnit, minQty?, notes? }]
  rateCardRows         Json?
  acceptsQuoteRequests Boolean   @default(true)
  invoiceUploadFileId  String?
  /// Lot N: the partner's KYC, mirrored from the record like the publisher's.
  kycStatus            KycStatus @default(PENDING)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  wallet Wallet?
  jobs   PrintJob[]
  quotes PrintQuote[]
  kyc    PrintPartnerKyc?

  cityRef City? @relation("PrintPartnerCity", fields: [cityId], references: [id], onDelete: SetNull)

  @@index([city, isActive])
  @@index([cityId])
}

/// Lot N (owner, 14 Sep 2026): the print partner's KYC — a business record
/// like the publisher's business branch, on the same three paths (the
/// partner on the phone, the desk recording it, the desk requesting it) and
/// the same review workbench (KycDocumentReview with partyType PRINT_PARTNER).
model PrintPartnerKyc {
  id                      String               @id @default(cuid())
  printPartnerId          String               @unique
  manifestVersion         Int?
  // Manual upload path
  panNumber               String?
  panFrontUrl             String?
  panSignatureUrl         String?
  gstUrl                  String?
  businessRegCertUrl      String?
  businessAddressProofUrl String?
  directorIdUrl           String?
  govIdType               String?
  govIdFrontUrl           String?
  govIdBackUrl            String?
  bankProofUrl            String?
  selfieUrl               String?
  // Digio path
  digioRequestId          String?
  digioReferenceId        String?
  digioStatus             String?
  digioVerifiedAt         DateTime?
  digioPayload            Json?
  // Common
  method                  String               @default("MANUAL")
  status                  KycStatus            @default(PENDING)
  rejectionReason         String?
  submittedAt             DateTime?
  reviewedAt              DateTime?
  reviewedById            String?
  reviewNote              String?
  assignedToId            String?
  assignedAt              DateTime?
  escalatedAt             DateTime?
  escalationSource        KycEscalationSource?
  escalationReason        String?
  escalatedToUserId       String?
  escalatedById           String?
  imagesPurgedAt          DateTime?
  /// Lot N: the desk asked for this KYC (a notice, and for DIGIO the link) —
  /// who, when, over which path; and who recorded the documents when it was
  /// not the party themselves (an agent, or an admin at the desk).
  requestedAt             DateTime?
  requestedById           String?
  requestedChannel        String?
  recordedById            String?
  recordedVia             String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  printPartner PrintPartner @relation(fields: [printPartnerId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@index([digioRequestId])
}

/// One print job per order. Cost approval posts the payable into the partner's
/// wallet; collection is the agent's pickup scan.
model PrintJob {
  id                   String         @id @default(cuid())
  orderId              String         @unique
  printPartnerId       String
  status               PrintJobStatus @default(REQUESTED)
  quotedCost           Decimal?       @db.Decimal(14, 2)
  actualCost           Decimal?       @db.Decimal(14, 2)
  specs                Json?
  requestedAt          DateTime       @default(now())
  readyAt              DateTime?
  collectedAt          DateTime?
  costApprovedByUserId String?
  costApprovedAt       DateTime?
  ledgerTransactionId  String?
  notes                String?
  /// Lot H: the partner's own moves — accept / decline with a reason, the
  /// quote the job was awarded on, the handover confirmed by scan.
  partnerAcceptedAt    DateTime?
  partnerDeclinedAt    DateTime?
  declineReason        String?
  awardedQuoteId       String?        @unique
  handoverConfirmedAt  DateTime?
  handoverQrId         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  printPartner PrintPartner @relation(fields: [printPartnerId], references: [id])
  awardedQuote PrintQuote?  @relation("AwardedQuote", fields: [awardedQuoteId], references: [id])

  @@index([printPartnerId, status])
}

/// Lot H: a request for quotes on one order's print — sent to the partners in
/// reach that accept requests (rate-card partners are asked first / preferred);
/// the lowest quote is accepted unless ops override with a reason.
model PrintQuoteRequest {
  id             String                  @id @default(cuid())
  orderId        String
  specs          Json
  city           String?
  deadlineAt     DateTime
  status         PrintQuoteRequestStatus @default(OPEN)
  awardedQuoteId String?                 @unique
  awardNote      String?
  createdById    String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  quotes       PrintQuote[]
  awardedQuote PrintQuote?  @relation("RequestAward", fields: [awardedQuoteId], references: [id])

  @@index([orderId])
  @@index([status, deadlineAt])
}

model PrintQuote {
  id             String           @id @default(cuid())
  requestId      String
  printPartnerId String
  amount         Decimal          @db.Decimal(14, 2)
  turnaroundDays Int
  note           String?
  status         PrintQuoteStatus @default(SUBMITTED)
  submittedAt    DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  request      PrintQuoteRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  printPartner PrintPartner       @relation(fields: [printPartnerId], references: [id])
  awardedOn    PrintQuoteRequest? @relation("RequestAward")
  jobs         PrintJob[]         @relation("AwardedQuote")

  @@unique([requestId, printPartnerId])
  @@index([printPartnerId, status])
}

enum PrintQuoteRequestStatus {
  OPEN
  AWARDED
  CANCELLED
  EXPIRED
}

enum PrintQuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// Tax deducted at source, configurable and effective-dated.
///
/// Effective-dated for the same reason rate cards are: a rate that changes must
/// not re-rate money already withheld. The rate in force at the time is copied
/// onto every accrual and withdrawal, so this table is only ever read forwards.
model TaxWithholdingRate {
  id            String    @id @default(cuid())
  appliesTo     TaxParty
  /// The section of the Income Tax Act being applied, e.g. 194C, 194H.
  section       String
  ratePct       Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  @@index([appliesTo, effectiveFrom])
}

/// One day of a campaign, earned.
///
/// Earnings accrue per day of the flight rather than at install or at campaign
/// end: each day that passes adds that day's share to the publisher's wallet.
/// One row per spot per day, unique on the pair, so the job that writes them can
/// be run twice, late, or over a backfill window without paying twice.
model EarningAccrual {
  id             String   @id @default(cuid())
  publisherId    String
  listingId      String
  campaignSpotId String
  /// The day this covers, at UTC midnight.
  forDate        DateTime @db.Date

  /// What the advertiser paid for that day.
  gross             Decimal @db.Decimal(14, 2)
  /// ADX's share of it.
  commission        Decimal @db.Decimal(14, 2)
  /// Withheld at source and owed to the tax authority, not to the publisher.
  taxWithheld       Decimal @default(0) @db.Decimal(14, 2)
  /// gross − commission − taxWithheld. What reaches the wallet.
  net               Decimal @db.Decimal(14, 2)
  /// The rates in force on the day, copied so a later change cannot re-rate it.
  commissionRatePct Decimal @db.Decimal(5, 2)
  taxRatePct        Decimal @default(0) @db.Decimal(5, 2)
  /// Lot B: which instrument set the commission — the spot's stamp, or
  /// RESOLVED_AT_ACCRUAL for spots authorised before the stamp existed.
  commissionSource  String?

  /// When this day's money becomes withdrawable. Entitlement is immediate; the
  /// hold is what stops a campaign being drawn down before it has run.
  clearsAt            DateTime
  /// The statement line and the double-entry movement this produced.
  walletEntryId       String?
  ledgerTransactionId String?
  createdAt           DateTime @default(now())

  publisher Publisher    @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  spot      CampaignSpot @relation(fields: [campaignSpotId], references: [id], onDelete: Cascade)

  @@unique([campaignSpotId, forDate])
  @@index([publisherId, forDate])
  @@index([clearsAt])
}

enum WithdrawalStatus {
  /// Submitted by the party, waiting on ops. Nothing is auto-approved.
  REQUESTED
  /// Vetted by a person and queued for the rail.
  APPROVED
  /// Handed to the rail and not yet confirmed.
  PROCESSING
  PAID
  REJECTED
  /// The rail refused or the transfer bounced. The money returns to the wallet.
  FAILED
  /// Pulled by the party before anyone decided.
  CANCELLED
}

/// Which rail moved the money.
enum PayoutRailName {
  /// Finance transfers by hand and records the UTR. The first implementation,
  /// and the fallback for every other one.
  MANUAL_NEFT
  RAZORPAY_X
  CASHFREE
}

/// A request to take money out.
///
/// Never auto-approved, whatever the amount — a person vets every one. The
/// requested amount is not moved out of the balance; it is subtracted from what
/// is available to withdraw by summing the open requests, the same way spendable
/// balance already works, so the two can never drift apart.
model WithdrawalRequest {
  id             String @id @default(cuid())
  /// Readable, e.g. WDR-2026-000118.
  reference      String @unique
  walletId       String
  payoutMethodId String

  /// Gross requested by the party.
  amount      Decimal @db.Decimal(14, 2)
  /// TDS at the rate in force when the request was made, stored so a later rate
  /// change cannot re-rate money already promised.
  taxWithheld Decimal @default(0) @db.Decimal(14, 2)
  taxRatePct  Decimal @default(0) @db.Decimal(5, 2)
  taxSection  String?
  /// amount − taxWithheld. What actually lands in the account.
  netAmount   Decimal @db.Decimal(14, 2)

  status          WithdrawalStatus @default(REQUESTED)
  requestedAt     DateTime         @default(now())
  /// The person who vetted it, and what they said.
  decidedAt       DateTime?
  decidedByUserId String?
  decisionNote    String?

  rail          PayoutRailName?
  /// The UTR or the rail's own id. What finance reconciles a bank line against.
  railReference String?
  paidAt        DateTime?
  failureReason String?

  /// Lot B (Q35): the batch this line was released in. Approval only reserves
  /// the money; the wallet debit and the PAYOUT legs are posted at release, so
  /// a batch that fails half-way reverses nothing.
  batchId    String?
  reservedAt DateTime?

  ledgerTransactionId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  payoutMethod PayoutMethod @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  batch        PayoutBatch? @relation(fields: [batchId], references: [id])

  @@index([walletId, status])
  @@index([status, requestedAt])
  @@index([batchId])
}

enum PayoutBatchStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RELEASING
  RELEASED
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

/// Lot B (Q35): a set of approved withdrawals released together — as a bank
/// bulk-upload file on the manual rail, or line by line on a vendor rail. Four
/// eyes: the admin who approves is never the one who built it.
model PayoutBatch {
  id               String            @id @default(cuid())
  /// BATCH-2026-000012
  reference        String            @unique
  status           PayoutBatchStatus @default(DRAFT)
  rail             PayoutRailName
  bankAccountId    String?
  cutoffAt         DateTime?
  scheduledFor     DateTime?
  createdByUserId  String
  submittedAt      DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  releasedAt       DateTime?
  completedAt      DateTime?
  lineCount        Int               @default(0)
  totalNet         Decimal           @default(0) @db.Decimal(14, 2)
  exportFileId     String?
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  lines WithdrawalRequest[]

  @@index([status, createdAt])
}

/// Lot B (Q35/Q36): ADX's own bank accounts — what a payout file is drawn on
/// and what a statement is imported for. Never a party's account.
model BankAccount {
  id                  String   @id @default(cuid())
  label               String
  bankName            String
  accountHolder       String?
  accountNumberMasked String
  ifsc                String
  isActive            Boolean  @default(true)
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  imports BankStatementImport[]
  lines   BankStatementLine[]
}

/// Lot B (Q36): how one bank's statement export maps onto lines — column names
/// for date, description, reference, debit, credit, balance, and the date format.
model BankStatementProfile {
  id         String   @id @default(cuid())
  name       String   @unique
  bankName   String
  columns    Json
  dateFormat String?
  createdAt  DateTime @default(now())
}

model BankStatementImport {
  id               String    @id @default(cuid())
  bankAccountId    String
  profileId        String?
  fileId           String?
  fileName         String
  periodStart      DateTime?
  periodEnd        DateTime?
  lineCount        Int       @default(0)
  duplicateCount   Int       @default(0)
  importedByUserId String
  createdAt        DateTime  @default(now())

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id])
  lines       BankStatementLine[]

  @@index([bankAccountId, createdAt])
}

enum BankLineDirection {
  CREDIT
  DEBIT
}

enum BankLineMatchStatus {
  UNMATCHED
  MATCHED
  DIFFERS
  IGNORED
}

model BankStatementLine {
  id             String              @id @default(cuid())
  importId       String
  bankAccountId  String
  valueDate      DateTime            @db.Date
  description    String
  utr            String?
  direction      BankLineDirection
  amount         Decimal             @db.Decimal(14, 2)
  runningBalance Decimal?            @db.Decimal(14, 2)
  /// sha256 of (date|description|amount|direction) — the same line imported
  /// twice is one line.
  rawHash        String
  matchStatus    BankLineMatchStatus @default(UNMATCHED)
  createdAt      DateTime            @default(now())

  import      BankStatementImport  @relation(fields: [importId], references: [id], onDelete: Cascade)
  bankAccount BankAccount          @relation(fields: [bankAccountId], references: [id])
  match       ReconciliationMatch?

  @@unique([bankAccountId, rawHash])
  @@index([matchStatus, valueDate])
  @@index([utr])
}

enum ReconciliationMatchKind {
  AUTO
  MANUAL
}

/// One bank line explained by one ADX record: a paid withdrawal (by UTR), a
/// recorded top-up, a gateway payment, or a ledger transaction by amount and
/// date. `difference` is what the two disagree by, when they do.
model ReconciliationMatch {
  id                  String                  @id @default(cuid())
  lineId              String                  @unique
  ledgerTransactionId String?
  withdrawalId        String?
  topUpId             String?
  paymentId           String?
  difference          Decimal                 @default(0) @db.Decimal(14, 2)
  kind                ReconciliationMatchKind
  matchedByUserId     String?
  note                String?
  createdAt           DateTime                @default(now())

  line BankStatementLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([withdrawalId])
  @@index([topUpId])
}

/// What an agent is paid for, and how much.
enum IncentiveEvent {
  PUBLISHER_ONBOARDED
  SITE_VISIT
  CAMPAIGN_ASSIST
  MILESTONE_BONUS
  /// Paid on reaching a tier, at the rate configured for that tier — or not
  /// at all, when none is. The GOLD Achieved screen lists it only when it is real.
  TIER_BONUS
  /// Paid when a package sale the agent made is paid for (decision 16).
  PACKAGE_SOLD
  /// Lot B (Q3/Q15): the per-order commission for an installation, recorded at
  /// ops sign-off at the figure the offer showed.
  INSTALLATION
  /// Lot B (Q2): the advertiser-side twin of PUBLISHER_ONBOARDED, recorded when
  /// an attributed advertiser activates.
  ADVERTISER_ONBOARDED
}

/// Agent incentive rates, by event and tier, effective-dated like rate cards.
///
/// `tier` takes a tier name or "*" for every tier, so a rate that does not vary
/// needs one row rather than one per tier.
model IncentiveRate {
  id            String         @id @default(cuid())
  event         IncentiveEvent
  tier          String         @default("*")
  amount        Decimal        @db.Decimal(14, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime       @default(now())

  incentives AgentIncentive[]

  @@index([event, tier, effectiveFrom])
}

enum IncentiveStatus {
  /// Earned and waiting on ops. Finance is vetted before it moves, always.
  PENDING_VERIFICATION
  CREDITED
  REJECTED
}

/// One incentive an agent has earned.
model AgentIncentive {
  id          String         @id @default(cuid())
  agentId     String
  event       IncentiveEvent
  /// The tier the agent held when it was earned, copied so a promotion does not
  /// retrospectively re-rate work already done.
  tier        String
  rateId      String?
  amount      Decimal        @db.Decimal(14, 2)
  taxWithheld Decimal        @default(0) @db.Decimal(14, 2)
  taxRatePct  Decimal        @default(0) @db.Decimal(5, 2)
  netAmount   Decimal        @db.Decimal(14, 2)

  status       IncentiveStatus @default(PENDING_VERIFICATION)
  /// What the incentive is for, so ops can check it before crediting.
  orderId      String?
  publisherId  String?
  advertiserId String?
  note         String?

  verifiedByUserId String?
  verifiedAt       DateTime?
  rejectionReason  String?

  walletEntryId       String?
  ledgerTransactionId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agent AgentProfile   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  rate  IncentiveRate? @relation(fields: [rateId], references: [id])

  @@index([agentId, status])
  @@index([status, createdAt])
}

/// A month of a party's account, closed off.
///
/// Generated on the 1st for the month just ended and downloadable on demand.
/// The figures are stored rather than recomputed on read, because a statement
/// somebody downloaded in March must still say in December what it said then.
model Statement {
  id             String   @id @default(cuid())
  reference      String   @unique
  walletId       String
  periodStart    DateTime
  periodEnd      DateTime
  openingBalance Decimal  @db.Decimal(14, 2)
  credits        Decimal  @db.Decimal(14, 2)
  debits         Decimal  @db.Decimal(14, 2)
  taxWithheld    Decimal  @default(0) @db.Decimal(14, 2)
  closingBalance Decimal  @db.Decimal(14, 2)
  entryCount     Int      @default(0)
  /// Rendered artefacts, written once and served thereafter.
  csvPath        String?
  pdfPath        String?
  generatedAt    DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, periodStart])
  @@index([walletId, periodStart])
}

/// Who installs the advertisement, decided per booking.
enum InstallBy {
  /// The publisher does it and claims the evidence steps themselves.
  PUBLISHER
  /// ADX sends an agent, for a fee.
  ADX
}

/// What the agent or the publisher photographed, and when.
///
/// Replaces three nullable columns on SiteVerification that quietly dropped
/// everything past the second photo: capture-condition kept `photoUrls[0]` and
/// `photoUrls[1]` and discarded the rest, collect-prints took a photo and never
/// stored it at all, and the rejection photos went the same way. The frames name
/// four separate proofs, so the shape had to be a list.
///
/// `label` carries the frame's own name for the shot — "Mirror decal", "Decal
/// angle" — which is what makes a four-of-four counter mean anything.
model OrderPhoto {
  id               String         @id @default(cuid())
  orderId          String
  kind             OrderPhotoKind
  label            String?
  url              String
  /// Where it was taken, when the device offered it. Not required: a photo with
  /// no fix is still evidence, and refusing it would block an agent in a
  /// basement car park.
  latitude         Float?
  longitude        Float?
  capturedAt       DateTime       @default(now())
  uploadedByUserId String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, kind])
}

enum OrderPhotoKind {
  /// A2 — the material collected from the print vendor.
  PICKUP
  /// A5 — the site before anything is installed.
  CONDITION
  /// A7 — the advertisement in place.
  INSTALLATION
  /// Why the agent refused the site.
  REJECTION
}

/// ---------------------------------------------------------------------------
/// Disputes — DR 07 wave 3. One domain for the agent app, the user app's two
/// personas and the console; a case is visible to the party who raised it, the
/// party it is against, and ADX. See src/modules/disputes/README.md.
/// ---------------------------------------------------------------------------

/// The one status enum. The agent's three chips are a projection of it
/// (agentStateOf in disputes.types.ts); the console's "SLA breach" is a flag
/// derived from slaDueAt, not a status.
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  /// ADX has asked the raiser (or the other party) for something.
  AWAITING_RESPONSE
  ESCALATED
  RESOLVED
  REJECTED
}

/// The Raise frame's five "what went wrong" chips, exactly.
enum DisputeReason {
  PROOF_REJECTED
  PAYOUT_ISSUE
  DAMAGE
  WRONG_LOCATION
  OTHER
}

enum DisputeParty {
  PUBLISHER
  ADVERTISER
  AGENT
  ADX
}

enum DisputeOutcome {
  REINSTALL
  PARTIAL_CREDIT
  FULL_CREDIT
  /// Nothing owed: the case is closed as REJECTED.
  NO_FAULT
}

/// DR 04: nothing that moves money is automatic. A resolution that credits
/// money records the credit as PENDING; finance releases it, and only then
/// does the wallet move.
enum DisputeCreditStatus {
  NONE
  PENDING
  RELEASED
}

model Dispute {
  id                   String              @id @default(cuid())
  /// DSP-…, off the identifiers counter.
  displayId            String              @unique
  raisedByUserId       String
  /// Which hat the raiser wore on this order.
  raisedAs             DisputeParty
  againstParty         DisputeParty
  /// The other party's login, when it is a person and not ADX.
  againstUserId        String?
  orderId              String?
  listingId            String?
  reason               DisputeReason
  detail               String
  expectedResolution   String?
  amountClaimed        Decimal?            @db.Decimal(14, 2)
  status               DisputeStatus       @default(OPEN)
  /// What ops said when they last moved it.
  statusNote           String?
  slaDueAt             DateTime?
  /// Lot D (Q53): paused while AWAITING_RESPONSE, like a ticket.
  slaPausedAt          DateTime?
  slaPausedMs          Int                 @default(0)
  /// Lot D (Q54/Q92): the re-install milestone a REINSTALL resolution raised.
  reinstallMilestoneId String?             @unique
  reviewStartedAt      DateTime?
  escalatedAt          DateTime?
  resolvedAt           DateTime?
  resolvedByUserId     String?
  outcome              DisputeOutcome?
  resolutionNote       String?
  creditedAmount       Decimal?            @db.Decimal(14, 2)
  creditStatus         DisputeCreditStatus @default(NONE)
  creditReleasedAt     DateTime?
  creditReleasedById   String?
  creditWalletEntryId  String?
  /// The raiser may reopen a closed case until this passes.
  reopenUntil          DateTime?
  /// DR 07's RATE RESOLUTION: 1–5 from the raiser, once, on a closed case.
  resolutionRating     Int?
  resolutionRatingNote String?
  resolutionRatedAt    DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  raisedBy User              @relation("DisputesRaised", fields: [raisedByUserId], references: [id])
  order    Order?            @relation(fields: [orderId], references: [id])
  listing  Listing?          @relation(fields: [listingId], references: [id])
  messages DisputeMessage[]
  evidence DisputeEvidence[]

  @@index([raisedByUserId, createdAt])
  @@index([againstUserId])
  @@index([status, createdAt])
  @@index([orderId])
}

model DisputeMessage {
  id           String   @id @default(cuid())
  disputeId    String
  authorUserId String
  /// "ADX Ops" for the desk; the person's name otherwise.
  authorName   String
  isFromOps    Boolean  @default(false)
  body         String
  createdAt    DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User    @relation("DisputeMessages", fields: [authorUserId], references: [id])

  @@index([disputeId, createdAt])
}

model DisputeEvidence {
  id               String   @id @default(cuid())
  disputeId        String
  uploadedByUserId String
  /// From POST /upload.
  url              String
  /// IMG, PDF or OTHER — what the viewer should open it as.
  kind             String   @default("IMG")
  fileName         String?
  uploadedAt       DateTime @default(now())

  dispute    Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("DisputeEvidence", fields: [uploadedByUserId], references: [id])

  @@index([disputeId])
}

/// ---------------------------------------------------------------------------
/// Legal — the read documents. DR 07 wave 4. Versioned like AgreementTemplate,
/// but READ rather than accepted, which is why these are not AgreementKind
/// values: every one of those has acceptance rows behind it.
/// See src/modules/legal/README.md.
/// ---------------------------------------------------------------------------

enum LegalDocumentKind {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  REFUND_POLICY
  CONTENT_POLICY
  COMMUNITY_GUIDELINES
  COMMISSION_STRUCTURE
  CODE_OF_CONDUCT
  LEGAL_DISCLAIMER
  /// `meta` carries the office, lines, email and registration block.
  CONTACT_INFO
  ABOUT
  /// `meta.items` carries the questions, answers and tags.
  FAQ
  SAFETY_GUIDELINES
  OPEN_SOURCE_LICENSES
}

model LegalDocument {
  id              String            @id @default(cuid())
  kind            LegalDocumentKind
  version         Int
  title           String
  /// One line under the title on the About & Policies index.
  summary         String?
  /// Markdown. The apps render it; the console shows the source.
  body            String
  /// The structured half of Contact info and FAQs. Null for a plain policy.
  meta            Json?
  isActive        Boolean           @default(false)
  effectiveFrom   DateTime          @default(now())
  /// When this version was made the live one. Null means it never was — a
  /// draft, the only kind whose text may still change.
  activatedAt     DateTime?
  retiredAt       DateTime?
  createdByUserId String?
  changeNote      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([kind, version])
  @@index([kind, isActive])
}

/// ---------------------------------------------------------------------------
/// Safety — an agent reporting an unsafe site, and the live-location share
/// beside it. A blocking report takes the job off the agent.
/// See src/modules/safety/README.md.
/// ---------------------------------------------------------------------------

enum SafetyAlertKind {
  UNSAFE_SITE
  HARASSMENT
  ACCIDENT
  /// Not a report: the agent asking to be watched while on a job.
  LOCATION_SHARE
  OTHER
}

enum SafetyAlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

model SafetyAlert {
  id               String            @id @default(cuid())
  /// SFT-…, off the identifiers counter.
  displayId        String            @unique
  raisedByUserId   String
  kind             SafetyAlertKind
  orderId          String?
  milestoneId      String?
  note             String?
  latitude         Float?
  longitude        Float?
  /// True when raising it took the agent off the job.
  blockedOrder     Boolean           @default(false)
  status           SafetyAlertStatus @default(OPEN)
  opsNote          String?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  closedAt         DateTime?
  closedById       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  raisedBy User   @relation("SafetyAlertsRaised", fields: [raisedByUserId], references: [id])
  order    Order? @relation(fields: [orderId], references: [id])

  @@index([status, createdAt])
  @@index([raisedByUserId, createdAt])
  @@index([orderId])
}

/// ---------------------------------------------------------------------------
/// Preferences a person sets about themselves — DR 07 wave 5. Key/value rather
/// than a column per switch: the Privacy and App Preferences frames draw nine
/// between them and more will follow, and none of them is a platform record.
/// See src/modules/users/README.md.
/// ---------------------------------------------------------------------------

model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  /// Namespaced: "privacy.showName", "app.theme", "notifications.quietHours".
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

/// ---------------------------------------------------------------------------
/// The rating snapshot — DR 07 wave 6, decision 3. A cache of a derivation,
/// never a source: an agent's own score is recomputed from orders, assignments
/// and check-ins on every read, and this row exists so the cohort percentile is
/// one query instead of a scan of every agent's history.
/// See src/modules/agents/rating/rating.rules.ts.
/// ---------------------------------------------------------------------------

model AgentRating {
  id             String   @id @default(cuid())
  agentId        String   @unique
  /// Copied so the cohort query is a single index hit.
  city           String?
  /// Null while the agent has too little history to rate.
  score          Decimal? @db.Decimal(3, 2)
  completionRate Decimal? @db.Decimal(5, 4)
  onTimeRate     Decimal? @db.Decimal(5, 4)
  rejectionRate  Decimal? @db.Decimal(5, 4)
  /// Lot D (Q19/Q112): the written driver — publishers' stars, averaged; null
  /// until one exists, and then weighted at 0.2 with the three derived drivers
  /// re-weighted to fill.
  reviewAvg      Decimal? @db.Decimal(3, 2)
  reviewCount    Int      @default(0)
  /// Finished jobs the score is based on.
  sample         Int      @default(0)
  computedAt     DateTime @default(now())

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([city, score])
}

/// ---------------------------------------------------------------------------
/// DR 06 — LEADS
///
/// A prospect an agent can go and see. The platform had no such record: the
/// agent dashboard declared a `LeadCluster` shape and returned `leads: []`,
/// with a test pinning the empty list as correct until a model existed. This
/// is that model.
///
/// Deliberately NOT an `Order`, a `Publisher` or an `Advertiser`. A lead is a
/// business nobody has signed yet — it has no account, no KYC and no money —
/// and it becomes one of those things exactly once, which `convertedPublisherId`
/// and `convertedAdvertiserId` record.
/// ---------------------------------------------------------------------------

/// Which side of the marketplace the agent is prospecting for. The publisher
/// agent sells space; the advertiser agent sells campaigns.
enum LeadSide {
  PUBLISHER
  ADVERTISER
}

/// One vocabulary, reconciled the way DR 07 reconciled DisputeStatus.
///
/// The card draws three of these as a pill (NEW, CONTACTED, HOT) and the other
/// three are where a lead ends up. `leadPillOf` in the module maps the six onto
/// what the frame draws rather than keeping a second list.
enum LeadStatus {
  NEW
  CONTACTED
  /// Worth chasing. Set by the agent, not derived — it is a judgement.
  HOT
  VISIT_BOOKED
  CONVERTED
  LOST
}

enum LeadActivityKind {
  IMPORTED
  CALLED
  MESSAGED
  NOTE
  VISIT_BOOKED
  VISIT_DONE
  STATUS_CHANGED
  FOLLOW_UP
}

model Lead {
  id        String  @id @default(cuid())
  /// LED-0001. Minted through `identifiers`, like every other party.
  displayId String? @unique

  side         LeadSide
  businessName String
  /// "Print vendor", "Gym", "Cafe" — the rose chip on the card.
  ///
  /// A controlled string rather than an enum, the same choice `Listing`
  /// makes for illumination and facing: ops extends the vocabulary without a
  /// migration. It is not `VenueType`, which is an ad-placement taxonomy about
  /// where a screen hangs, not what a business is.
  category     String?

  contactName     String?
  phone           String?
  /// Lot D (Q56/Q93): E.164 form of `phone`; the hard duplicate key (a partial
  /// unique index in the migration).
  phoneNormalised String?
  email           String?

  address   String?
  locality  String?
  city      String?
  /// Lot X: the catalogue city the free-text `city` resolved to (null when it did not); every read that groups by city groups by this.
  cityId    String?
  latitude  Float?
  longitude Float?

  status LeadStatus @default(NEW)

  /// What the agent stands to earn by converting it — "Est. ₹1,450" on the
  /// card. Decimal because it is money, and nullable because a lead nobody has
  /// priced has no estimate, which is not zero.
  estimatedCommission Decimal? @db.Decimal(14, 2)

  /// What they said they wanted: "Wall panels".
  interest     String?
  /// Where the lead came from: "Referral", an import batch, a walk-in.
  source       String?
  /// "11 AM to 2 PM" — stored as two clock strings, like AgentProfile's hours.
  bestTimeFrom String?
  bestTimeTo   String?

  /// Null while the lead is in the open pool for whoever is nearest.
  assignedAgentId  String?
  firstContactedAt DateTime?

  /// Set exactly once, when the lead becomes an account. Which one it becomes
  /// follows `side`; both null until then.
  convertedPublisherId  String?
  convertedAdvertiserId String?
  convertedAt           DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignedAgent AgentProfile?  @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  activity      LeadActivity[]
  visits        FieldVisit[]

  /// The desk filters by city and status; the agent's list rides the last one.
  cityRef City? @relation("LeadCity", fields: [cityId], references: [id], onDelete: SetNull)

  @@index([city, status])
  @@index([assignedAgentId, status])
  @@index([latitude, longitude])
  @@index([cityId])
}

/// Everything that has happened to a lead — the Activity section on the detail
/// screen, and the record behind "Check in" and "Follow up".
model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  actorUserId String?
  kind        LeadActivityKind
  note        String?
  createdAt   DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

/// ---------------------------------------------------------------------------
/// DR 06 — FIELD VISITS
///
/// A trip an agent makes that is NOT a step on an order's checklist. The
/// platform's only visit was `OrderMilestone`, whose `orderId` is non-nullable:
/// every visit presupposed a booked order, so an onboarding call on a lead or a
/// renewal call on an advertiser — the two things DR 06's Visits list draws —
/// could not be recorded at all.
///
/// Deliberately not a third thing called "milestone". A site visit on an
/// order stays an `OrderMilestone` and is folded into the agent's day by the
/// service; this table holds the rest.
/// ---------------------------------------------------------------------------

enum FieldVisitKind {
  ONBOARDING
  RENEWAL
  FOLLOW_UP
  SURVEY
  /// Lot E (Q99): a data audit or poster check, paid at the visit rate.
  AUDIT
}

/// REQUESTED is the A12 offer: it expires unanswered, is accepted (SCHEDULED)
/// or declined. The clock is `offerExpiresAt`, the same 25 minutes an order
/// offer gets.
enum FieldVisitStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  DECLINED
  EXPIRED
  CANCELLED
}

model FieldVisit {
  id        String  @id @default(cuid())
  displayId String? @unique

  kind   FieldVisitKind
  status FieldVisitStatus @default(REQUESTED)

  agentId      String
  /// Exactly one of these says who the visit is to. A lead until it converts;
  /// an account afterwards.
  leadId       String?
  publisherId  String?
  advertiserId String?

  /// Copied onto the row so the card never needs a join to print a name, and
  /// so the name survives the lead becoming an account.
  businessName String
  locality     String?
  city         String?
  /// Lot X: the catalogue city the free-text `city` resolved to (null when it did not); every read that groups by city groups by this.
  cityId       String?
  latitude     Float?
  longitude    Float?

  /// The A12 window on a REQUESTED visit. Null once answered.
  offerExpiresAt DateTime?
  scheduledFor   DateTime?
  /// Lot E (Q99): groups the visits of one drive ("Delhi onboarding drive").
  campaignTag    String?
  startedAt      DateTime?
  completedAt    DateTime?
  declinedReason String?

  /// "₹145 earned" on a completed card. Copied from the incentive the
  /// completion recorded, so the card and the wallet cannot disagree.
  earnedAmount Decimal? @db.Decimal(14, 2)
  incentiveId  String?  @unique

  notes             String?
  requestedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead  Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// The agent's list rides the first; the dispatch board rides the second.
  cityRef City? @relation("FieldVisitCity", fields: [cityId], references: [id], onDelete: SetNull)

  @@index([agentId, status, scheduledFor])
  @@index([status, scheduledFor])
  @@index([city, scheduledFor])
  @@index([cityId])
}

// ─── Work: the DR 10 Tasks section (Lot AA, owner Q70 "minimal, essentials only") ───
//
// Internal work — projects, tasks, sub-tasks, issues, time logs, reviews and
// approvals — for employees and agents. Coordination only: a task assigned to
// an agent never pays; paid field work stays in orders, milestones and visits.

enum WorkProjectKind {
  DEPARTMENT
  REGION
}

enum WorkTaskStatus {
  DRAFT
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  VERIFIED
  BLOCKED
  ARCHIVED
}

enum WorkPriority {
  HIGH
  MEDIUM
  LOW
}

enum WorkIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum WorkIssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model WorkProject {
  id           String          @id @default(cuid())
  /// PRJ-0001, from the identifiers counter.
  displayId    String?         @unique
  name         String
  description  String?
  kind         WorkProjectKind
  departmentId String?
  /// A REGION project is a city's — a launch plan, an audit drive.
  cityId       String?
  ownerUserId  String
  status       String          @default("ACTIVE")
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tasks  WorkTask[]
  issues WorkIssue[]

  @@index([kind, status])
  @@index([cityId])
  @@index([departmentId])
}

model WorkTask {
  id              String         @id @default(cuid())
  /// TSK-000123, from the identifiers counter.
  displayId       String?        @unique
  projectId       String?
  parentTaskId    String?
  title           String
  description     String?
  status          WorkTaskStatus @default(TODO)
  priority        WorkPriority   @default(MEDIUM)
  /// 0–100, set by hand or rolled up from sub-tasks.
  progress        Int            @default(0)
  startDate       DateTime?
  deadline        DateTime?
  actualStartDate DateTime?
  revisedEndDate  DateTime?
  completedAt     DateTime?
  effortEstimateH Decimal?       @db.Decimal(8, 2)
  /// What this task is about, when it is about a record: ORDER | LISTING | LEAD | VISIT | CITY | PUBLISHER | ADVERTISER | PRINT_PARTNER | CAMPAIGN.
  linkedKind      String?
  linkedId        String?
  /// { frequency: DAILY|WEEKLY|MONTHLY|NONE, occursOn?: string, endDate?: string, totalOccurrences?: number }
  recurrence      Json?
  tags            String[]       @default([])
  createdById     String
  assignedById    String?
  blockedReason   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project      WorkProject?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent       WorkTask?            @relation("WorkTaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children     WorkTask[]           @relation("WorkTaskChildren")
  assignees    WorkTaskAssignee[]
  reviewers    WorkTaskReviewer[]
  dependencies WorkTaskDependency[] @relation("DependentTask")
  dependents   WorkTaskDependency[] @relation("PrerequisiteTask")
  comments     WorkTaskComment[]
  timeLogs     WorkTimeLog[]
  issues       WorkIssue[]

  @@index([projectId, status])
  @@index([status, deadline])
  @@index([parentTaskId])
  @@index([linkedKind, linkedId])
}

model WorkTaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

/// A reviewer signs off on PENDING_REVIEW; an approver's mark is the same row with `approver` true.
model WorkTaskReviewer {
  taskId     String
  userId     String
  approver   Boolean   @default(false)
  approvedAt DateTime?
  rejectedAt DateTime?
  note       String?

  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model WorkTaskDependency {
  taskId         String
  prerequisiteId String

  task         WorkTask @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisite WorkTask @relation("PrerequisiteTask", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([taskId, prerequisiteId])
  @@index([prerequisiteId])
}

model WorkTaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model WorkTimeLog {
  id       String   @id @default(cuid())
  taskId   String
  userId   String
  /// The day the work was done, IST date at midnight UTC like the other date columns.
  forDate  DateTime
  hours    Decimal  @db.Decimal(6, 2)
  billable Boolean  @default(false)
  note     String?
  loggedAt DateTime @default(now())

  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, forDate])
  @@index([userId, forDate])
}

model WorkIssue {
  id          String            @id @default(cuid())
  /// ISS-000045, from the identifiers counter.
  displayId   String?           @unique
  projectId   String?
  taskId      String?
  title       String
  description String?
  severity    WorkIssueSeverity @default(MEDIUM)
  status      WorkIssueStatus   @default(OPEN)
  raisedById  String
  assigneeId  String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project WorkProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    WorkTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([taskId])
  @@index([assigneeId, status])
}
