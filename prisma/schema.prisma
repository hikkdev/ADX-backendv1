}

enum VerificationType {
  AGENT_INITIAL
  SELF_REVERIFICATION
}

enum VerificationStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum ListingClaimStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ComplianceCaseReason {
