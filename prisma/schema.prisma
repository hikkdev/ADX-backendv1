  PLATFORM
  LISTING
  ADVERTISER_PLATFORM
  INSERTION_ORDER
  /// Lot D (Q55/Q123): one acceptance per package sale, at payment.
  PACKAGE_SALE
  /// Lot D (Q55/Q123): the agent's job terms, accepted when the agent taps
  /// Accept on an offer — never recorded on their behalf.
  JOB_TERMS
}

enum SignatureProvider {
  NONE
  DIGIO
}

enum ListingAttemptOrigin {
  SELF
  AGENT
  ADMIN_SINGLE
  ADMIN_BULK
  SCRAPE
}

enum ListingAttemptStatus {
  DRAFT
  AWAITING_ACCEPTANCE
  ACCEPTED
  ABANDONED
}

/// Drives the re-verification cadence: PERMANENT 180 days, REMOVABLE 90 days.
enum ListingRemovability {
  PERMANENT
  REMOVABLE
}

enum ListingDocumentKind {
  DISPLAY_AGREEMENT
  OWNER_NOC
  ADDRESS_PROOF
  MUNICIPAL_PERMIT
  OTHER
}

enum ListingDocumentStatus {
  PENDING
  VERIFIED
